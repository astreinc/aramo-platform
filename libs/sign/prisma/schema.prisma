// Per-module Prisma schema for the `sign` module (DOC-3 — Native E-Sign Service Core).
//
// Governing directive: Aramo-DOC-3-Native-ESign-Service-Core-Slice-Directive-v1_0-LOCKED
// (parent: Aramo-DOC-Documents-and-Native-ESignature-Architecture-and-Build-Directive-v1_1-LOCKED).
//
// ATS-neutral (§229; Invariant 2/19): this schema references Documents ONLY by
// opaque UUID (EnvelopeDocument.document_ref / document_revision_ref) — NO
// cross-schema FK, NO import of any ATS/cip domain. Canonical aggregate names
// (PO ruling 2026-09-22): SignatureEnvelope, SignatureField, SignerDisclosureAcceptance.
// SignatureEvent is append-only with a tamper-evident hash chain (R20/§256).

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["sign"]
}

/// The signature envelope aggregate — one signing transaction.
model SignatureEnvelope {
  id             String    @id @db.Uuid
  tenant_id      String    @db.Uuid
  subject        String
  status         String // CHECK: DRAFT|SENT|IN_PROGRESS|COMPLETED|DECLINED|VOIDED|EXPIRED
  execution_mode String // CHECK: ACKNOWLEDGEMENT|SINGLE_SIGNATURE|MULTI_SIGNATURE
  // Multi-Signer Amendment §4 — PARALLEL (everyone at once) | SEQUENTIAL (in signing_order). CHECK.
  routing_mode       String    @default("PARALLEL")
  created_by     String    @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @updatedAt @db.Timestamptz
  sent_at        DateTime? @db.Timestamptz
  completed_at   DateTime? @db.Timestamptz
  declined_at    DateTime? @db.Timestamptz
  voided_at      DateTime? @db.Timestamptz
  expires_at     DateTime? @db.Timestamptz
  // Sign Unified Product S-1 — provenance. created_by is the owner (the user on
  // whose behalf the envelope was sent). source_application: 'aramo-sign' (the
  // Sign app) | 'aramo-ats' | a registered application key (S-4).
  source_application String  @default("aramo-sign")
  installation_id    String? @db.Uuid
  origin_actor_kind  String  @default("USER") // CHECK: USER|APPLICATION
  // Sign Mobile M-A3 §6 — the strong revision validator (ETag "{id}.{revision}").
  // Maintained ONLY by DB triggers (migration 20261026100100): once per transaction
  // that writes the envelope or a child row. The application never writes either column.
  revision      Int     @default(1)
  revision_txid String?
  // Sign Mobile M-A3 §3 — sender message: sanitized plain text, <= 1000 chars,
  // settable in DRAFT only (DB-enforced), never part of the signed payload.
  message       String?
  // Sign Mobile D-W6-3 — a deleted DRAFT (migration 20261026100300). The ledger is
  // append-only and every envelope has events, so the row stays as an empty,
  // scrubbed tombstone; documents, recipients, fields and stored objects are gone.
  // CHECK: set only while DRAFT, and never cleared or moved out of DRAFT after.
  deleted_at    DateTime? @db.Timestamptz

  documents EnvelopeDocument[]
  signers   Signer[]
  sessions  SigningSession[]
  events    SignatureEvent[]
  executed_access ExecutedAccessGrant[]
  recipient_bindings SignRecipientBinding[]
  abuse_reports      AbuseReport[]

  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([tenant_id, created_by])
  @@schema("sign")
}

/// A source document attached to an envelope. Two source modes (PX-V1 F1):
/// CORE_REF = a frozen Core Documents revision pulled over HTTP (legacy ATS path,
/// UUID-ref only, no FK); OWNED = an uploaded PDF E-Sign owns in object storage
/// (source_object_key). document_ref/document_revision_ref are set only for
/// CORE_REF; source_object_key/content_type/byte_size only for OWNED.
model EnvelopeDocument {
  id                    String  @id @db.Uuid
  tenant_id             String  @db.Uuid
  envelope_id           String  @db.Uuid
  source_mode           String  @default("CORE_REF")
  document_ref          String? @db.Uuid
  document_revision_ref String? @db.Uuid
  source_object_key     String?
  content_type          String?
  byte_size             Int?
  title                 String
  source_sha256         String
  ordinal               Int

  envelope   SignatureEnvelope @relation(fields: [envelope_id], references: [id], onDelete: Cascade)
  fields     SignatureField[]
  page_sizes SignEnvelopeDocumentPages?

  @@unique([envelope_id, document_ref])
  @@index([tenant_id])
  @@index([envelope_id])
  @@schema("sign")
}

/// A party who must sign/acknowledge. Signing follows the envelope's routing_mode
/// (Multi-Signer Amendment): PARALLEL — every signer receives a live session at send
/// and may complete in any order; SEQUENTIAL — only the lowest-ordered unsigned signer
/// holds a session and may act, and the next is invited when they complete.
/// signing_order is 1..N, unique per envelope.
model Signer {
  id            String    @id @db.Uuid
  tenant_id     String    @db.Uuid
  envelope_id   String    @db.Uuid
  email         String
  name          String
  signing_order Int
  signer_role   String?
  status        String // CHECK: PENDING|VIEWED|SIGNED|DECLINED
  viewed_at     DateTime? @db.Timestamptz
  signed_at     DateTime? @db.Timestamptz
  declined_at   DateTime? @db.Timestamptz
  decline_reason String?

  envelope    SignatureEnvelope            @relation(fields: [envelope_id], references: [id], onDelete: Cascade)
  fields      SignatureField[]
  sessions    SigningSession[]
  disclosures SignerDisclosureAcceptance[]

  recipient_bindings SignRecipientBinding[]
  abuse_reports      AbuseReport[]
  @@unique([envelope_id, signing_order])
  @@index([tenant_id])
  @@index([envelope_id])
  @@schema("sign")
}

/// A placement of a signable field on an envelope document, assigned to a signer.
model SignatureField {
  id                   String    @id @db.Uuid
  tenant_id            String    @db.Uuid
  envelope_document_id String    @db.Uuid
  signer_id            String?   @db.Uuid
  field_type           String // CHECK: SIGNATURE|INITIALS|SIGN_DATE|SIGNER_NAME|TEXT|CHECKBOX|ACKNOWLEDGEMENT
  signature_method     String? // CHECK (nullable): TYPED|DRAWN|UPLOADED|DIGITAL_CERTIFICATE
  page_number          Int
  x                    Float
  y                    Float
  width                Float?
  height               Float?
  required             Boolean   @default(true)
  value                String?
  filled_at            DateTime? @db.Timestamptz

  envelope_document EnvelopeDocument @relation(fields: [envelope_document_id], references: [id], onDelete: Cascade)
  signer            Signer?          @relation(fields: [signer_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([envelope_document_id])
  @@index([signer_id])
  @@schema("sign")
}

/// A short-lived capability-token signing session (R17/§250). token_hash is the
/// sha256(base64url) of the raw token; the raw token is NEVER persisted.
model SigningSession {
  id                String    @id @db.Uuid
  tenant_id         String    @db.Uuid
  envelope_id       String    @db.Uuid
  signer_id         String    @db.Uuid
  token_hash        String
  status            String // CHECK: ISSUED|EXCHANGED|ACTIVE|COMPLETED|EXPIRED|REVOKED
  created_at        DateTime  @default(now()) @db.Timestamptz
  expires_at        DateTime  @db.Timestamptz
  first_accessed_at DateTime? @db.Timestamptz
  last_accessed_at  DateTime? @db.Timestamptz
  completed_at      DateTime? @db.Timestamptz
  revoked_at        DateTime? @db.Timestamptz
  failed_auth_count Int       @default(0)

  envelope SignatureEnvelope @relation(fields: [envelope_id], references: [id], onDelete: Cascade)
  signer   Signer            @relation(fields: [signer_id], references: [id], onDelete: Cascade)

  @@unique([token_hash])
  @@index([tenant_id])
  @@index([envelope_id])
  @@index([signer_id])
  @@schema("sign")
}

/// The signer's acceptance of the E-Sign electronic-record disclosure (R16/§246).
/// Versioned frozen text + sha256; distinct from the Consent domain.
model SignerDisclosureAcceptance {
  id                   String   @id @db.Uuid
  tenant_id            String   @db.Uuid
  signer_id            String   @db.Uuid
  disclosure_version   String
  disclosure_text_hash String
  accepted_at          DateTime @default(now()) @db.Timestamptz
  ip_address           String?
  user_agent           String?
  session_id           String   @db.Uuid

  signer Signer @relation(fields: [signer_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([signer_id])
  @@schema("sign")
}

/// Append-only signature-event ledger with a tamper-evident hash chain (R20/§256).
/// UPDATE/DELETE rejected by an unconditional DB trigger. event_hash chains from
/// previous_event_hash; the terminal event_hash is the envelope's event-chain hash.
model SignatureEvent {
  id                  String   @id @db.Uuid
  tenant_id           String   @db.Uuid
  envelope_id         String   @db.Uuid
  signer_id           String?  @db.Uuid
  event_type          String
  actor_type          String // CHECK: SIGNER|SYSTEM|SERVICE
  actor_ref           String?  @db.Uuid
  payload             Json?
  previous_event_hash String?
  event_hash          String
  occurred_at         DateTime @default(now()) @db.Timestamptz
  ip_address          String?
  user_agent          String?

  envelope SignatureEnvelope @relation(fields: [envelope_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, envelope_id, occurred_at])
  @@index([tenant_id, occurred_at])
  @@schema("sign")
}

/// A durable notification delivery-attempt record (§298; NEW E-Sign-domain work).
model NotificationDelivery {
  id                String    @id @db.Uuid
  tenant_id         String    @db.Uuid
  envelope_id       String    @db.Uuid
  signer_id         String?   @db.Uuid
  notification_kind String // CHECK: SIGNATURE_REQUEST|SIGNATURE_REMINDER|SIGNATURE_COMPLETED|SIGNATURE_DECLINED|SIGNATURE_EXPIRED|SIGNATURE_VOIDED|SIGNER_SIGNED
  status            String // CHECK: PENDING|DISPATCHING|SENT|FAILED|CANCELLED
  // Multi-Signer §4 — when a dispatcher claimed this invitation intent (stale claims are reclaimable).
  claimed_at        DateTime? @db.Timestamptz
  attempts          Int       @default(0)
  last_error        String?
  created_at        DateTime  @default(now()) @db.Timestamptz
  sent_at           DateTime? @db.Timestamptz

  @@index([tenant_id])
  @@index([envelope_id])
  @@schema("sign")
}

/// Schema-local idempotency for cross-service mutations (Invariant 16).
model IdempotencyKey {
  id              String   @id @db.Uuid
  tenant_id       String   @db.Uuid
  key             String
  request_hash    String
  response_status Int?
  response_body   Json?
  created_at      DateTime @default(now()) @db.Timestamptz

  @@unique([tenant_id, key])
  @@schema("sign")
}

/// Transactional outbox — rows written in the same $transaction as state changes.
model OutboxEvent {
  id            String    @id @db.Uuid
  tenant_id     String    @db.Uuid
  event_type    String
  event_payload Json
  created_at    DateTime  @default(now()) @db.Timestamptz
  published_at  DateTime? @db.Timestamptz
  // E-Sign OC v2 (DEC-A) — durable outbound-delivery retry/backoff state. E-Sign
  // owns reliable lifecycle-event delivery, so the outbox persists attempt
  // bookkeeping + a backoff schedule instead of a blind fixed-interval retry.
  // last_error_code is a bounded, sanitized short diagnostic (never raw bodies).
  attempt_count   Int       @default(0)
  next_attempt_at DateTime? @db.Timestamptz
  last_attempt_at DateTime? @db.Timestamptz
  last_error_code String?   @db.VarChar(64)

  @@index([published_at])
  @@index([published_at, next_attempt_at])
  @@schema("sign")
}

/// DOC-4 (R-4-3) — the executed document bytes produced at envelope completion,
/// held TRANSIENTLY in esign until the Documents write-back (R-4-7) stores the
/// permanent EXECUTED artifact. esign is NOT a second document repository
/// (invariant 12); rows are disposable once written back.
model ExecutedDocument {
  id                   String   @id @db.Uuid
  tenant_id            String   @db.Uuid
  envelope_id          String   @db.Uuid
  envelope_document_id String   @db.Uuid
  source_sha256        String
  executed_sha256      String
  byte_size            Int
  executed_bytes       Bytes
  produced_at          DateTime @default(now()) @db.Timestamptz
  written_back_at      DateTime? @db.Timestamptz

  @@unique([envelope_document_id])
  @@index([tenant_id])
  @@index([envelope_id])
  @@schema("sign")
}

/// DOC-4 (R-4-6) — the human-readable execution certificate PDF produced at
/// completion (one per envelope). Held transiently in esign until the Documents
/// write-back stores the permanent EXECUTION_CERTIFICATE artifact.
model ExecutionCertificate {
  id              String    @id @db.Uuid
  tenant_id       String    @db.Uuid
  envelope_id     String    @db.Uuid
  certificate_sha256 String
  byte_size       Int
  certificate_bytes Bytes
  produced_at     DateTime  @default(now()) @db.Timestamptz
  written_back_at DateTime? @db.Timestamptz

  @@unique([envelope_id])
  @@index([tenant_id])
  @@schema("sign")
}

/// A time-limited capability that lets a signer download the executed document and
/// certificate of a COMPLETED envelope (sent in the completion email). Only
/// sha256(base64url) of the raw token is stored, exactly like SigningSession.
model ExecutedAccessGrant {
  id               String    @id @db.Uuid
  tenant_id        String    @db.Uuid
  envelope_id      String    @db.Uuid
  signer_id        String    @db.Uuid
  token_hash       String    @unique
  expires_at       DateTime  @db.Timestamptz
  created_at       DateTime  @default(now()) @db.Timestamptz
  last_accessed_at DateTime? @db.Timestamptz
  access_count     Int       @default(0)

  envelope SignatureEnvelope @relation(fields: [envelope_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([envelope_id])
  @@schema("sign")
}

// ── Sign Unified Product S-4 — application registry, installations, credentials ──
// (Aramo-Sign-Unified-Product-Permission-Contract-Platform-API-Directive-v1_0-LOCKED §4.4)

/// A registered application that integrates with Aramo Sign.
model SignApplication {
  id                        String   @id @db.Uuid
  key                       String   @unique
  name                      String
  kind                      String // CHECK: FIRST_PARTY|THIRD_PARTY
  status                    String   @default("ACTIVE") // CHECK: ACTIVE|DISABLED
  requested_permissions     String[] @default([])
  modes                     String[] @default([]) // subset of USER|APPLICATION
  assertable_roles          String[] @default([])
  delegation_profile        String[] @default([]) // FIRST_PARTY only
  delegation_required_scope String?
  created_at                DateTime @default(now()) @db.Timestamptz
  updated_at                DateTime @default(now()) @db.Timestamptz

  installations SignInstallation[]
  credentials   SignCredential[]
  webhooks      SignWebhookSubscription[]

  @@schema("sign")
}

/// One application's installation in one tenant, with its bounded grant set.
model SignInstallation {
  id                     String    @id @db.Uuid
  tenant_id              String    @db.Uuid
  application_id         String    @db.Uuid
  status                 String    @default("ACTIVE") // CHECK: ACTIVE|REVOKED
  granted_permissions    String[]  @default([])
  modes                  String[]  @default([])
  integration_role       String? // CHECK: sign_admin|sign_sender|sign_viewer
  role_assertion_enabled Boolean   @default(false)
  first_party_auto       Boolean   @default(false)
  approved_by            String?   @db.Uuid
  approved_at            DateTime  @default(now()) @db.Timestamptz
  revoked_by             String?   @db.Uuid
  revoked_at             DateTime? @db.Timestamptz
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @default(now()) @db.Timestamptz

  application   SignApplication   @relation(fields: [application_id], references: [id])
  credentials   SignCredential[]
  role_mappings SignRoleMapping[]
  tokens        SignAccessToken[]
  webhooks      SignWebhookSubscription[]

  @@unique([tenant_id, application_id], map: "SignInstallation_tenant_application_key")
  @@index([tenant_id])
  @@schema("sign")
}

/// A client credential. installation_id null = FIRST_PARTY application-level.
model SignCredential {
  id              String    @id @db.Uuid
  application_id  String    @db.Uuid
  installation_id String?   @db.Uuid
  client_id       String    @unique
  secret_hash     String
  status          String    @default("ACTIVE") // CHECK: ACTIVE|REVOKED
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  expires_at      DateTime? @db.Timestamptz
  last_used_at    DateTime? @db.Timestamptz
  revoked_at      DateTime? @db.Timestamptz

  application  SignApplication   @relation(fields: [application_id], references: [id])
  installation SignInstallation? @relation(fields: [installation_id], references: [id])
  tokens       SignAccessToken[]

  @@index([installation_id])
  @@schema("sign")
}

/// A tenant-approved mapping of an asserted external role to a Sign role (narrowing only).
model SignRoleMapping {
  installation_id String   @db.Uuid
  external_role   String
  sign_role       String // CHECK: sign_admin|sign_sender|sign_viewer
  created_at      DateTime @default(now()) @db.Timestamptz

  installation SignInstallation @relation(fields: [installation_id], references: [id], onDelete: Cascade)

  @@id([installation_id, external_role])
  @@schema("sign")
}

/// A short-lived integration access token (sha256 digest only).
model SignAccessToken {
  id              String    @id @db.Uuid
  token_hash      String    @unique
  credential_id   String    @db.Uuid
  installation_id String    @db.Uuid
  tenant_id       String    @db.Uuid
  mode            String // CHECK: USER|APPLICATION
  subject_id      String    @db.Uuid
  external_actor  String?
  external_role   String?
  scopes          String[]
  audience        String
  expires_at      DateTime  @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz
  revoked_at      DateTime? @db.Timestamptz
  // Addendum S6 — an EVENT_ARTIFACT grant reads ONE envelope's executed artifacts.
  grant_kind      String    @default("STANDARD") // CHECK: STANDARD|EVENT_ARTIFACT
  envelope_id     String?   @db.Uuid
  event_id        String?   @db.Uuid

  credential   SignCredential   @relation(fields: [credential_id], references: [id])
  installation SignInstallation @relation(fields: [installation_id], references: [id])

  @@index([installation_id])
  @@index([expires_at])
  @@schema("sign")
}

// ── Sign Unified Product S-5 — webhook subscriptions + per-subscription delivery ──

/// Where lifecycle events go: one installation, or (first-party) the application.
model SignWebhookSubscription {
  id                String    @id @db.Uuid
  application_id    String    @db.Uuid
  installation_id   String?   @db.Uuid
  tenant_id         String?   @db.Uuid
  target_url        String
  event_types       String[]  @default([])
  secret_ciphertext String
  status            String    @default("ACTIVE") // CHECK: ACTIVE|DISABLED
  internal          Boolean   @default(false)
  created_by        String?   @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @default(now()) @db.Timestamptz
  secret_rotated_at DateTime? @db.Timestamptz

  application  SignApplication       @relation(fields: [application_id], references: [id])
  installation SignInstallation?     @relation(fields: [installation_id], references: [id])
  deliveries   SignWebhookDelivery[]

  @@index([installation_id])
  @@index([application_id])
  @@schema("sign")
}

/// One event for one subscription, with its own retry state.
model SignWebhookDelivery {
  id              String    @id @db.Uuid
  subscription_id String    @db.Uuid
  event_id        String    @db.Uuid
  tenant_id       String    @db.Uuid
  envelope_id     String    @db.Uuid
  event_type      String
  payload         Json
  status          String    @default("PENDING") // CHECK: PENDING|DELIVERED|DEAD
  attempt_count   Int       @default(0)
  next_attempt_at DateTime? @db.Timestamptz
  last_attempt_at DateTime? @db.Timestamptz
  last_error_code String?   @db.VarChar(64)
  delivered_at    DateTime? @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz

  subscription SignWebhookSubscription @relation(fields: [subscription_id], references: [id])

  @@unique([subscription_id, event_id], map: "SignWebhookDelivery_subscription_event_key")
  @@index([status, next_attempt_at])
  @@index([event_id])
  @@schema("sign")
}

// ── Sign Unified Product S-7 — the recipient inbox (refinement B) ──

/// A verified Aramo user bound to ONE envelope recipient (never tenant membership).
model SignRecipientBinding {
  id                 String    @id @db.Uuid
  envelope_tenant_id String    @db.Uuid
  envelope_id        String    @db.Uuid
  signer_id          String    @db.Uuid
  user_id            String    @db.Uuid
  user_tenant_id     String    @db.Uuid
  email              String
  created_at         DateTime  @default(now()) @db.Timestamptz
  revoked_at         DateTime? @db.Timestamptz
  // Sign Mobile M-A2 §2.2 — the emailed signing session the claim was made with.
  // Inbox signing never outlives it (revoked by a reminder or expired ⇒ re-claim).
  claim_session_id   String?   @db.Uuid

  envelope SignatureEnvelope @relation(fields: [envelope_id], references: [id], onDelete: Cascade)
  signer   Signer            @relation(fields: [signer_id], references: [id], onDelete: Cascade)

  @@unique([signer_id, user_id], map: "SignRecipientBinding_signer_user_key")
  @@index([user_id])
  @@schema("sign")
}

// ── Aramo-Sign-Personal-Free-Launch-Directive-v1_1-LOCKED §6.4 — abuse reports ──

/// "Report this email" on a Personal sender's signing email: one per recipient per
/// envelope, from the recipient's own signing link. weight = severity × independence
/// × credibility (each factor kept). reporter_key = sha256 of the normalized
/// recipient address (never the address); reporter_domain for independence.
/// CHECK reason: phishing|impersonation|spam|unknown_sender|other (nullable).
/// CHECK outcome: OPEN|CONFIRMED|FALSE_REPORT|DISMISSED.
model AbuseReport {
  id                    String    @id @db.Uuid
  tenant_id             String    @db.Uuid
  envelope_id           String    @db.Uuid
  signer_id             String    @db.Uuid
  reason                String?
  note                  String?
  reporter_key          String
  reporter_domain       String
  severity              Float
  independence          Float
  credibility           Float
  weight                Float
  triggered_restriction Boolean   @default(false)
  outcome               String    @default("OPEN")
  outcome_reason        String?
  decided_by            String?
  decided_at            DateTime? @db.Timestamptz
  created_at            DateTime  @default(now()) @db.Timestamptz

  envelope SignatureEnvelope @relation(fields: [envelope_id], references: [id], onDelete: Cascade)
  signer   Signer            @relation(fields: [signer_id], references: [id], onDelete: Cascade)

  @@unique([envelope_id, signer_id])
  @@index([tenant_id, created_at])
  @@index([reporter_key])
  @@schema("sign")
}

// ── Aramo Sign Mobile (M-A3 §4/§5/§7/§8) — W2b mobile-owned envelope contracts ──

/// Request idempotency for sender operations (remind, document upload). Scoped to
/// (tenant, authenticated actor, operation, key); a replay with the same body
/// returns the stored response, a different body is refused. Keys live 24 hours.
model SignIdempotencyKey {
  id              String   @id @db.Uuid
  tenant_id       String   @db.Uuid
  actor_id        String   @db.Uuid
  operation       String
  key             String
  request_hash    String
  response_status Int?
  response_body   Json?
  created_at      DateTime @default(now()) @db.Timestamptz

  @@unique([tenant_id, actor_id, operation, key], map: "SignIdempotencyKey_scope_key")
  @@index([created_at])
  @@schema("sign")
}

/// A user's saved default signature / initials (a convenience only). Each signing
/// still submits its own value through the fill call, so deleting this row never
/// changes an executed record. CHECK slot: signature|initials. CHECK kind: TYPED|DRAWN.
model SignSavedSignature {
  id             String   @id @db.Uuid
  tenant_id      String   @db.Uuid
  user_id        String   @db.Uuid
  slot           String
  kind           String
  typed_name     String?
  font_key       String?
  image_data_url String
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @default(now()) @db.Timestamptz

  @@unique([tenant_id, user_id, slot], map: "SignSavedSignature_owner_slot_key")
  @@schema("sign")
}

/// A sender's private contact (per tenant and owner user). Gives no authority:
/// recipients are validated when the envelope is sent. email_key = lower(trim(email)).
model SignContact {
  id            String    @id @db.Uuid
  tenant_id     String    @db.Uuid
  owner_user_id String    @db.Uuid
  name          String
  email         String
  email_key     String
  organization  String?
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @default(now()) @db.Timestamptz
  last_used_at  DateTime? @db.Timestamptz

  @@unique([tenant_id, owner_user_id, email_key], map: "SignContact_owner_email_key")
  @@index([tenant_id, owner_user_id])
  @@schema("sign")
}

// ── Aramo Sign Mobile — notification feed, devices, preferences, push ──
// (Aramo-Sign-Unified-Product-Amendment-M-A3-Mobile-Owned-Data-Contracts-v1_0-LOCKED §1, §2, §9)

/// The notification fan-out source: one row per notifiable signing fact, written IN
/// THE SAME transaction as the ledger event (EsignRepository.appendEvent). Refs only:
/// no document content, no capability token. Drained by the sign-service fan-out
/// worker; processed_at makes processing idempotent, attempt_count / next_attempt_at
/// give it a backoff. CHECK kind: SIGNED|VIEWED|DECLINED|SIGNATURE_NEEDED|COMPLETED|EXPIRED|REMINDER.
model SignNotificationOutbox {
  id              String    @id @db.Uuid
  tenant_id       String    @db.Uuid
  envelope_id     String    @db.Uuid
  signer_id       String?   @db.Uuid
  kind            String
  actor_type      String
  actor_ref       String?   @db.Uuid
  // REMINDER: the signers the reminder went to.
  signer_ids      String[]  @default([]) @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  processed_at    DateTime? @db.Timestamptz
  attempt_count   Int       @default(0)
  next_attempt_at DateTime? @db.Timestamptz
  last_error_code String?   @db.VarChar(64)

  @@index([processed_at, next_attempt_at])
  @@schema("sign")
}

/// One notification in one user's feed. Owned by exactly one (tenant_id, user_id).
/// audience SENDER: the user sent the envelope (envelope_id is theirs). audience
/// RECIPIENT: the user claimed the envelope in their inbox; envelope_id is internal
/// only and never returned — the client gets inbox_item_id (the binding). dedupe_key
/// is unique per source event and user. CHECK type: SIGNED|VIEWED|DECLINED|
/// SIGNATURE_NEEDED|COMPLETED|EXPIRED|REMINDER. CHECK audience: SENDER|RECIPIENT.
model SignUserNotification {
  id               String    @id @db.Uuid
  tenant_id        String    @db.Uuid
  user_id          String    @db.Uuid
  type             String
  audience         String
  envelope_id      String    @db.Uuid
  inbox_item_id    String?   @db.Uuid
  envelope_subject String
  actor_name       String?
  dedupe_key       String
  source_outbox_id String?   @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz
  read_at          DateTime? @db.Timestamptz

  push_jobs SignPushJob[]

  @@unique([user_id, dedupe_key], map: "SignUserNotification_user_dedupe_key")
  @@index([tenant_id, user_id, created_at])
  @@schema("sign")
}

/// A push registration, attached ONLY to the caller's own native device session
/// (device_session_id = the access token's dsid). The provider token is held
/// ENCRYPTED (AES-256-GCM, SIGN_PUSH_TOKEN_KEY) and removed on revocation;
/// push_token_digest (sha256) finds the same token registered elsewhere.
/// CHECK platform: ios|android. CHECK provider: apns|fcm.
model SignPushDevice {
  id                    String    @id @db.Uuid
  tenant_id             String    @db.Uuid
  user_id               String    @db.Uuid
  device_session_id     String    @db.Uuid
  platform              String
  provider              String
  push_token_ciphertext String?
  push_token_digest     String?
  app_version           String
  created_at            DateTime  @default(now()) @db.Timestamptz
  updated_at            DateTime  @default(now()) @db.Timestamptz
  last_seen_at          DateTime  @default(now()) @db.Timestamptz
  revoked_at            DateTime? @db.Timestamptz
  revoke_reason         String?

  push_jobs SignPushJob[]

  @@unique([device_session_id], map: "SignPushDevice_device_session_key")
  @@index([tenant_id, user_id])
  @@index([push_token_digest])
  @@index([revoked_at])
  @@schema("sign")
}

/// Per-user push preferences (absent row = the defaults: every type on, subject
/// on the lock screen off).
model SignNotificationPreference {
  id                  String   @id @db.Uuid
  tenant_id           String   @db.Uuid
  user_id             String   @db.Uuid
  signed              Boolean  @default(true)
  viewed              Boolean  @default(true)
  declined            Boolean  @default(true)
  signature_needed    Boolean  @default(true)
  reminders           Boolean  @default(true)
  lock_screen_subject Boolean  @default(false)
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @default(now()) @db.Timestamptz

  @@unique([tenant_id, user_id], map: "SignNotificationPreference_owner_key")
  @@schema("sign")
}

/// One push of one notification to one device, with its own retry state.
/// CHECK status: PENDING|SENT|CANCELLED|FAILED|DEAD.
model SignPushJob {
  id              String    @id @db.Uuid
  tenant_id       String    @db.Uuid
  user_id         String    @db.Uuid
  device_id       String    @db.Uuid
  notification_id String    @db.Uuid
  payload_kind    String
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  next_attempt_at DateTime  @default(now()) @db.Timestamptz
  last_error_code String?   @db.VarChar(64)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz
  sent_at         DateTime? @db.Timestamptz

  device       SignPushDevice       @relation(fields: [device_id], references: [id], onDelete: Cascade)
  notification SignUserNotification @relation(fields: [notification_id], references: [id], onDelete: Cascade)

  @@unique([device_id, notification_id], map: "SignPushJob_device_notification_key")
  @@index([status, next_attempt_at])
  @@index([tenant_id, user_id, created_at])
  @@index([status, updated_at])
  @@schema("sign")
}

/// The audit of a convenience-data removal (account close, M-A3 §9; the Privacy
/// Notice 1.1 E-1 retention purge): counts only.
model SignConvenienceDataPurge {
  id                    String   @id @db.Uuid
  tenant_id             String   @db.Uuid
  user_id               String   @db.Uuid
  reason                String
  devices_revoked       Int
  push_jobs_cancelled   Int
  devices_deleted       Int
  notifications_deleted Int
  preferences_deleted   Int
  created_at            DateTime @default(now()) @db.Timestamptz
  // Privacy Notice 1.1 E-1 (ADD-only; account-close rows read 0).
  saved_signatures_deleted Int @default(0)
  contacts_deleted         Int @default(0)

  @@index([tenant_id, user_id])
  @@schema("sign")
}

// ── Privacy Notice 1.1 remediation (E-1 to E-4) — retention cleanup ──
// (Aramo-Privacy-Notice-1_1-Remediation-Directive-v1_0-LOCKED §4)

/// An operator-recorded, VERIFIED request to delete one user's convenience data in
/// one tenant (E-1 trigger c). Recorded by an operator after the requester's
/// identity was verified (verified_by = the operator, verification_ref = the ticket
/// or case reference). The retention worker completes it (completed_at, purge_id =
/// the SignConvenienceDataPurge row); a tenant under legal hold leaves it open.
model SignConvenienceDeletionRequest {
  id               String    @id @db.Uuid
  tenant_id        String    @db.Uuid
  user_id          String    @db.Uuid
  verified_by      String
  verification_ref String
  recorded_at      DateTime  @default(now()) @db.Timestamptz
  completed_at     DateTime? @db.Timestamptz
  purge_id         String?   @db.Uuid

  @@index([completed_at, recorded_at], map: "SignConvenienceDeletionRequest_open_idx")
  @@index([tenant_id, user_id])
  @@schema("sign")
}

/// The counts-only audit of a time-based retention sweep (E-2, E-3, E-4): one row
/// per job and tenant for each run that deleted something. No identifiers of the
/// deleted rows are kept. CHECK job: native_sessions|revoked_push_devices|
/// idempotency_keys|notification_outbox|push_jobs.
model SignRetentionSweep {
  id         String   @id @db.Uuid
  job        String
  tenant_id  String   @db.Uuid
  deleted    Int
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([tenant_id, job, created_at])
  @@schema("sign")
}

// ── Aramo Sign Mobile (D-W6-2) — page sizes of a source document ──

/// The page sizes of a document's source PDF, in PDF points (each page's MediaBox,
/// the frame the server validates field geometry in), 0-based by position. Derived
/// from the frozen source bytes: written at upload, and on first read for documents
/// that predate it. A side table, not a column on EnvelopeDocument: a write to an
/// EnvelopeDocument row raises the envelope revision (M-A3 §6 trigger), and filling
/// this cache on a read must never change the envelope's ETag.
model SignEnvelopeDocumentPages {
  envelope_document_id String   @id @db.Uuid
  tenant_id            String   @db.Uuid
  pages                Json
  created_at           DateTime @default(now()) @db.Timestamptz

  document EnvelopeDocument @relation(fields: [envelope_document_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@schema("sign")
}
