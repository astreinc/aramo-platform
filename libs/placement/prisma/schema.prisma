// Per-module Prisma schema for the `placement` module — Track 3 / E1-a
// (PlacementProcess Spine, seam 2 of 6). Governed by
// Aramo-Track3-E1a-PlacementProcess-Directive v1.3 LOCKED.
//
// IDENTITY CONTRACT (§11 — recorded in code, not only in the directive):
//
//   A PlacementProcess represents ONE commitment attempt for ONE talent
//   against ONE requisition, originating from ONE submittal, at a specific
//   point in time.
//
//   Multiple attempts are EXPECTED. Only ONE may be non-terminal (live) at a
//   time — enforced by the BEFORE INSERT guard in the init migration, NOT by
//   a uniqueness constraint. submittal_id is therefore deliberately NOT
//   unique (a re-offer after fallthrough is a real workflow).
//
//   It does NOT represent: an application · a pipeline card · a matching
//   outcome · a general selection · an assignment. Lineage is submittal_id,
//   never pipeline_id; naming is requisition_id, never job_id.
//
// PG schema: `placement` per Architecture §7.1 schema-per-module. Cross-schema
// references are UUID-only, no FK (§7.3): submittal_id → submittal record;
// requisition_id → requisition; talent_record_id → talent_record.TalentRecord.
// The event-log FK to PlacementProcess is intra-schema and therefore permitted.
//
// The state machine (BEFORE INSERT + BEFORE UPDATE trigger) is a GENERATED
// build artifact produced from the typed lifecycle registry
// (src/lib/lifecycle) — see the init migration and src/lib/generator. The
// migration SQL is never hand-edited; CI asserts byte-equality (§5c).
//
// id is a UUID v7 generated APP-SIDE (§2) — NO @default. A @default(uuid())
// would emit a v4 gen_random_uuid(), defeating the time-ordered v7 intent.
// There is deliberately NO updated_at (§2) — transition timestamps derive
// from the append-only PlacementProcessEvent log.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["placement", "offer"]
}

// PlacementState — the closed 10-value lifecycle. The TypeScript registry
// (src/lib/lifecycle/placement-lifecycle.ts) is the source of truth; this
// enum mirrors its state order and the generated migration's enum.
enum PlacementState {
  OFFER_EXTENDED
  OFFER_ACCEPTED
  PRE_START
  BLOCKED
  READY_TO_START
  STARTED
  OFFER_DECLINED
  OFFER_RESCINDED
  NO_SHOW
  FELL_THROUGH

  @@schema("placement")
}

// PlacementEventType — closed-list event-log type. Mirrors the submittal /
// selection event-log substrate (one type at spine; richer types land with
// consumers).
enum PlacementEventType {
  state_transition

  @@schema("placement")
}

// PlacementKind — Track 7 / T7-P1. The persisted branch-selection fact that
// governs which post-start aggregate the STARTED handoff materialises: CONTRACT
// -> ContractAssignment (Track 4, the existing path), PERMANENT ->
// PermanentPlacement (Track 7). NULLABLE and additive: existing/legacy rows
// remain NULL and preserve historical CONTRACT behaviour at STARTED
// (backward-compatibility). A new flow that knows the type persists it
// explicitly at create; the PERMANENT branch requires an explicit persisted
// PERMANENT (a NULL cannot be started permanent — fail closed). This is an
// AGGREGATE birth fact, read at STARTED — never a transient-only transition flag
// (T7-P1 directive §3.1). It is NOT added to ContractAssignment (§3.1: no
// permanent discriminator on the contract aggregate).
enum PlacementKind {
  CONTRACT
  PERMANENT

  @@schema("placement")
}

// PlacementProcess — the spine aggregate. See the identity contract above.
model PlacementProcess {
  // Identity. UUID v7 generated app-side — NO @default (§2).
  id String @id @db.Uuid

  tenant_id String @db.Uuid

  // Lineage (§1). NOT unique — many attempts per submittal.
  submittal_id String @db.Uuid

  // Denormalised (§3b) so a placement is readable at offer/capacity/reporting
  // time without a cross-schema hop. UUID-only cross-schema refs, no FK (§7.3).
  requisition_id   String @db.Uuid
  talent_record_id String @db.Uuid

  state PlacementState

  // Initial offer snapshot (E1-c, Approval Record 9-c-1) — the operational offer
  // fact the client-selection/offer creates this attempt on. NOT the commercial
  // source of truth (rates/currency/markup are Track 5). The snapshot is set at
  // create and must not be silently overwritten afterwards (a future governed
  // version mechanism may supersede it; that is not part of E1-c).
  offered_at             DateTime  @db.Timestamptz(6)
  proposed_start_date    DateTime? @db.Date
  offer_expires_at       DateTime? @db.Timestamptz(6)
  client_offer_reference String?
  offer_terms_summary    String?

  // Offer Lifecycle (D6, R-PRECEDENCE). The ACCEPTED Offer this placement was
  // created from — the placement is now DOWNSTREAM of the dedicated offer
  // aggregate (offer."Offer"). UUID-only cross-schema ref, NO FK (§7.3). NULLABLE
  // + written once at INSERT; NOT pinned in the immutability trigger (the §4.3
  // NULL=NULL trap). Nullable for backward-compat with legacy pre-offer rows;
  // every NEW placement create requires an ACCEPTED offer (create-time check).
  // Additive migration 20260824130000.
  offer_id String? @db.Uuid

  // Replacement lineage (E4). Nullable self-referential pointer to the terminal
  // predecessor this attempt replaces; null for a first (non-replacement) attempt.
  // DELIBERATELY a plain scalar with NO @relation / NO FK (§4.2): a self-FK
  // RESTRICT would break the single-pass tenant-reset DELETE and ON DELETE SET
  // NULL would UPDATE a frozen terminal predecessor (INV-2). Referential
  // integrity rests entirely on the §5 create-time validation. Written once at
  // INSERT; NOT pinned in the generated immutability trigger (§4.3 — a nullable
  // column pinned via OLD = NEW is NULL not TRUE and would reject every
  // first-placement transition). Additive migration 20260808120000.
  replaces_placement_process_id String? @db.Uuid

  // Track 7 / T7-P1 — the persisted permanent-vs-contract branch fact (§3.1).
  // NULLABLE, written once at INSERT; NOT pinned in any immutability trigger (a
  // nullable column pinned via OLD = NEW is NULL not TRUE and would reject every
  // first transition — the §4.3 NULL=NULL trap). Read at STARTED to select the
  // post-start aggregate: PERMANENT -> PermanentPlacement; CONTRACT/NULL ->
  // ContractAssignment (legacy NULL preserves historical behaviour). Additive
  // migration 20260814120000.
  placement_kind PlacementKind?

  // Snapshot creation timestamp. NO updated_at (§2).
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Intra-schema back-reference for the event-log FK (relation-only field).
  events PlacementProcessEvent[]

  // (tenant, submittal): duplicate-guard lookup + lineage read.
  // (tenant, requisition) / (tenant, talent_record): offer/capacity/reporting.
  @@index([tenant_id, submittal_id])
  @@index([tenant_id, requisition_id])
  @@index([tenant_id, talent_record_id])
  @@schema("placement")
}

// PlacementProcessEvent — append-only, absolutely immutable audit log. No
// update surface, no delete surface; both enforced by database triggers in the
// init migration (§3). Mirrors TalentSelectionEvent.
model PlacementProcessEvent {
  // Identity. UUID v7 generated app-side — NO @default (§2).
  id        String @id @db.Uuid
  tenant_id String @db.Uuid

  // Intra-schema FK to PlacementProcess (permitted — §3, §7.3).
  placement_process_id String           @db.Uuid
  process              PlacementProcess @relation(fields: [placement_process_id], references: [id])

  event_type    PlacementEventType
  event_payload Json

  // Track 3 / E3 — governed terminal/fallthrough reason evidence. Nullable:
  // present only for a transition into a governed terminal state, absent (null)
  // for every other transition and for all legacy pre-E3 events. The registry is
  // code-backed (src/lib/reasons); these columns are the authoritative historical
  // evidence and survive later registry label changes (reason_label_snapshot).
  // reason_detail is PII-bearing free text (tenant-owned) and NEVER enters the
  // outbox (§13/C1). Additive migration 20260807120000; the immutability trigger
  // means the columns are written once, at insert. Two DB CHECKs enforce the
  // structural invariants (code<->label paired; detail requires code).
  reason_code           String?
  reason_label_snapshot String?
  reason_detail         String?

  // Snapshot creation timestamp. Whole row is immutable (trigger-enforced).
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id, placement_process_id])
  @@index([placement_process_id, created_at])
  @@schema("placement")
}

// OutboxEvent — the placement schema's own transactional-outbox namespace (E1-c,
// Approval Record 9-c-2). Mirrors the six-column house shape (consent/selection/
// submittal): aggregate identity lives inside event_payload, NOT in columns.
// Drained by libs/outbox-publisher (published_at stamped on drain). Append-only:
// a column-scoped immutability trigger (the E1-c migration) rejects DELETE and any
// UPDATE except published_at — stricter than the trigger-less house convention so
// the append-only contract is assertable, while the publisher can still stamp
// published_at.
model OutboxEvent {
  id            String    @id @db.Uuid
  tenant_id     String    @db.Uuid
  event_type    String
  event_payload Json
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  published_at  DateTime? @db.Timestamptz(6)

  @@index([published_at])
  @@schema("placement")
}

// ===========================================================================
// OFFER aggregate (Offer Lifecycle slice #2). A DEDICATED pre-placement offer
// state machine (Option B): an ACCEPTED offer is the precondition for a
// placement (the placement-create re-point, D6). Owned by libs/placement in its
// own `offer` schema. The TS registry (src/lib/lifecycle/offer-lifecycle.ts) is
// the source of truth; the generated migration's enum + trigger mirror it.
// ===========================================================================

// OfferState — the closed 7-value lifecycle (mirrors OFFER_STATES order).
enum OfferState {
  DRAFT
  SENT
  NEGOTIATION
  ACCEPTED
  DECLINED
  EXPIRED
  RESCINDED

  @@schema("offer")
}

enum OfferEventType {
  state_transition

  @@schema("offer")
}

// Offer — the aggregate. NO updated_at (§2 idiom): transition timestamps derive
// from the append-only OfferEvent log. Term/expiry/reason columns are set at the
// relevant transition and NOT pinned in the immutability trigger (the NULL=NULL
// trap — a nullable column pinned via OLD=NEW is NULL, not TRUE).
model Offer {
  id String @id @db.Uuid

  tenant_id String @db.Uuid

  // Lineage (the pre-placement point). NOT unique — a new offer may follow a
  // terminal one for the same submittal (one-live guard permits ≤1 non-terminal).
  submittal_id String @db.Uuid

  // Denormalised UUID-only cross-schema refs, no FK (§7.3).
  requisition_id   String @db.Uuid
  talent_record_id String @db.Uuid

  state OfferState

  // Offer terms snapshot (operational; NOT the commercial source of truth —
  // rates/margin are Track 5 / slice #4). Nullable, app-surface immutability.
  proposed_start_date    DateTime? @db.Date
  offer_expires_at       DateTime? @db.Timestamptz(6)
  client_offer_reference String?
  offer_terms_summary    String?

  // Governed terminal evidence (nullable; present on DECLINED). NOT pinned.
  decline_reason String?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  events OfferEvent[]

  @@index([tenant_id, submittal_id])
  @@index([tenant_id, requisition_id])
  @@index([tenant_id, talent_record_id])
  @@schema("offer")
}

// OfferEvent — append-only, absolutely immutable audit log (mirrors
// PlacementProcessEvent). Immutability enforced by DB triggers in the migration.
model OfferEvent {
  id        String @id @db.Uuid
  tenant_id String @db.Uuid

  offer_id String @db.Uuid
  offer    Offer  @relation(fields: [offer_id], references: [id])

  event_type    OfferEventType
  event_payload Json

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id, offer_id])
  @@index([offer_id, created_at])
  @@schema("offer")
}

// The offer schema's own transactional-outbox namespace (offer."OutboxEvent").
// Distinct Prisma model name (global namespace) mapped to the per-schema table.
model OfferOutboxEvent {
  id            String    @id @db.Uuid
  tenant_id     String    @db.Uuid
  event_type    String
  event_payload Json
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  published_at  DateTime? @db.Timestamptz(6)

  @@index([published_at])
  @@map("OutboxEvent")
  @@schema("offer")
}

// ContractAssignmentProvenance — Track 4 / T4-A1. The discriminator that makes
// the forward/backfill split clean (v1.1 Amendment §A3). NOT a lifecycle state:
// FORWARD = created when a placement started; BACKFILLED = materialised for a
// historical STARTED row. Its whole purpose is to make a null lifecycle_state
// mean ABSENCE-because-unknown (backfilled) rather than a set value.
enum ContractAssignmentProvenance {
  FORWARD
  BACKFILLED

  @@schema("placement")
}

// ContractAssignmentState — Track 4 / T4-A1. The post-start assignment
// lifecycle. Ships ACTIVE (the only state a forward start produces); ending
// states land with their ratified edges (T4-B / T4-C) as additive members.
// Deliberately NO `UNKNOWN` member (Amendment §A3.1 / HALT 19) — a null
// lifecycle_state with BACKFILLED provenance carries "unknown" as absence.
enum ContractAssignmentState {
  ACTIVE
  // Track 4 / T4-C — the ratified ending state. An ENDED assignment releases both
  // capacity (T4-B) and the placement one-live guard (G2). Attrition TYPE (quit /
  // terminated / completed / client-ended) is captured as an ending reason, not as
  // distinct lifecycle states — the ratified capacity/guard semantic is binary
  // (active vs ended). Additive migration 20260810100000.
  ENDED

  @@schema("placement")
}

// Track 4 / T4-C — the ratified ending-reason taxonomy. An ENDED ContractAssignment
// authoritatively distinguishes the three ratified business categories as a CLOSED
// enum, never free text: COMPLETED (normal completion), WORKER_ENDED (worker quit /
// resigned), CLIENT_ENDED (employer/client ended). ENDED rows require one; ACTIVE
// rows carry none (CHECK, migration 20260810120000).
enum ContractAssignmentEndReason {
  COMPLETED
  WORKER_ENDED
  CLIENT_ENDED
  // Track 7 / T7-PX — the contract assignment ended because the engagement was
  // CONVERTED to a permanent placement. A genuine domain value (NOT attrition):
  // it distinguishes a conversion end from COMPLETED/WORKER_ENDED/CLIENT_ENDED so
  // T9-B3 can exclude it from the ordinary ENDED/attrition count (§13).
  CONVERTED_TO_PERMANENT

  @@schema("placement")
}

// ContractAssignment — Track 4 / T4-A1. The authoritative post-start assignment
// record: the commitment record the recon proved absent (ADR-0024 PR-0b). Its
// existence means this talent has an authoritative post-start assignment against
// this requisition. Post-`STARTED` reality lives HERE, not in new PlacementProcess
// edges (T4-Q1) — PlacementProcess remains transition-terminal at STARTED.
//
// Provenance-conditional (Amendment §A3.1, E3 precedent): a FORWARD row carries a
// known lifecycle_state and org snapshot; a BACKFILLED row may carry neither.
// The two DB CHECKs (in migration 20260809120000) enforce that in the substrate.
// Cross-schema refs are UUID-only, no FK (§7.3). Additive migration; the
// generator-owned init stays byte-identical (§4 additive ownership).
model ContractAssignment {
  id String @id @db.Uuid

  tenant_id String @db.Uuid

  // Originating placement. Intra-schema but a plain scalar (no FK) for symmetry
  // with the single-pass tenant-reset delete (same rationale as E4's replaces_*).
  placement_process_id String @db.Uuid

  // Lineage + denormalised read axes, mirroring PlacementProcess (§3b).
  submittal_id     String @db.Uuid
  requisition_id   String @db.Uuid
  talent_record_id String @db.Uuid

  // Authoritative start fact. Forward: set at the STARTED transition. Backfill:
  // reconstructed from the immutable PlacementProcessEvent history (T4-A2).
  started_at DateTime @db.Timestamptz(6)

  provenance ContractAssignmentProvenance

  // Nullable at schema (Amendment §A3.1). Required for FORWARD by CHECK; a null
  // is admissible ONLY for BACKFILLED provenance — absence, not a canonical value.
  lifecycle_state ContractAssignmentState?

  // Org/site snapshot (§A3.3). company_id required for FORWARD by CHECK (current
  // = historical at start); nullable for BACKFILLED (historical org not
  // deterministically recoverable). site/department nullable throughout, as they
  // are nullable on Requisition itself.
  company_id            String? @db.Uuid
  site_id               String? @db.Uuid
  company_department_id String? @db.Uuid

  // Track 4 / T4-C — the ratified ending reason. Nullable at schema; required for
  // ENDED and forbidden otherwise (CHECK, migration 20260810120000). Distinguishes
  // normal completion / worker-ended / client-ended structurally.
  end_reason ContractAssignmentEndReason?

  // Track 6 / T6-B3 — the durable assignment-end instant (migration
  // 20260813130000). Nullable: ACTIVE assignments have none. Set once, at END,
  // to the single server T_end also used for commercial-window reconciliation
  // and the assignment.ended event — one clock, no independent timestamps.
  ended_at DateTime? @db.Timestamptz(6)

  // Slice #3 (LOCKED Aramo-Assignment-Extension v1.0, R-INITIAL-END) -- the
  // assignment-OWNED planned end (distinct from ended_at=actual, started_at=actual
  // start). Nullable at DB for backfill compatibility (absence, not a canonical
  // value) but REQUIRED at the app layer on new-assignment create. Extend moves it
  // strictly forward; Ending Soon derives from it. Independent of the Requisition
  // after create (the requisition may only PREFILL it).
  expected_end_at DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Idempotency: at most one assignment per originating start fact.
  @@unique([tenant_id, placement_process_id])
  @@index([tenant_id, requisition_id])
  @@index([tenant_id, submittal_id])
  @@index([tenant_id, talent_record_id])
  @@schema("placement")
}

// Slice #3 (LOCKED Aramo-Assignment-Extension v1.0, R-HORIZON) -- the append-only,
// DB-immutable history of assignment expected-end changes. ContractAssignment.
// expected_end_at is the CURRENT operational truth; this table is the HISTORICAL
// truth (one row per governed extend). previous is null only when the horizon is
// first established on a backfilled assignment; new is always present + strictly
// greater. Provenance seam (R-PROVENANCE): MANUAL today, VMS/API/SYSTEM later.
model AssignmentExtension {
  id String @id @db.Uuid

  tenant_id     String @db.Uuid
  assignment_id String @db.Uuid

  previous_expected_end_at DateTime? @db.Timestamptz(6)
  new_expected_end_at      DateTime  @db.Timestamptz(6)

  reason  AssignmentExtensionReason
  comment String?

  actor_id String @db.Uuid

  source             AssignmentExtensionSource
  external_reference String?

  occurred_at DateTime @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id, assignment_id, occurred_at])
  @@schema("placement")
}

// v1 extend reasons (R-EXTEND-COMMAND). DATA_CORRECTION is DEFERRED to a future
// distinct Edit/Correct operation -- a correction is not a genuine extension.
enum AssignmentExtensionReason {
  CLIENT_REQUEST
  PROJECT_EXTENSION
  RENEWAL
  SCOPE_CONTINUATION

  @@schema("placement")
}

// Provenance of an extension (R-PROVENANCE, T8 provider-neutral). No
// Fieldglass/Beeline-specific column ever lands on the aggregate.
enum AssignmentExtensionSource {
  MANUAL
  VMS
  API
  SYSTEM

  @@schema("placement")
}

// AssignmentRateVersion — Track 5 / T5-P1. The person-specific, effective-dated
// ACTUAL commercial terms of a ContractAssignment (Planning Package §5). T5-P1
// writes ONLY the INITIAL version, created atomically with the FORWARD STARTED
// ContractAssignment in the same transaction (Amendment A1 — never a committed
// steady state with a started assignment lacking its initial terms). APPEND-ONLY:
// an existing version is NEVER ordinarily UPDATEd (immutability trigger, migration
// 20260810130000). Subsequent effective-dated versions (revisions/extensions) are
// T6, not T5. Shared currency + rate_period value objects live in libs/common
// (Amendment A2 — no placement->requisition edge). ONE currency governs both pay
// and bill (Amendment A1-9; mixed-currency version rejected at the write boundary).
// Derived spread/margin/markup are NOT stored — computed-on-read in T5-P2.
// Cross-schema refs are UUID-only, no FK (§7.3), symmetric with the single-pass
// tenant-reset delete.
model AssignmentRateVersion {
  id String @id @db.Uuid

  tenant_id String @db.Uuid

  // Anchor to the owning ContractAssignment. Intra-schema plain scalar (no FK)
  // for symmetry with ContractAssignment.placement_process_id (§7.3).
  contract_assignment_id String @db.Uuid

  // Denormalised read/lineage axes, mirroring ContractAssignment — tenant-scoped
  // reads (and the T5->T9 projection) without a cross-row join.
  requisition_id   String @db.Uuid
  talent_record_id String @db.Uuid

  // ACTUAL person-specific commercial terms (Amendment A1-2 / A1-9). Decimal money,
  // never float. currency + rate_period validated against the libs/common shared
  // closed sets at the write boundary (VALIDATION_ERROR on miss). Stored as TEXT
  // (NOT a Postgres enum — the ISO list evolves; A2-3). One currency governs BOTH
  // pay and bill. Derived spread/margin/markup are NOT columns (T5-P2 read).
  pay_rate_amount  Decimal @db.Decimal(12, 2)
  bill_rate_amount Decimal @db.Decimal(12, 2)
  currency         String
  rate_period      String

  // Effective-dating (Planning Package §5). effective_from = the ONE authoritative
  // assignment-start instant shared with the assignment-start evidence (Amendment
  // A1-8 — no per-layer wall-clock drift). The initial active version has NO
  // effective_to; window-close belongs to T6.
  effective_from DateTime  @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)

  // Recording provenance (Planning Package §5 "approval provenance"). recorded_by
  // = the Aramo user (JWT sub) who supplied the terms — same convention as
  // client-talent-restriction.recorded_by. change_reason is an optional note.
  recorded_by   String  @db.Uuid
  change_reason String?

  // Cancellation representation (Track 6 / T6-B1 §3). Same-row so the overlap
  // exclusion constraint can drop cancelled rows via a single-table partial
  // predicate (an index predicate cannot reach through a join). NULL for every
  // existing and B1-created row: B1 writes NONE of these — the B3 cancellation
  // operation owns their governed one-shot write. cancellation_reason_code is a
  // nullable code (NOT a Postgres enum yet — B3 rules the vocabulary). The DB
  // interval CHECK, the btree_gist overlap EXCLUDE, and the governed effective_to
  // first-close trigger are migration-only (20260812140000), invisible to
  // prisma:validate, mirroring the existing append-only trigger + pg_trgm precedent.
  cancelled_at             DateTime? @db.Timestamptz(6)
  cancelled_by             String?   @db.Uuid
  cancellation_reason_code String?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Version-ready idempotency floor: keyed on the effective instant so T6 can add
  // later versions, while a retry of the same atomic start cannot double-insert.
  @@unique([tenant_id, contract_assignment_id, effective_from])
  @@index([tenant_id, contract_assignment_id])
  @@index([tenant_id, requisition_id])
  @@schema("placement")
}

// PermanentPlacementState — Track 7 / T7-P1. The P1 happy-path guarantee
// lifecycle. Ships EXACTLY the two states the direct-permanent slice reaches:
// GUARANTEE_ACTIVE (created at the permanent STARTED handoff, inside the
// contractual guarantee window) and GUARANTEE_SATISFIED (the window completed
// with no qualifying falloff — terminal). FELL_OFF and the remedy states
// (REPLACEMENT_DUE / REFUND_DUE / PRORATED_CREDIT_DUE / REMEDY_COMPLETED) are
// DELIBERATELY ABSENT — they are the T7-P2 slice and land as additive members
// with their ratified edges (the ContractAssignmentState "ships ACTIVE only"
// precedent). Enforcement is a typed transition registry (src/lib/lifecycle),
// NOT a generated DB trigger (T7-P1 directive §3.3); P2 may revisit a DB trigger
// if the expanded lifecycle warrants it.
enum PermanentPlacementState {
  GUARANTEE_ACTIVE
  GUARANTEE_SATISFIED
  // Track 7 / T7-P2 — the falloff + remedy lifecycle (additive ALTER TYPE ADD VALUE,
  // migration 20260815120000). FELL_OFF is atomically traversed into exactly one
  // *_DUE state inside the falloff transaction (§3.2). REMEDY_COMPLETED is terminal.
  FELL_OFF
  REPLACEMENT_DUE
  REFUND_DUE
  PRORATED_CREDIT_DUE
  REMEDY_COMPLETED

  @@schema("placement")
}

// RemedyPolicy — Track 7. The closed, terms-driven remedy the guarantee snapshot
// commits to at activation (T7-PRE §8): the single canonical remedy that a
// qualifying falloff will require. SNAPSHOTTED in P1 (an immutable activation
// fact) but only EXECUTED in P2 — P1 implements no falloff/remedy transition.
// Never a Postgres enum guess about priority: exactly one policy is chosen from
// governed terms, never heuristically among several.
enum RemedyPolicy {
  REPLACEMENT
  REFUND
  PRORATED_CREDIT

  @@schema("placement")
}

// PermanentPlacementEventType — closed-list event-log type. Mirrors the
// PlacementProcessEvent substrate (one type at the spine; richer types land with
// P2 falloff/remedy consumers).
enum PermanentPlacementEventType {
  state_transition

  @@schema("placement")
}

// PermanentPlacement — Track 7 / T7-P1. The first-class post-start PERMANENT
// aggregate, parallel to ContractAssignment (T7-PRE §3.1 — NOT a ContractAssignment
// subtype, PlacementProcess subtype, pipeline row, or reporting projection).
// Materialised transactionally at the Placement STARTED handoff for a PERMANENT
// placement_kind, and NOT for CONTRACT/NULL. Carries an IMMUTABLE guarantee
// snapshot sufficient to determine the guarantee outcome without consulting
// mutable client defaults (T7-PRE §7). Cross-schema refs are UUID-only, no FK
// (§7.3), symmetric with ContractAssignment. Additive migration 20260814120000.
//
// COMMERCIAL PROVENANCE (§3.2): the direct-permanent path mints NO
// ContractAssignment and NO AssignmentRateVersion, so guarantee_exposure_amount
// is a GOVERNED INPUT snapshot fact (explicit amount + currency + provenance),
// NEVER derived from a rate version and NEVER read cross-schema from the
// requisition/client-contract. The guarantee-specific proration formula is
// Track-7-owned (T7-P2); underlying pay/bill/markup/margin remain T5-owned.
model PermanentPlacement {
  id String @id @db.Uuid

  tenant_id String @db.Uuid

  // Originating placement. Intra-schema plain scalar (no FK), symmetric with
  // ContractAssignment.placement_process_id (§7.3 / single-pass tenant-reset).
  placement_process_id String @db.Uuid

  // Lineage + denormalised read axes, mirroring ContractAssignment (§3b) — the
  // (tenant, requisition) capacity read needs no cross-row join.
  submittal_id     String @db.Uuid
  requisition_id   String @db.Uuid
  talent_record_id String @db.Uuid

  lifecycle_state PermanentPlacementState

  // Guarantee window (T7-PRE §5). Calendar DATES, not wall-clock instants — the
  // guarantee is a calendar concept, stable across time zones and DST. Half-open
  // interval [guarantee_start_date, guarantee_end_date). guarantee_start_date is
  // the actual permanent employment start represented by the STARTED handoff;
  // guarantee_end_date = start + guarantee_duration_days (a positive integer,
  // else the placement fails closed before activation).
  guarantee_start_date    DateTime @db.Date
  guarantee_duration_days Int
  guarantee_end_date      DateTime @db.Date

  // Immutable remedy + commercial-exposure snapshot (§7/§8/§9). remedy_policy is
  // the single terms-driven remedy a qualifying falloff will require (executed in
  // P2). guarantee_exposure_amount is the maximum amount subject to refund/credit,
  // a GOVERNED INPUT (decimal money, never float; scale-2, matching the T5 money
  // column convention). currency is stored as TEXT (ISO-4217, validated at the
  // write boundary — the AssignmentRateVersion.currency precedent).
  remedy_policy               RemedyPolicy
  guarantee_exposure_amount   Decimal @db.Decimal(12, 2)
  guarantee_exposure_currency String

  // Terms provenance (§7 "provenance/source of terms"). terms_source is a
  // governed free-form provenance label (e.g. the origin of the guarantee terms);
  // recorded_by is the Aramo user (JWT sub) who supplied them — the
  // AssignmentRateVersion.recorded_by / client-talent-restriction convention.
  terms_source String
  recorded_by  String @db.Uuid

  // Track 7 / T7-P2 — write-once qualifying-falloff facts (§5). All NULL until a
  // governed falloff (GUARANTEE_ACTIVE -> FELL_OFF); then all set together in the
  // one falloff transaction and NEVER rewritten/cleared. falloff_effective_date is
  // a calendar DATE in the half-open window [guarantee_start_date, guarantee_end_date).
  // falloff_reason is a governed code from the closed T7 registry (permanent-falloff-
  // reasons.ts; TEXT, no enum, no OTHER). Immutability is NULL-safe conditional (the
  // migration trigger permits the first NULL->value write, forbids any later change) —
  // NOT pinned via a bare OLD=NEW (the NULL=NULL trap). Additive migration 20260815120000.
  falloff_effective_date DateTime? @db.Date
  falloff_reason         String?
  falloff_recorded_by    String?   @db.Uuid
  falloff_recorded_at    DateTime? @db.Timestamptz(6)

  // Track 7 / T7-P3 — guarantee-terms provenance snapshot (§7). NULL for every
  // P1/P2 row (no stored term version applied — legacy explicit path) and never
  // backfilled. When a resolved PermanentPlacementGuaranteeTermVersion is applied at
  // activation, these are COPIED once (with the existing guarantee_* payload columns)
  // and then frozen: NULL-safe write-once immutability in the snapshot trigger (the
  // falloff-field idiom — never a bare OLD=NEW). guarantee_term_version_id is a plain
  // intra-schema UUID pointer (no FK — a lineage ref, symmetric with the plain-scalar
  // convention); source_type is the closed code-owned registry value (MANUAL|IMPORTED).
  // Additive migration 20260816120000.
  guarantee_term_version_id        String? @db.Uuid
  guarantee_terms_source_type      String?
  guarantee_terms_source_reference String?
  guarantee_terms_source_version   String?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Intra-schema back-reference for the event-log FK (relation-only field).
  events PermanentPlacementEvent[]

  // Track 7 / T7-P2 — the remedy obligation child (relation-only field). Declared
  // as a list for Prisma's relation model; the child's @@unique([tenant_id,
  // permanent_placement_id]) enforces AT MOST ONE (§3.3). The repository queries the
  // child directly, never via this accessor.
  remedies PermanentPlacementRemedy[]

  // Idempotency: at most one PermanentPlacement per originating start fact
  // (§3.2) — the branch-exclusivity + replay floor, mirroring ContractAssignment.
  @@unique([tenant_id, placement_process_id])
  // (tenant, requisition): the derived-capacity consuming-count read (§7/§10).
  @@index([tenant_id, requisition_id])
  @@index([tenant_id, talent_record_id])
  @@schema("placement")
}

// PermanentPlacementEvent — Track 7 / T7-P1. Append-only, immutable audit log of
// the guarantee lifecycle, mirroring PlacementProcessEvent (§3). No update/delete
// surface; both enforced by DB triggers in the additive migration. The
// state_transition payload is { from, to } (from is null for the creation/
// activation event). NO PII: the payload carries IDs, state, and governed
// snapshot facts only.
model PermanentPlacementEvent {
  id        String @id @db.Uuid
  tenant_id String @db.Uuid

  // Intra-schema FK to PermanentPlacement (permitted — §3, §7.3).
  permanent_placement_id String             @db.Uuid
  permanent_placement    PermanentPlacement @relation(fields: [permanent_placement_id], references: [id])

  event_type    PermanentPlacementEventType
  event_payload Json

  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id, permanent_placement_id])
  @@index([permanent_placement_id, created_at])
  @@schema("placement")
}

// PermanentPlacementRemedy — Track 7 / T7-P2. The dedicated remedy-obligation child
// of a PermanentPlacement (directive §3.3 / §9). EXACTLY ONE per PermanentPlacement
// (@@unique). Created inside the falloff transaction the moment the deterministic
// remedy-due state is entered. Two immutability regimes on one row (migration
// 20260815120000):
//   OBLIGATION facts — immutable forever the instant the row is inserted (remedy_type,
//   calculated_amount, currency, calc inputs/provenance, falloff_effective_date, due_at,
//   created_by): a BEFORE UPDATE trigger rejects any change to them.
//   COMPLETION facts — one-way NULL -> valid-set-once, then frozen (completed_at,
//   completed_by, completion_reference, replacement_placement_process_id): NULL-safe
//   conditional immutability.
// FINANCIAL SEMANTICS (§3.4): this records the OBLIGATION and a governed completion
// REFERENCE only. Aramo does NOT execute refunds/credits/payments and mints NO
// payment/ledger/payout object. calculated_amount is the amount OWED under the
// guarantee, computed by the T7-owned remedy-computation helper — never a money movement.
model PermanentPlacementRemedy {
  id        String @id @db.Uuid
  tenant_id String @db.Uuid

  // Anchor to the owning PermanentPlacement. Intra-schema FK permitted (§7.3). The
  // unique makes it at-most-one remedy per aggregate — the idempotency floor.
  permanent_placement_id String             @db.Uuid
  permanent_placement    PermanentPlacement @relation(fields: [permanent_placement_id], references: [id])

  // Denormalised lineage read axes (tenant-scoped reads without a cross-row join).
  requisition_id   String @db.Uuid
  talent_record_id String @db.Uuid

  // The remedy type = the immutable snapshot RemedyPolicy (deterministic — §6).
  remedy_type RemedyPolicy

  // OBLIGATION amount (immutable). Set for REFUND (= exposure) and PRORATED_CREDIT
  // (the T7-owned proration); NULL for REPLACEMENT (a non-monetary obligation).
  // Decimal money, never float, scale-2 (the exposure column convention). currency
  // present iff calculated_amount is present.
  calculated_amount Decimal? @db.Decimal(12, 2)
  currency          String?

  // Calculation inputs / provenance (immutable audit of how the amount was derived):
  // the exposure + duration snapshots and the clamped remaining_days (proration only).
  exposure_amount_snapshot Decimal @db.Decimal(12, 2)
  duration_days_snapshot   Int
  remaining_days           Int?
  falloff_effective_date   DateTime @db.Date

  // Obligation provenance (immutable). due_at = the falloff-transaction instant.
  created_by String   @db.Uuid
  due_at     DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // COMPLETION facts — one-way enrichment, written exactly once (§9). Coherence
  // (migration CHECK, conditional on completed_at): REPLACEMENT -> replacement id set,
  // external reference NULL; REFUND/PRORATED_CREDIT -> external reference set,
  // replacement id NULL. Caller never supplies the amount.
  completed_at                     DateTime? @db.Timestamptz(6)
  completed_by                     String?   @db.Uuid
  completion_reference             String?
  replacement_placement_process_id String?  @db.Uuid

  @@unique([tenant_id, permanent_placement_id])
  @@index([tenant_id, requisition_id])
  @@schema("placement")
}

// PermanentPlacementGuaranteeTermVersion — Track 7 / T7-P3. The reusable,
// placement-owned, effective-dated SOURCE of permanent-placement guarantee terms,
// keyed by (tenant_id, requisition_id) — reusable across the requisition's permanent
// placements (directive §3.1). NOT keyed by talent or PlacementProcess, and requires
// NO placement->requisition library dependency (requisition_id is a plain cross-schema
// UUID axis, never a join). APPEND-ONLY versioned business history (§3.8 — no separate
// history table): each governed revision inserts a successor and first-closes the
// predecessor's open window. The IMMUTABLE PermanentPlacement snapshot COPIES the
// resolved values at activation (§7); there is NO live-read after activation.
//
// Effective-dating is CALENDAR DATE, half-open [effective_from, effective_to) (§3.2) —
// the guarantee-window convention, NOT the AssignmentRateVersion TIMESTAMPTZ instant
// convention. Overlap for a (tenant, requisition) is forbidden by a btree_gist
// daterange EXCLUDE (§5); unique(tenant, requisition, effective_from) is the
// idempotency/replay floor. All payload + provenance fields are immutable after
// insert; the ONLY governed mutation is effective_to NULL->date once (revision
// first-close). DELETE forbidden except the exact-value governed tenant-reset GUC
// escape. The interval CHECK, btree_gist EXCLUDE, append-only + first-close trigger,
// and reset escape are migration-only (20260816120000), invisible to prisma:validate,
// mirroring the AssignmentRateVersion precedent. No cancellation columns (P3 defers
// future-version cancellation, §3.5).
//
// COMMERCIAL PROVENANCE (§3.3): guarantee_exposure_amount + currency are GOVERNED T7
// term data (explicit input), NEVER derived from AssignmentRateVersion and NEVER
// duplicating deriveCommercialMetrics. source_type is the closed code-owned registry
// (guarantee-terms-source.ts: MANUAL | IMPORTED; TEXT + DB CHECK — no premature
// CLIENT_CONTRACT / RATE_CARD, §3.6).
model PermanentPlacementGuaranteeTermVersion {
  id String @id @db.Uuid

  tenant_id String @db.Uuid

  // Reusable ownership axis (§3.1). Plain cross-schema UUID scalar (no FK, no join,
  // no placement->requisition edge). Available BEFORE any PlacementProcess exists, so
  // terms can be prepared pre-start and resolved deterministically at activation.
  requisition_id String @db.Uuid

  // Effective-dating (§3.2). CALENDAR DATES, half-open [effective_from, effective_to).
  // effective_to NULL = the open current tail; first-close (NULL->date, once) is the
  // sole governed mutation. Resolution compares an as_of calendar date against the
  // half-open window using the existing T7 UTC calendar-date semantics.
  effective_from DateTime  @db.Date
  effective_to   DateTime? @db.Date

  // Reusable guarantee-term payload (§3.3). guarantee_duration_days > 0 (DB CHECK);
  // guarantee_exposure_amount >= 0 (DB CHECK; Decimal money, never float, scale-2 —
  // the exposure column convention). currency TEXT (ISO-4217, validated at the write
  // boundary). remedy_policy is the closed terms-driven RemedyPolicy.
  guarantee_duration_days   Int
  remedy_policy             RemedyPolicy
  guarantee_exposure_amount Decimal @db.Decimal(12, 2)
  currency                  String

  // Structured provenance (§3.6). source_type is the closed code-owned registry value
  // (MANUAL | IMPORTED; TEXT + DB CHECK). source_reference / source_version are optional
  // governed references (e.g. an import batch id + version). recorded_by = the Aramo
  // user (JWT sub). recorded_at = the governed recording instant (may predate created_at
  // for an IMPORTED source). supersedes_version_id points at the predecessor this version
  // first-closed (NULL for an initial version). correlation_id is an optional governed
  // trace id. NO free-form change note in P3.
  source_type           String
  source_reference      String?
  source_version        String?
  recorded_by           String   @db.Uuid
  recorded_at           DateTime @db.Timestamptz(6)
  supersedes_version_id String?  @db.Uuid
  correlation_id        String?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Idempotency/replay floor keyed on the effective date (§4). The btree_gist daterange
  // EXCLUDE (migration-only) enforces no-overlap for (tenant, requisition).
  @@unique([tenant_id, requisition_id, effective_from])
  @@index([tenant_id, requisition_id])
  @@schema("placement")
}

// Track 7 / T7-PX — the immutable Contract-to-Permanent conversion lineage record.
// One append-only row per governed conversion, capturing the deterministic link from
// the (now-ended, frozen) source contract lineage to the newly-minted permanent
// lineage, plus tenant, conversion instant, and actor (§4). It is the idempotency
// anchor: at most one conversion per source ContractAssignment (tenant-safe unique),
// so a stale retry replays the same target rather than minting a second permanent
// placement (§11). Plain cross-schema UUID scalars (no FK), mirroring the placement
// no-FK convention. NOT E4 replaces_placement_process_id (§4 — a distinct lineage).
model PermanentPlacementConversionLineage {
  id String @id @db.Uuid

  tenant_id String @db.Uuid

  // Source (contract) side — the originating STARTED contract placement and its
  // now-ENDED ContractAssignment (end_reason = CONVERTED_TO_PERMANENT).
  source_placement_process_id   String @db.Uuid
  source_contract_assignment_id String @db.Uuid

  // Target (permanent) side — the newly-created PERMANENT PlacementProcess and its
  // GUARANTEE_ACTIVE PermanentPlacement (the permanent lineage anchor).
  target_placement_process_id   String @db.Uuid
  target_permanent_placement_id String @db.Uuid

  // T_convert — the single absolute conversion instant captured once in the
  // transaction (also ContractAssignment.ended_at + the commercial-window close +
  // the permanent creation timing). converted_by = the acting principal (JWT sub).
  converted_at DateTime @db.Timestamptz(6)
  converted_by String   @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Idempotency/replay floor: at most one conversion per source ContractAssignment
  // (and, redundantly, per source placement). A concurrent duplicate collides here.
  @@unique([tenant_id, source_contract_assignment_id])
  @@unique([tenant_id, source_placement_process_id])
  @@index([tenant_id, target_placement_process_id])
  @@schema("placement")
}
