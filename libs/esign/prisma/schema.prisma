// Per-module Prisma schema for the `esign` module (DOC-3 — Native E-Sign Service Core).
//
// Governing directive: Aramo-DOC-3-Native-ESign-Service-Core-Slice-Directive-v1_0-LOCKED
// (parent: Aramo-DOC-Documents-and-Native-ESignature-Architecture-and-Build-Directive-v1_1-LOCKED).
//
// ATS-neutral (§229; Invariant 2/19): this schema references Documents ONLY by
// opaque UUID (EnvelopeDocument.document_ref / document_revision_ref) — NO
// cross-schema FK, NO import of any ATS/cip domain. Canonical aggregate names
// (PO ruling 2026-09-22): SignatureEnvelope, SignatureField, SignerDisclosureAcceptance.
// SignatureEvent is append-only with a tamper-evident hash chain (R20/§256).

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["esign"]
}

/// The signature envelope aggregate — one signing transaction.
model SignatureEnvelope {
  id             String    @id @db.Uuid
  tenant_id      String    @db.Uuid
  subject        String
  status         String // CHECK: DRAFT|SENT|IN_PROGRESS|COMPLETED|DECLINED|VOIDED|EXPIRED
  execution_mode String // CHECK: ACKNOWLEDGEMENT|SINGLE_SIGNATURE|MULTI_SIGNATURE
  created_by     String    @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @updatedAt @db.Timestamptz
  sent_at        DateTime? @db.Timestamptz
  completed_at   DateTime? @db.Timestamptz
  declined_at    DateTime? @db.Timestamptz
  voided_at      DateTime? @db.Timestamptz
  expires_at     DateTime? @db.Timestamptz
  // Sign Unified Product S-1 — provenance. created_by is the owner (the user on
  // whose behalf the envelope was sent). source_application: 'aramo-sign' (the
  // Sign app) | 'aramo-ats' | a registered application key (S-4).
  source_application String  @default("aramo-sign")
  installation_id    String? @db.Uuid
  origin_actor_kind  String  @default("USER") // CHECK: USER|APPLICATION

  documents EnvelopeDocument[]
  signers   Signer[]
  sessions  SigningSession[]
  events    SignatureEvent[]
  executed_access ExecutedAccessGrant[]

  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([tenant_id, created_by])
  @@schema("esign")
}

/// A source document attached to an envelope. Two source modes (PX-V1 F1):
/// CORE_REF = a frozen Core Documents revision pulled over HTTP (legacy ATS path,
/// UUID-ref only, no FK); OWNED = an uploaded PDF E-Sign owns in object storage
/// (source_object_key). document_ref/document_revision_ref are set only for
/// CORE_REF; source_object_key/content_type/byte_size only for OWNED.
model EnvelopeDocument {
  id                    String  @id @db.Uuid
  tenant_id             String  @db.Uuid
  envelope_id           String  @db.Uuid
  source_mode           String  @default("CORE_REF")
  document_ref          String? @db.Uuid
  document_revision_ref String? @db.Uuid
  source_object_key     String?
  content_type          String?
  byte_size             Int?
  title                 String
  source_sha256         String
  ordinal               Int

  envelope SignatureEnvelope @relation(fields: [envelope_id], references: [id], onDelete: Cascade)
  fields   SignatureField[]

  @@unique([envelope_id, document_ref])
  @@index([tenant_id])
  @@index([envelope_id])
  @@schema("esign")
}

/// A party who must sign/acknowledge. Signing is PARALLEL: every signer receives a
/// live session at send and may complete in any order. signing_order is a stable
/// per-envelope sequence number (unique per envelope); it is NOT enforced (ES-1).
model Signer {
  id            String    @id @db.Uuid
  tenant_id     String    @db.Uuid
  envelope_id   String    @db.Uuid
  email         String
  name          String
  signing_order Int
  signer_role   String?
  status        String // CHECK: PENDING|VIEWED|SIGNED|DECLINED
  viewed_at     DateTime? @db.Timestamptz
  signed_at     DateTime? @db.Timestamptz
  declined_at   DateTime? @db.Timestamptz
  decline_reason String?

  envelope    SignatureEnvelope            @relation(fields: [envelope_id], references: [id], onDelete: Cascade)
  fields      SignatureField[]
  sessions    SigningSession[]
  disclosures SignerDisclosureAcceptance[]

  @@unique([envelope_id, signing_order])
  @@index([tenant_id])
  @@index([envelope_id])
  @@schema("esign")
}

/// A placement of a signable field on an envelope document, assigned to a signer.
model SignatureField {
  id                   String    @id @db.Uuid
  tenant_id            String    @db.Uuid
  envelope_document_id String    @db.Uuid
  signer_id            String?   @db.Uuid
  field_type           String // CHECK: SIGNATURE|INITIALS|SIGN_DATE|SIGNER_NAME|TEXT|CHECKBOX|ACKNOWLEDGEMENT
  signature_method     String? // CHECK (nullable): TYPED|DRAWN|UPLOADED|DIGITAL_CERTIFICATE
  page_number          Int
  x                    Float
  y                    Float
  width                Float?
  height               Float?
  required             Boolean   @default(true)
  value                String?
  filled_at            DateTime? @db.Timestamptz

  envelope_document EnvelopeDocument @relation(fields: [envelope_document_id], references: [id], onDelete: Cascade)
  signer            Signer?          @relation(fields: [signer_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([envelope_document_id])
  @@index([signer_id])
  @@schema("esign")
}

/// A short-lived capability-token signing session (R17/§250). token_hash is the
/// sha256(base64url) of the raw token; the raw token is NEVER persisted.
model SigningSession {
  id                String    @id @db.Uuid
  tenant_id         String    @db.Uuid
  envelope_id       String    @db.Uuid
  signer_id         String    @db.Uuid
  token_hash        String
  status            String // CHECK: ISSUED|EXCHANGED|ACTIVE|COMPLETED|EXPIRED|REVOKED
  created_at        DateTime  @default(now()) @db.Timestamptz
  expires_at        DateTime  @db.Timestamptz
  first_accessed_at DateTime? @db.Timestamptz
  last_accessed_at  DateTime? @db.Timestamptz
  completed_at      DateTime? @db.Timestamptz
  revoked_at        DateTime? @db.Timestamptz
  failed_auth_count Int       @default(0)

  envelope SignatureEnvelope @relation(fields: [envelope_id], references: [id], onDelete: Cascade)
  signer   Signer            @relation(fields: [signer_id], references: [id], onDelete: Cascade)

  @@unique([token_hash])
  @@index([tenant_id])
  @@index([envelope_id])
  @@index([signer_id])
  @@schema("esign")
}

/// The signer's acceptance of the E-Sign electronic-record disclosure (R16/§246).
/// Versioned frozen text + sha256; distinct from the Consent domain.
model SignerDisclosureAcceptance {
  id                   String   @id @db.Uuid
  tenant_id            String   @db.Uuid
  signer_id            String   @db.Uuid
  disclosure_version   String
  disclosure_text_hash String
  accepted_at          DateTime @default(now()) @db.Timestamptz
  ip_address           String?
  user_agent           String?
  session_id           String   @db.Uuid

  signer Signer @relation(fields: [signer_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([signer_id])
  @@schema("esign")
}

/// Append-only signature-event ledger with a tamper-evident hash chain (R20/§256).
/// UPDATE/DELETE rejected by an unconditional DB trigger. event_hash chains from
/// previous_event_hash; the terminal event_hash is the envelope's event-chain hash.
model SignatureEvent {
  id                  String   @id @db.Uuid
  tenant_id           String   @db.Uuid
  envelope_id         String   @db.Uuid
  signer_id           String?  @db.Uuid
  event_type          String
  actor_type          String // CHECK: SIGNER|SYSTEM|SERVICE
  actor_ref           String?  @db.Uuid
  payload             Json?
  previous_event_hash String?
  event_hash          String
  occurred_at         DateTime @default(now()) @db.Timestamptz
  ip_address          String?
  user_agent          String?

  envelope SignatureEnvelope @relation(fields: [envelope_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, envelope_id, occurred_at])
  @@index([tenant_id, occurred_at])
  @@schema("esign")
}

/// A durable notification delivery-attempt record (§298; NEW E-Sign-domain work).
model NotificationDelivery {
  id                String    @id @db.Uuid
  tenant_id         String    @db.Uuid
  envelope_id       String    @db.Uuid
  signer_id         String?   @db.Uuid
  notification_kind String // CHECK: SIGNATURE_REQUEST|SIGNATURE_REMINDER|SIGNATURE_COMPLETED|SIGNATURE_DECLINED|SIGNATURE_EXPIRED|SIGNATURE_VOIDED
  status            String // CHECK: PENDING|SENT|FAILED
  attempts          Int       @default(0)
  last_error        String?
  created_at        DateTime  @default(now()) @db.Timestamptz
  sent_at           DateTime? @db.Timestamptz

  @@index([tenant_id])
  @@index([envelope_id])
  @@schema("esign")
}

/// Schema-local idempotency for cross-service mutations (Invariant 16).
model IdempotencyKey {
  id              String   @id @db.Uuid
  tenant_id       String   @db.Uuid
  key             String
  request_hash    String
  response_status Int?
  response_body   Json?
  created_at      DateTime @default(now()) @db.Timestamptz

  @@unique([tenant_id, key])
  @@schema("esign")
}

/// Transactional outbox — rows written in the same $transaction as state changes.
model OutboxEvent {
  id            String    @id @db.Uuid
  tenant_id     String    @db.Uuid
  event_type    String
  event_payload Json
  created_at    DateTime  @default(now()) @db.Timestamptz
  published_at  DateTime? @db.Timestamptz
  // E-Sign OC v2 (DEC-A) — durable outbound-delivery retry/backoff state. E-Sign
  // owns reliable lifecycle-event delivery, so the outbox persists attempt
  // bookkeeping + a backoff schedule instead of a blind fixed-interval retry.
  // last_error_code is a bounded, sanitized short diagnostic (never raw bodies).
  attempt_count   Int       @default(0)
  next_attempt_at DateTime? @db.Timestamptz
  last_attempt_at DateTime? @db.Timestamptz
  last_error_code String?   @db.VarChar(64)

  @@index([published_at])
  @@index([published_at, next_attempt_at])
  @@schema("esign")
}

/// DOC-4 (R-4-3) — the executed document bytes produced at envelope completion,
/// held TRANSIENTLY in esign until the Documents write-back (R-4-7) stores the
/// permanent EXECUTED artifact. esign is NOT a second document repository
/// (invariant 12); rows are disposable once written back.
model ExecutedDocument {
  id                   String   @id @db.Uuid
  tenant_id            String   @db.Uuid
  envelope_id          String   @db.Uuid
  envelope_document_id String   @db.Uuid
  source_sha256        String
  executed_sha256      String
  byte_size            Int
  executed_bytes       Bytes
  produced_at          DateTime @default(now()) @db.Timestamptz
  written_back_at      DateTime? @db.Timestamptz

  @@unique([envelope_document_id])
  @@index([tenant_id])
  @@index([envelope_id])
  @@schema("esign")
}

/// DOC-4 (R-4-6) — the human-readable execution certificate PDF produced at
/// completion (one per envelope). Held transiently in esign until the Documents
/// write-back stores the permanent EXECUTION_CERTIFICATE artifact.
model ExecutionCertificate {
  id              String    @id @db.Uuid
  tenant_id       String    @db.Uuid
  envelope_id     String    @db.Uuid
  certificate_sha256 String
  byte_size       Int
  certificate_bytes Bytes
  produced_at     DateTime  @default(now()) @db.Timestamptz
  written_back_at DateTime? @db.Timestamptz

  @@unique([envelope_id])
  @@index([tenant_id])
  @@schema("esign")
}

/// A time-limited capability that lets a signer download the executed document and
/// certificate of a COMPLETED envelope (sent in the completion email). Only
/// sha256(base64url) of the raw token is stored, exactly like SigningSession.
model ExecutedAccessGrant {
  id               String    @id @db.Uuid
  tenant_id        String    @db.Uuid
  envelope_id      String    @db.Uuid
  signer_id        String    @db.Uuid
  token_hash       String    @unique
  expires_at       DateTime  @db.Timestamptz
  created_at       DateTime  @default(now()) @db.Timestamptz
  last_accessed_at DateTime? @db.Timestamptz
  access_count     Int       @default(0)

  envelope SignatureEnvelope @relation(fields: [envelope_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([envelope_id])
  @@schema("esign")
}

// ── Sign Unified Product S-4 — application registry, installations, credentials ──
// (Aramo-Sign-Unified-Product-Permission-Contract-Platform-API-Directive-v1_0-LOCKED §4.4)

/// A registered application that integrates with Aramo Sign.
model SignApplication {
  id                        String   @id @db.Uuid
  key                       String   @unique
  name                      String
  kind                      String // CHECK: FIRST_PARTY|THIRD_PARTY
  status                    String   @default("ACTIVE") // CHECK: ACTIVE|DISABLED
  requested_permissions     String[] @default([])
  modes                     String[] @default([]) // subset of USER|APPLICATION
  assertable_roles          String[] @default([])
  delegation_profile        String[] @default([]) // FIRST_PARTY only
  delegation_required_scope String?
  created_at                DateTime @default(now()) @db.Timestamptz
  updated_at                DateTime @default(now()) @db.Timestamptz

  installations SignInstallation[]
  credentials   SignCredential[]

  @@schema("esign")
}

/// One application's installation in one tenant, with its bounded grant set.
model SignInstallation {
  id                     String    @id @db.Uuid
  tenant_id              String    @db.Uuid
  application_id         String    @db.Uuid
  status                 String    @default("ACTIVE") // CHECK: ACTIVE|REVOKED
  granted_permissions    String[]  @default([])
  modes                  String[]  @default([])
  integration_role       String? // CHECK: esign_admin|esign_sender|esign_viewer
  role_assertion_enabled Boolean   @default(false)
  first_party_auto       Boolean   @default(false)
  approved_by            String?   @db.Uuid
  approved_at            DateTime  @default(now()) @db.Timestamptz
  revoked_by             String?   @db.Uuid
  revoked_at             DateTime? @db.Timestamptz
  created_at             DateTime  @default(now()) @db.Timestamptz
  updated_at             DateTime  @default(now()) @db.Timestamptz

  application   SignApplication   @relation(fields: [application_id], references: [id])
  credentials   SignCredential[]
  role_mappings SignRoleMapping[]
  tokens        SignAccessToken[]

  @@unique([tenant_id, application_id], map: "SignInstallation_tenant_application_key")
  @@index([tenant_id])
  @@schema("esign")
}

/// A client credential. installation_id null = FIRST_PARTY application-level.
model SignCredential {
  id              String    @id @db.Uuid
  application_id  String    @db.Uuid
  installation_id String?   @db.Uuid
  client_id       String    @unique
  secret_hash     String
  status          String    @default("ACTIVE") // CHECK: ACTIVE|REVOKED
  created_by      String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  expires_at      DateTime? @db.Timestamptz
  last_used_at    DateTime? @db.Timestamptz
  revoked_at      DateTime? @db.Timestamptz

  application  SignApplication   @relation(fields: [application_id], references: [id])
  installation SignInstallation? @relation(fields: [installation_id], references: [id])
  tokens       SignAccessToken[]

  @@index([installation_id])
  @@schema("esign")
}

/// A tenant-approved mapping of an asserted external role to a Sign role (narrowing only).
model SignRoleMapping {
  installation_id String   @db.Uuid
  external_role   String
  sign_role       String // CHECK: esign_admin|esign_sender|esign_viewer
  created_at      DateTime @default(now()) @db.Timestamptz

  installation SignInstallation @relation(fields: [installation_id], references: [id], onDelete: Cascade)

  @@id([installation_id, external_role])
  @@schema("esign")
}

/// A short-lived integration access token (sha256 digest only).
model SignAccessToken {
  id              String    @id @db.Uuid
  token_hash      String    @unique
  credential_id   String    @db.Uuid
  installation_id String    @db.Uuid
  tenant_id       String    @db.Uuid
  mode            String // CHECK: USER|APPLICATION
  subject_id      String    @db.Uuid
  external_actor  String?
  external_role   String?
  scopes          String[]
  audience        String
  expires_at      DateTime  @db.Timestamptz
  created_at      DateTime  @default(now()) @db.Timestamptz
  revoked_at      DateTime? @db.Timestamptz

  credential   SignCredential   @relation(fields: [credential_id], references: [id])
  installation SignInstallation @relation(fields: [installation_id], references: [id])

  @@index([installation_id])
  @@index([expires_at])
  @@schema("esign")
}
