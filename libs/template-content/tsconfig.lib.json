{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/libs/template-content",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "tsBuildInfoFile": "../../dist/libs/template-content/.tsbuildinfo",
    "lib": ["es2022"],
    "types": [],
    "paths": {}
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/__tests__/**/*", "**/*.test.ts", "**/*.spec.ts"]
}
