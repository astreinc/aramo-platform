// Per-module Prisma schema for the `pipeline` module — PR-A5a (ATS Batch 4a).
//
// Per Architecture v2.0/v2.1 §7.1 (Schema-per-Module data architecture)
// and doc/05-conventions.md "Database Conventions". Cross-schema
// references are UUID-only without FK constraints (§7.3).
//
// PR-A5a Gate 5 — the ATS pipeline state machine (the heart of the
// batch). Pipeline is the (talent_record × requisition) join row that
// carries a status drawn from an 11-state enum. PipelineStatusHistory
// is the append-only audit of every legal transition.
//
// The application-layer state machine (libs/pipeline/src/lib/pipeline-
// state.ts) enforces the legal transition matrix; the DB enum is the
// closed-list substrate. Uniqueness is LIVE-SCOPED (Track 3 E6): the
// live-scoped partial unique index `Pipeline_live_episode_key`
// (tenant_id, talent_record_id, requisition_id WHERE status is live)
// permits AT MOST ONE LIVE episode per triple while allowing multiple
// historical (terminal) episodes to coexist. The partial index lives in
// the E6 raw migration, not in this schema DSL (Prisma cannot express a
// partial predicate); it is NOT an @@unique here.
//
// Refusals enforced structurally:
//   - R10 — NO portal-forbidden numeric/ordinal fields. Pipeline carries
//     a status label only; no portal-forbidden ranking columns. (A manual
//     per-talent rating was considered and REJECTED — see ADR-0019: Aramo
//     deliberately does not let recruiters rate or ordinally sort talent.
//     Row-level triage is the non-ordinal is_hot flag; qualitative read is
//     the activity feed.)
//   - R12 — locked vocabulary. The OpenCATS-derived anti-token does NOT
//     appear; the equivalent status is `talent_responded`.
//
// Cross-schema logical references (UUID-only, no FK per §7.3):
//   - talent_record_id   → talent_record.TalentRecord
//   - requisition_id     → requisition.Requisition
//   - PipelineStatusHistory.changed_by_id → identity.User
//
// PR-A5a/A5b boundary (Ruling 3): `placed` is the terminal status in
// this batch. NO `openings_available` decrement on requisition. NO
// submittal sync. Those sibling-domain writes belong to PR-A5b. This
// schema is ATS-internal at A5a.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["pipeline"]
}

// PipelineStatus — the 11-state OpenCATS-aligned recruiting funnel,
// vocabulary-renamed per R12. `talent_responded` replaces the OpenCATS
// legacy anti-token (the only R12-impacted label in the chain).
//
// Initial state for new Pipeline rows: `no_contact` (directive §2 /
// state-machine proof § "Initial state"). `no_status` is included for
// legacy-import parity; the application transition map never targets
// it.
enum PipelineStatus {
  no_status
  no_contact
  contacted
  talent_responded
  qualifying
  qualified // L2-C (D-6) — affirmative recruiter milestone
  submitted
  interviewing
  offered
  not_in_consideration
  client_declined
  placed
  completed // L2-C (D-2A) — canonical successful terminal (system-only COMPLETE)

  @@schema("pipeline")
}

// Pipeline — the (talent × requisition) join row carrying status.
// Multiple HISTORICAL episodes may coexist for one (talent, req) pair
// (Track 3 E6, Q-1); at most ONE LIVE episode is permitted per
// (tenant, talent, req) triple, enforced by the live-scoped partial
// unique `Pipeline_live_episode_key` in the E6 raw migration (Q-2).
model Pipeline {
  // Identity.
  id        String  @id @default(uuid()) @db.Uuid
  tenant_id String  @db.Uuid
  site_id   String? @db.Uuid

  // Cross-schema logical references (Architecture §7.3 — UUID-only, no FK).
  talent_record_id String @db.Uuid
  requisition_id   String @db.Uuid

  // Status — application-layer state machine enforces the legal
  // transition matrix on every write (see lib/pipeline-state.ts).
  status PipelineStatus @default(no_contact)

  // Timestamps.
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  // Optimistic-concurrency version (Lane 2 / L2-A). Monotonic per committed
  // status transition. The transition path requires a matching expected_version
  // (compare-and-swap); a stale value is refused with PIPELINE_TRANSITION_CONFLICT
  // (409) and writes nothing. Bumped by BOTH status writers: the transition tx
  // (repository) and the submit-to-ats mirror (apps/api/submit-talent), so a
  // subsequent expected_version stays sound. NOT bumped by the reconcile repoint
  // (it changes talent_record_id, never status, and does not contend on this field).
  version Int @default(0)

  // Episode terminal timestamp (Lane 2 / L2-B, SB-0). Written EXACTLY ONCE, on the
  // live -> terminal transition (the `isLiveStatus` flip), so it auto-tracks the
  // L2-C partition without a rewrite. NULL while the episode is live and for legacy
  // terminal rows (no backfill — legacy terminals are understood as ended without
  // rewriting them). Write-once by the frozen-terminal invariant (terminal statuses
  // have no outgoing edge), so it needs no immutability trigger.
  ended_at    DateTime? @db.Timestamptz
  ended_by_id String?   @db.Uuid

  // Intra-schema relation to the status-history audit.
  history          PipelineStatusHistory[]
  // Lane 2 / L2-C — the at-most-one immutable disposition (terminal reason).
  disposition      PipelineDisposition?
  // Lane 2 / L2-D — the at-most-one immutable entry-provenance (source-of-hire),
  // written atomically at episode birth.
  entry_provenance PipelineEntryProvenance?

  // Live-scoped uniqueness (Track 3 E6): at most one LIVE episode per
  // (tenant, talent, req) triple. A recruiter cannot open a second LIVE
  // episode while one is live; once an episode reaches a terminal status
  // (placed / not_in_consideration / client_declined) it releases the
  // live slot and a fresh episode may be created, with the prior episode
  // PRESERVED as history (Q-1). This is enforced by the partial unique
  // index `Pipeline_live_episode_key` in the E6 migration — Prisma cannot
  // express a partial (WHERE) predicate, so it is NOT an @@unique here.

  // Indexes — every query path leads with tenant_id.
  @@index([tenant_id, requisition_id])
  @@index([tenant_id, talent_record_id])
  @@index([tenant_id, status])
  @@index([tenant_id, site_id])
  @@schema("pipeline")
}

// PipelineStatusHistory — append-only audit of every legal transition.
// Written inside the same $transaction as the Pipeline.status update +
// the Activity emit + the metering recordUsage (the atomic guarantee
// per directive §3 / Ruling 6 the load-bearing state-machine proof).
//
// `status_from` is recorded explicitly even though it duplicates the
// prior row's `status_to` — this keeps each history row self-describing
// without a join.
model PipelineStatusHistory {
  // Identity.
  id        String @id @default(uuid()) @db.Uuid
  tenant_id String @db.Uuid

  // Parent pipeline (intra-schema FK).
  pipeline_id String   @db.Uuid
  pipeline    Pipeline @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)

  // The transition. `status_from` is NULLABLE (Lane 2 / L2-B): the birth row
  // (NULL -> no_contact) written by create() has no prior state. The append-only
  // UPDATE trigger is WHOLESALE (never a per-column OLD=NEW), so the nullable
  // column does not trip the `NULL = NULL is not TRUE` trap.
  status_from PipelineStatus?
  status_to   PipelineStatus

  // Provenance.
  changed_by_id String?  @db.Uuid
  changed_at    DateTime @default(now()) @db.Timestamptz
  note          String?

  // Indexes — the dominant "history for pipeline X" lookup.
  @@index([tenant_id, pipeline_id, changed_at])
  @@schema("pipeline")
}

// Lane 2 / L2-C (D-5) — the four LOCKED authority classes for a disposition.
enum PipelineDispositionAuthority {
  RECRUITER
  TALENT
  ENGAGEMENT
  DOWNSTREAM_OUTCOME

  @@schema("pipeline")
}

// Lane 2 / L2-C (D-5) — the immutable, authority-partitioned terminal reason.
// ONE per pipeline_id (UNIQUE — a second write is exact-name translated to
// PIPELINE_ALREADY_DISPOSITIONED, 409). Written inside the terminal-transition
// tx: DISPOSITION → not_in_consideration (RECRUITER/TALENT/ENGAGEMENT), COMPLETE
// → completed (DOWNSTREAM_OUTCOME + source_provenance).
model PipelineDisposition {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  pipeline_id String   @unique @db.Uuid
  pipeline    Pipeline @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)

  authority_class   PipelineDispositionAuthority
  reason            String
  // Owning-aggregate UUID lineage; REQUIRED when authority_class = DOWNSTREAM_OUTCOME.
  source_provenance String?                      @db.Uuid
  note              String?
  created_at        DateTime                     @default(now()) @db.Timestamptz
  created_by_id     String?                      @db.Uuid

  @@index([tenant_id, pipeline_id])
  @@schema("pipeline")
}

// Lane 2 / L2-D (GP-1/EXT-1) — the closed classification of where an episode
// came from. ADD-not-frozen-vendor: origin CLASS is a bounded enum; the specific
// provider/system is the free-form `source_system` string (IntegrationConnection
// discipline). Live provider→origin mapping (EXTERNAL_ATS/VMS/JOB_BOARD/...) is
// provisioned here but wired only by L2-I through the reconcile→command boundary.
enum PipelineEntryOriginType {
  MANUAL_RECRUITER
  ARAMO_SOURCING
  INBOUND_APPLICATION
  INTERNAL_REDISCOVERY
  REFERRAL
  EXTERNAL_ATS
  VMS
  JOB_BOARD
  CAREER_SITE
  TALENT_PORTAL
  IMPORT
  SYSTEM_RECONCILIATION

  @@schema("pipeline")
}

// Lane 2 / L2-D (D-5-analogue on the ENTRY side) — the immutable source-of-hire
// contract, ONE row per episode-entry (`@@unique([pipeline_id])`). Written inside
// create()'s $transaction after tx.pipeline.create, and by the reconcile reversal
// re-create; derived from the SAME validated provenance input that enriches the
// `pipeline.created` event (v1.1 event-enrichment ruling). `PipelineEntryProvenance`
// is the AUTHORITATIVE durable record; `pipeline.created` is an immutable projection
// of it, never a second authority. DB-immutable (UPDATE/DELETE rejected except the
// governed tenant-reset escape), mirroring PipelineDisposition.
model PipelineEntryProvenance {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  pipeline_id String   @unique @db.Uuid
  pipeline    Pipeline @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)

  // Origin CLASS (NOT NULL — the guarantee no episode is born un-classified).
  origin_type PipelineEntryOriginType

  // Normalized lowercase provider/system key (IntegrationConnection.provider_key
  // discipline — extensible, never a frozen vendor enum). NULL for purely-internal.
  source_system        String?
  // Logical UUID reference to integration.IntegrationConnection (Architecture §7.3 —
  // UUID-only, NO FK, NO import; ADR-0029 wall). NULL for non-connector origins.
  source_connection_id String? @db.Uuid

  // External lineage; external_event_id is the dedupe handle a future L2-I reconcile keys on.
  external_object_type String?
  external_object_id   String?
  external_event_id    String?

  // Initiator kind — validated at the WRITE boundary against libs/auth ACTOR_KINDS
  // (system|service_account|user); NOT re-declared as a DB enum (Rule D — libs/auth
  // owns that fact).
  initiated_by_kind String
  // Initiating principal / agent id (AuthContext.sub); NULL only for an
  // unattributable system origin.
  initiated_by_id   String? @db.Uuid

  observed_at DateTime? @db.Timestamptz
  ingested_at DateTime  @default(now()) @db.Timestamptz

  // Bounded, non-secret; NO credentials, NO Talent PII beyond references (GP-1).
  metadata Json? @db.JsonB

  @@index([tenant_id, origin_type])
  @@index([tenant_id, source_connection_id])
  @@index([tenant_id, external_event_id])
  @@schema("pipeline")
}

// OutboxEvent — the pipeline domain's canonical event stream (Lane 2 / L2-B).
// Plain per-module outbox, mirroring libs/submittal (NOT the trigger-bearing
// placement variant): aggregate identity lives inside `event_payload`, there is
// no append-only trigger, and it is NOT swept by tenant-reset (consistent with the
// submittal/consent precedent). Emitted in-tx by create() (`pipeline.created`) and
// transition() (`pipeline.state_transition`); drained by libs/outbox-publisher as
// the 6th namespace, which stamps `published_at`.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenant_id     String    @db.Uuid
  event_type    String
  event_payload Json      @db.JsonB
  created_at    DateTime  @default(now()) @db.Timestamptz
  published_at  DateTime? @db.Timestamptz

  // The drain scans unpublished events oldest-first.
  @@index([published_at, created_at])
  @@schema("pipeline")
}
