{
  "name": "intelligence-contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/intelligence-contracts/src",
  "projectType": "library",
  "tags": [
    "scope:shared"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/intelligence-contracts",
        "main": "libs/intelligence-contracts/src/index.ts",
        "tsConfig": "libs/intelligence-contracts/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/intelligence-contracts/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests --root libs/intelligence-contracts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/intelligence-contracts/tsconfig.lib.json"
      },
      "dependsOn": [
        "^build"
      ]
    }
  }
}
