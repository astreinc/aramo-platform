{
  "name": "sign-cloud-storage",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/sign-cloud-storage/src",
  "projectType": "library",
  "tags": ["scope:sign"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/sign-cloud-storage",
        "main": "libs/sign-cloud-storage/src/index.ts",
        "tsConfig": "libs/sign-cloud-storage/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/sign-cloud-storage/**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --root libs/sign-cloud-storage"
      }
    }
  }
}
