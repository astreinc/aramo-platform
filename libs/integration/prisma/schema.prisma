// Per-module Prisma schema for the `integration` module — T8-CONNECTOR-A
// (provider-neutral connector foundation).
//
// Per Architecture v2.0/v2.1 §7.1 (Schema-per-Module) and
// doc/05-conventions.md "Database Conventions". Cross-schema references are
// UUID-only WITHOUT FK constraints (§7.3).
//
// SCOPE (Aramo-T8-CONNECTOR-A-Directive-v1_0-LOCKED):
//   - provider-neutral connection metadata only (§13/§33) — NO provider enum,
//     NO raw credentials, NO raw provider payload;
//   - AWS Secrets Manager owns credential material; Postgres stores ONLY an
//     opaque, tenant-bound `secret_ref` (§7/§8);
//   - a dedicated transport-delivery idempotency ledger distinguishes an exact
//     transport redelivery (benign ALREADY_PROCESSED) from a changed-content
//     business amendment (unsupported/deferred — §15/§19/§41);
//   - CREATE-only is preserved; this schema NEVER stores or mutates a
//     requisition — the canonical handoff remains the T8-P2 ImportService.
//
// Cross-schema logical references (§7.3 — UUID-only, no FK):
//   - tenant_id                       → identity.Tenant (the connection tenant)
//   - ConnectorDelivery.connection_id → INTRA-SCHEMA FK to IntegrationConnection
//   - ConnectorDelivery.import_batch_id → import.ImportBatch (UUID-only, no FK;
//                                          traceability to the P2 result, §27)

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["integration"]
}

// IntegrationConnectionStatus — the provider-neutral connection lifecycle
// (directive §14; repository-convention lowercase, materially equivalent to the
// directive's DISCONNECTED/CONFIGURED/ACTIVE/DEGRADED/DISABLED). Health is
// OPERATIONAL metadata only — it MUST NOT mutate requisition/import status.
//   - disconnected → no usable credentials/config yet;
//   - configured   → secret_ref/config present, not necessarily proven healthy;
//   - active        → eligible for execution;
//   - degraded      → execution failures requiring attention (retry-exhausted);
//   - disabled      → administratively disabled (history retained).
enum IntegrationConnectionStatus {
  disconnected
  configured
  active
  degraded
  disabled

  @@schema("integration")
}

// ConnectorDeliveryStatus — the disposition of ONE transport delivery through
// the connector (the idempotency ledger, directive §15/§19/§41).
//   - pending     → recorded, handoff in flight;
//   - processed   → canonical handoff succeeded (records → T8-P2); a redelivery
//                    with the SAME delivery_key resolves as benign no-op;
//   - failed       → transient/permanent execution failure (see retry policy);
//   - unsupported  → the delivery targets an EXISTING external identity with
//                    CHANGED business content — a business amendment, which is
//                    UNSUPPORTED/DEFERRED. NON-mutating: no requisition write.
enum ConnectorDeliveryStatus {
  pending
  processed
  failed
  unsupported

  @@schema("integration")
}

// IntegrationConnection — a tenant-scoped, provider-neutral connector
// connection. The CONNECTION is the identity (directive ruling #2): there is
// deliberately NO unique(tenant_id, provider_key) — an enterprise tenant may
// hold multiple accounts/instances of the same VMS. Any provider-account
// uniqueness is deferred to Connector-B under provider-specific authority.
model IntegrationConnection {
  // Identity — the connection id IS the connection identity.
  id        String @id @default(uuid()) @db.Uuid
  tenant_id String @db.Uuid

  // Provider key — a NORMALIZED, EXTENSIBLE lowercase string (directive §4/§33).
  // NEVER a closed VMS enum; no vendor names are frozen here.
  provider_key String

  // Operational lifecycle (health metadata only).
  status IntegrationConnectionStatus @default(disconnected)

  // Opaque, tenant-bound secret reference (directive §7/§8). Postgres stores
  // ONLY this metadata handle — never raw credential material. The value is
  // SERVER-GENERATED/validated and is never an arbitrary client-supplied AWS
  // Secrets Manager path. NULL until credentials are configured.
  secret_ref String?

  // Non-secret connection configuration (directive §6). MUST NOT carry
  // credentials/tokens/secret material. Optional; provider-neutral.
  config Json?

  // Optional provider-neutral account/instance identifier the tenant recognizes
  // (NOT a credential; NOT a uniqueness key in Connector-A).
  provider_account_id String?

  // Bounded, opaque cursor/watermark for future polling transports (directive
  // §16). NO credentials. Advanced only after successful processing.
  cursor String?

  // Operational execution state (directive §26). Bounded, non-secret.
  last_attempted_at  DateTime? @db.Timestamptz
  last_successful_at DateTime? @db.Timestamptz
  last_error_code    String?
  last_error_summary String?

  // Optimistic-concurrency guard for lifecycle transitions.
  version Int @default(0)

  // Timeline (repository UTC/TIMESTAMPTZ convention).
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  // Intra-schema relation to the delivery idempotency ledger.
  deliveries ConnectorDelivery[]

  // L1-D1 (ADR-0030) — intra-schema relations to the external-lifecycle-authority
  // substrate (per-connection governed mapping contract, reconciliation queue,
  // structured external-transition provenance).
  lifecycle_mappings    RequisitionLifecycleMapping[]
  reconciliations       RequisitionExternalReconciliation[]
  transition_provenance RequisitionExternalTransitionProvenance[]

  // CB-D2-A1 (ADR-0030) — intra-schema relations to the provider-neutral
  // lifecycle-ingress substrate: the observation/event idempotency ledger and
  // the connection-scoped external-requisition identity mapping.
  lifecycle_observations LifecycleObservationLedger[]
  external_identities    ExternalRequisitionIdentity[]

  // Indexes — every query path leads with tenant_id. NO unique(tenant_id,
  // provider_key) (ruling #2): connection.id is the identity.
  @@index([tenant_id])
  @@index([tenant_id, provider_key])
  @@index([tenant_id, status])

  @@schema("integration")
}

// RequisitionLifecycleAuthorityMode — L1-D1 (ADR-0030 §4). The per-connection
// authority posture (repository-convention lowercase; equivalent to the ADR's
// EXTERNAL_AUTHORITY / DUAL_CONTROL):
//   - external_authority → a mapped external lifecycle event INVOKES the
//     governed Requisition command (Astre DEFAULT);
//   - dual_control       → a mapped external event RECORDS intent / a pending
//     reconciliation row; it does NOT auto-complete the governed transition.
enum RequisitionLifecycleAuthorityMode {
  external_authority
  dual_control

  @@schema("integration")
}

// RequisitionLifecycleMapping — L1-D1 (ADR-0030 seam #3). The per-CONNECTION
// governed mapping contract: it translates a provider lifecycle STATE token into
// a mapped Aramo lifecycle ACTION (never a target status), carrying the mapping
// version + the per-connection authority mode. Keyed on connection_id (the
// connection IS the account identity — IntegrationConnection has no
// unique(tenant, provider) by design). This does NOT overload
// IntegrationConnection.status (operational-only) — the authority mode lives here.
model RequisitionLifecycleMapping {
  id            String @id @default(uuid()) @db.Uuid
  tenant_id     String @db.Uuid
  connection_id String @db.Uuid

  // The provider lifecycle state token (raw / normalized), opaque to Aramo —
  // supplied by the connection's mapping author. NEVER a credential.
  provider_state String

  // The mapped Aramo lifecycle ACTION token (@aramo/requisition TransitionAction:
  // CLOSE | REOPEN | PUT_ON_HOLD | CANCEL). Stored as a bounded String, NOT an
  // enum — the action vocabulary is owned by the requisition domain, and a
  // cross-schema enum would couple the two schemas.
  mapped_action String

  // The version of the mapping contract this row belongs to (bumped when a
  // connection's mapping is re-authored; carried into provenance for audit).
  mapping_version Int @default(1)

  // The per-connection authority posture (external_authority default).
  authority_mode RequisitionLifecycleAuthorityMode @default(external_authority)

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  connection IntegrationConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  // One mapped action per (connection, provider_state) — a connection maps each
  // provider state exactly once.
  @@unique([tenant_id, connection_id, provider_state])
  @@index([tenant_id, connection_id])

  @@schema("integration")
}

// RequisitionExternalReconciliation — L1-D1 (ADR-0030 seam #4). A record-then-
// resolve queue (mirrors talent_record.TalentRecordReconcileContradiction).
// D1 WRITES pending rows — dual_control intent + governed refusals (unmappable /
// illegal-from-state / policy DENY / CAS conflict / not-found). The WORKER that
// drains and executes them is D2. Idempotent on the external event id.
model RequisitionExternalReconciliation {
  id            String @id @default(uuid()) @db.Uuid
  tenant_id     String @db.Uuid
  connection_id String @db.Uuid

  // The external event's identity + payload facts (opaque provider tokens).
  external_event_id String
  external_req_id   String?
  provider_key      String

  raw_provider_status String
  normalized_status   String?

  // The mapped action, when a mapping existed (null for an unmappable state).
  mapped_action String?

  // The Aramo requisition's status at the moment of the refusal/intent (null
  // only when the requisition was not found).
  current_aramo_status String?

  // The bounded reason token (UNMAPPABLE_PROVIDER_STATE | DUAL_CONTROL_PENDING |
  // ILLEGAL_FROM_STATE | POLICY_DENIED | CAS_CONFLICT | REQUISITION_NOT_FOUND).
  failure_reason String

  // Record-then-resolve lifecycle. D1 only ever writes 'pending'; the D2 worker
  // transitions to 'resolved'.
  status String @default("pending")

  created_at  DateTime  @default(now()) @db.Timestamptz
  resolved_at DateTime? @db.Timestamptz

  connection IntegrationConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  // Idempotent — a redelivered external event resolves to the same pending row.
  @@unique([tenant_id, connection_id, external_event_id])
  @@index([tenant_id, status])

  @@schema("integration")
}

// RequisitionExternalTransitionProvenance — L1-D1 (ADR-0030 seam #5). Structured
// provenance linking a GOVERNED external transition to the external event that
// caused it. Written only on EXECUTED transitions. Immutable (append-only, no
// status column) — distinct from the mutable reconciliation queue, so it is NOT
// combined with it. The lifecycle_event_id + policy_decision_id are cross-schema
// UUID references (Architecture §7.3 — UUID-only, NO FK), mirroring the
// RequisitionLifecycleEvent.policy_decision_id precedent.
model RequisitionExternalTransitionProvenance {
  id            String @id @default(uuid()) @db.Uuid
  tenant_id     String @db.Uuid
  connection_id String @db.Uuid

  external_event_id String
  external_event_at DateTime @db.Timestamptz

  raw_provider_status String
  normalized_status   String

  mapping_version Int
  mapped_action   String

  // Cross-schema UUID ref to requisition.RequisitionLifecycleEvent.id (no FK).
  lifecycle_event_id String @db.Uuid
  // Cross-schema UUID ref to policy_store.PolicyDecisionRecord.id (no FK).
  policy_decision_id String? @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz

  connection IntegrationConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  // One provenance record per external event (idempotent under redelivery).
  @@unique([tenant_id, connection_id, external_event_id])
  @@index([tenant_id, lifecycle_event_id])

  @@schema("integration")
}

// ConnectorDelivery — the transport-delivery idempotency ledger (directive
// §15, Architect ruling). ONE row per distinct transport delivery. The
// load-bearing distinction:
//   - same delivery_key already `processed`  → benign ALREADY_PROCESSED;
//     ImportService is NOT invoked again → NO second ImportBatch;
//   - same external requisition identity with DIFFERENT business content →
//     a DIFFERENT delivery_key → a new row → handed to T8-P2 → existing-identity
//     conflict → classified `unsupported` (business amendment, deferred). No
//     requisition mutation, ever.
model ConnectorDelivery {
  // Identity.
  id            String @id @default(uuid()) @db.Uuid
  tenant_id     String @db.Uuid
  connection_id String @db.Uuid

  // The provider-neutral idempotency key for a transport delivery (directive
  // §15): a provider delivery id / normalized message id / deterministic
  // payload fingerprint. Opaque to this layer; supplied/derived by the
  // adapter+orchestrator, NEVER a credential.
  delivery_key String

  status ConnectorDeliveryStatus @default(pending)

  // Traceability to the canonical P2 result (directive §27) — UUID-only ref to
  // import.ImportBatch, no cross-schema FK. NULL until a batch is produced.
  import_batch_id String? @db.Uuid

  // Bounded, non-secret failure/classification detail (e.g. the
  // unsupported-existing-requisition-update token). NEVER a provider payload.
  detail_code String?

  created_at   DateTime  @default(now()) @db.Timestamptz
  processed_at DateTime? @db.Timestamptz

  // Intra-schema FK to the owning connection. ON DELETE CASCADE is a safety net
  // only; connections are DISABLED not deleted (directive §42), so history is
  // retained in practice.
  connection IntegrationConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  // Deterministic idempotency uniqueness (Architect ruling): a transport
  // redelivery collides here and resolves to ALREADY_PROCESSED.
  @@unique([tenant_id, connection_id, delivery_key])
  @@index([tenant_id, connection_id, status])
  @@index([tenant_id, import_batch_id])

  @@schema("integration")
}

// LifecycleObservationLedger — CB-D2-A1 (ADR-0030) — the provider-NEUTRAL
// lifecycle-ingress idempotency + ordering ledger. Distinct from ConnectorDelivery
// (which is import-bound — markProcessed requires import_batch_id): a lifecycle
// observation/event NEVER produces an ImportBatch, it drives a governed
// Requisition COMMAND through the L1-D1 seam. ONE row per durable observation
// identity (A0-R5):
//   - observation (Fieldglass-pull): observation_key derived per (delivery,
//     external_req_id); provider_event_at/provider_sequence NULL; confidence
//     'unknown'; observed_at is the Aramo observation time (NEVER a provider
//     event timestamp);
//   - event (Workday-if-gated-in): observation_key = the provider external_event_id;
//     provider_event_at + optional provider_sequence set; confidence
//     'strong'/'bounded'/'weak'.
// Idempotency: the UNIQUE (tenant_id, connection_id, observation_key) makes the
// row the authority — reprocessing the SAME stored observation returns ONE
// outcome; a NEW delivery re-observing the same requisition at the same status
// gets a NEW observation_key and is NOT permanently collapsed. R-ORDER staleness
// is evaluated over the prior PROCESSED rows for (tenant, connection,
// external_req_id) — provider ordering is ⊥ Requisition.version (CAS separation),
// so provider_sequence is NEVER mapped onto expected_version.
model LifecycleObservationLedger {
  id            String @id @default(uuid()) @db.Uuid
  tenant_id     String @db.Uuid
  connection_id String @db.Uuid

  // The external requisition identifier (opaque provider token) this observation
  // is about — the ordering grain (tenant, connection, external_req_id).
  external_req_id String

  // The durable per-observation idempotency identity (A0-R5). NEVER a credential.
  observation_key String

  // The RAW provider lifecycle state token (normalized downstream). NEVER a
  // provider payload beyond the state token.
  raw_provider_status String
  normalized_status   String?

  // R-ORDER (A0-R4) — the ordering-confidence class of THIS observation/event.
  // Bounded lowercase token (strong | bounded | weak | unknown); stored TEXT (not
  // an enum) to stay provider-neutral and match the repository-convention.
  ordering_confidence String

  // Provider monotonic sequence, only where a provider proves one (STRONG/BOUNDED).
  // NULL for a state observation (UNKNOWN). NEVER fabricated from Aramo time.
  provider_sequence BigInt?

  // The provider's event timestamp — set ONLY for an event; NULL for a state
  // observation (an observation has no provider event timestamp — A0-R5).
  provider_event_at DateTime? @db.Timestamptz

  // The Aramo observation time (when the ingress captured the state). This is
  // NEVER labelled a provider event timestamp.
  observed_at DateTime @db.Timestamptz

  // Record-then-process disposition: pending → processed (governed command ran,
  // whatever its outcome) | reconciled (routed to the reconciliation queue) |
  // duplicate (a same-key redelivery observed no-op). Bounded TEXT.
  status String @default("pending")

  // The governed-command outcome token, for audit (EXECUTED | RECONCILED:<reason>).
  outcome String?

  // Bounded, non-secret classification detail. NEVER a provider payload.
  detail_code String?

  created_at   DateTime  @default(now()) @db.Timestamptz
  processed_at DateTime? @db.Timestamptz

  connection IntegrationConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  // Idempotency authority: a redelivered observation collides here.
  @@unique([tenant_id, connection_id, observation_key])
  // R-ORDER staleness query grain.
  @@index([tenant_id, connection_id, external_req_id])
  @@index([tenant_id, status])

  @@schema("integration")
}

// ExternalRequisitionIdentity — CB-D2-A1 (ADR-0030, R-IDENTITY LOCK) — the
// integration-owned, CONNECTION-SCOPED external→internal requisition mapping.
// Lifecycle ingress resolves an external requisition by (tenant_id, connection_id,
// external_req_id) → requisition_id — NEVER by connection.provider_key →
// Requisition.source_system (separate vocabularies; multiple connections per
// provider per tenant are supported). The row is ESTABLISHED when a connector
// import successfully establishes the Requisition (T8-P2), not guessed on first
// event. The T8-P1 (tenant, source_system, external_req_id) Requisition unique is
// PRESERVED untouched as Requisition provenance/history — this table is a SEPARATE
// runtime resolution index. requisition_id is a CROSS-SCHEMA reference
// (integration → requisition), UUID-only, NO FK (the policy_decision_id precedent).
model ExternalRequisitionIdentity {
  id            String @id @default(uuid()) @db.Uuid
  tenant_id     String @db.Uuid
  connection_id String @db.Uuid

  // The external requisition identifier (opaque provider token, case-preserved).
  external_req_id String

  // Cross-schema UUID ref to requisition.Requisition.id (no FK — Architecture 7.3).
  requisition_id String @db.Uuid

  // The connection's normalized provider key (denormalized for audit/read).
  provider_key String

  created_at DateTime @default(now()) @db.Timestamptz

  connection IntegrationConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  // One identity per (connection, external_req_id) — connection-scoped resolution.
  @@unique([tenant_id, connection_id, external_req_id])
  // One identity per (connection, requisition) — cardinality confirmed: a
  // requisition is established by exactly one connector import (one connection),
  // and the T8-P1 partial-unique makes (source_system, external_req_id) → one
  // requisition, so (connection, external_req_id) → one requisition holds.
  @@unique([tenant_id, connection_id, requisition_id])
  @@index([tenant_id, requisition_id])

  @@schema("integration")
}
