// Per-module Prisma schema for the `policy-store` library — ADR-0024 PR-2
// (§D7 "storage is a separate library", §D17b "Policy versioning").
//
// Per Architecture v2.1 §7 (Schema-per-Module data architecture) and
// doc/05-conventions.md "Database Conventions". Cross-schema references
// elsewhere in the program are UUID-only without FK constraints (§7.3);
// this library holds no cross-schema references at all — a stored policy
// version is self-contained (its definition is an opaque, checksummed
// PolicyPackage blob).
//
// SCOPE (PR-2 directive): storage · versioning · publication · tenant
// retrieval · caching. It never evaluates a policy, NO decision model, NO domain
// nouns. The single entity is the versioned policy definition record whose
// column set is D17b verbatim: definition · version · effective_from ·
// effective_to · published_by · checksum.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["policy_store"]
}

// StoredPolicyVersion — one immutable, published version of one policy
// package for one tenant. D17b field set:
//
//   definition      → the serialized PolicyPackage (opaque to this lib;
//                     typed as @aramo/policy-engine PolicyPackage at the
//                     TypeScript boundary, persisted as JSONB)
//   version         → the package's declared version string
//   effective_from  → inclusive lower bound of the activity window
//   effective_to    → exclusive upper bound; NULL = currently open/active
//   published_by    → actor UUID that published this version
//   checksum        → SHA-256 hex over the canonical serialization of the
//                     definition; integrity guard against a tampered row
//
// Immutability is enforced by contract (the store never UPDATEs an existing
// row's definition/checksum) and by the (tenant_id, package_name, version)
// uniqueness below: a re-publication must carry a new version string, which
// inserts a new row rather than mutating an existing one. Non-overlapping
// windows per (tenant_id, package_name) are maintained by the publish path,
// which closes the prior open version's effective_to to the new
// effective_from — so at most one version is active at any instant.
model StoredPolicyVersion {
  // Surrogate id, UUID generated app-side (uuid.v7()); Postgres 17 has no
  // native uuidv7() function (the job-domain PR-2 precedent).
  id String @id @db.Uuid

  // Tenant that owns this policy version. Tenant isolation is a query
  // predicate: every retrieval is keyed by tenant_id first. UUID-only
  // reference to identity.Tenant, no FK (§7.3).
  tenant_id String @db.Uuid

  // The policy package identifier (PolicyPackage.name). Domain-neutral —
  // policy-store never interprets it.
  package_name String

  // The package's declared version string (PolicyPackage.version).
  version String

  // The serialized PolicyPackage. Opaque JSONB; this library never
  // evaluates it.
  definition Json

  // SHA-256 hex of the canonical serialization of `definition`.
  checksum String

  // Activity window. from inclusive, to exclusive; NULL to = open/active.
  effective_from DateTime  @db.Timestamptz(6)
  effective_to   DateTime? @db.Timestamptz(6)

  // Publication provenance.
  published_by String   @db.Uuid
  published_at DateTime @default(now()) @db.Timestamptz(6)

  // A version string is unique per (tenant, package): the immutability +
  // "republish creates a new version" contract.
  @@unique([tenant_id, package_name, version])
  // Tenant-scoped, package-scoped, time-ordered retrieval.
  @@index([tenant_id, package_name, effective_from])
  @@schema("policy_store")
}

// PolicyDecisionRecord — decision provenance (ADR-0024 §D17a). One APPEND-ONLY
// row per policy resolution, for EVERY outcome (ALLOW · DENY ·
// REQUIRES_OVERRIDE · ALLOW_WITH_AUDIT) — a denial is the most important thing
// to keep explainable months later. There is NO update path and NO delete
// path: a decision record is history.
//
// `policy_version` + `rule_id` are REQUIRED (never nullable) — a record that
// cannot be traced to the rule that produced it is not provenance. For a
// no-match resolved by the package's default_disposition, `rule_id` carries
// the engine's `__default__` provenance marker (emitted by the evaluator).
//
// `inputs` is a JSONB snapshot of the PolicyContext AS EVALUATED, and is
// PII-FREE by construction: resource/action identifiers, declared/derived
// state and resolved capability booleans only (see decision-inputs.ts). No
// domain nouns — the identifiers are opaque strings this library never reads.
model PolicyDecisionRecord {
  // Surrogate id, UUID v7 generated app-side.
  id String @id @db.Uuid

  // Tenant that owns this decision. Every retrieval is keyed by tenant_id.
  tenant_id String @db.Uuid

  // The verdict (§D9 vocabulary: ALLOW | DENY | REQUIRES_OVERRIDE |
  // ALLOW_WITH_AUDIT). Stored as text — the engine owns the enum.
  decision String

  // The policy version that evaluated it, and the id of the rule that
  // produced the verdict (or `__default__` for a default-disposition
  // no-match). Both REQUIRED.
  policy_version String
  rule_id        String

  // The reason code the verdict carried.
  reason_code String

  // The registered resource/action identifiers the decision governed
  // (opaque; §D5).
  resource String
  action   String

  // PII-free snapshot of the evaluated context (see decision-inputs.ts).
  inputs Json

  // Who, from where, when, and which command this record belongs to.
  actor_id       String
  origin         String // ui | agent | integration (§D8)
  correlation_id String
  occurred_at    DateTime @default(now()) @db.Timestamptz(6)

  // Group one command's records; tenant-scoped time-ordered reads.
  @@index([tenant_id, correlation_id])
  @@index([tenant_id, occurred_at])
  @@schema("policy_store")
}
