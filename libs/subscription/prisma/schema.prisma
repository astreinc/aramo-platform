// Per-module Prisma schema for the `subscription` module.
//
// Aramo-E-Sign-Multi-Provider-Plan-Entitlements-Usage-Directive-v1_0-LOCKED §B/§C
// — the commercial allowance authority, kept SEPARATE from the signing engine
// (envelope lifecycle) and from provider routing:
//
//   Plan + PlanAllowance  the plan catalog; allowances are configurable rows
//                         (the Aramo Sign 100/month is DATA, never a constant).
//   TenantSubscription    which plan a tenant is on, its billing-period anchor and
//                         (Aramo Sign launch) its lifecycle status + the billing-
//                         provider linkage. Stripe is authoritative for payment
//                         events; Aramo for the effective entitlement.
//   CheckoutIntent        who started a checkout (governed owner activation).
//   BillingEvent          provider events, processed at most once.
//   AllowanceUsage        one row per metered send, keyed by a stable send
//                         identity, with a reserve → consume | release protocol.
//
// Cross-schema references are UUID-only without FK constraints (§7.3).

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["subscription"]
}

model Plan {
  id            String               @id @db.Uuid
  // Stable catalog key (e.g. "aramo-sign-included-v1"); never a display name.
  key           String               @unique
  name          String
  // Offered for self-service purchase (only an ACTIVE SELF_SERVICE plan).
  sellable      Boolean              @default(false)
  description   String?
  created_at    DateTime             @default(now()) @db.Timestamptz(6)
  // Commercial Plans Amendment A1 — the catalog descriptor.
  // CHECK: BUSINESS | PERSONAL (null = any kind, e.g. the operator plan).
  tenant_kind                   String?
  // CHECK: SELF_SERVICE | FREE | CONTACT_SALES | OPERATOR
  sales_model                   String  @default("OPERATOR")
  // CHECK: ACTIVE | INACTIVE (an INACTIVE plan is catalogued, never assigned).
  status                        String  @default("ACTIVE")
  // Display price in minor units; the charge itself is the provider price.
  list_price_minor              Int?
  currency                      String?
  // Stored comparison price; shown only when substantiated.
  reference_price_minor         Int?
  reference_price_substantiated Boolean @default(false)
  // CHECK: MONTH (the invoice interval).
  billing_interval              String?
  // Commitment term, separate from the invoice interval (12 = annual).
  commitment_months             Int?
  // CHECK: ATS_SUBSCRIPTION — the plan requires a qualifying ATS entitlement.
  eligibility                   String?
  // CHECK: BASIC | CONTRACTED
  support_tier                  String?
  // Why an INACTIVE / contracted plan is not usable yet.
  activation_note               String?
  display_order                 Int     @default(100)
  // CCP-A4 (MP-A2 N-6) — the product this plan is sold for. Closed registry, enforced by
  // CHECK in migration 20261025140000 (v1: 'sign' only; code mirror PRODUCT_KEYS). NO default.
  product_key                   String
  allowances    PlanAllowance[]
  // Personal Free v1.1 — short-window caps (e.g. 2 envelopes per day).
  allowance_windows PlanAllowanceWindow[]
  capacities    PlanCapacity[]
  features      PlanFeature[]
  subscriptions TenantSubscription[]
  checkouts     CheckoutIntent[]
  // CCP-A5 (MP-A2 N-15) — the plan's versioned commercial content.
  versions      PlanVersion[]

  // CCP-A4 (MP-A2 N-7) — the target of the composite FK TenantSubscription(plan_id, product_key).
  @@unique([id, product_key])
  @@schema("subscription")
}

// CCP-A5 (PBD §5.1 row A5; MP-A2 N-15…N-19; Charter D3) — a plan's commercial content,
// versioned. DRAFT → PUBLISHED → RETIRED (no default; every write names it). Content is the
// format-1 projection of the live Plan + child rows (src/lib/plan-version.ts); the checksum is
// SHA-256 of its canonical JSON and is recomputed by a DB CHECK. Immutable once PUBLISHED and no
// DELETE (trigger, migration 20261025160000). At most one PUBLISHED version per plan (the
// plan's current version). Publishing and retiring are applied by CCP-A6 from approved
// PLAN_VERSION_PUBLISH / PLAN_RETIRE change requests; A5 ships repository methods only.
model PlanVersion {
  id               String               @id @db.Uuid
  plan_id          String               @db.Uuid
  version_number   Int
  status           String
  content          Json
  content_checksum String
  note             String?
  created_by       String
  created_at       DateTime             @db.Timestamptz(3)
  published_at     DateTime?            @db.Timestamptz(3)
  retired_at       DateTime?            @db.Timestamptz(3)
  plan             Plan                 @relation(fields: [plan_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  prices           PlanVersionPrice[]
  subscriptions    TenantSubscription[]

  @@unique([plan_id, version_number])
  // The composite FK target of TenantSubscription(plan_version_id, plan_id).
  @@unique([id, plan_id])
  @@schema("subscription")
}

// CCP-A5 (MP-A2 N-17, D3) — the provider price pinned to a plan version (it replaces
// STRIPE_PLAN_PRICES as the authority; the env is a cutover fallback with a parity check).
// Immutable from INSERT; one pin per (version, provider); a provider price belongs to one version.
model PlanVersionPrice {
  id                 String      @id @db.Uuid
  plan_version_id    String      @db.Uuid
  // CHECK: STRIPE
  provider           String
  provider_price_ref String
  created_by         String
  created_at         DateTime    @db.Timestamptz(3)
  plan_version       PlanVersion @relation(fields: [plan_version_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([plan_version_id, provider])
  @@unique([provider, provider_price_ref])
  @@schema("subscription")
}

// CCP-A5 (MP-A2 N-17) — append-only history of TenantSubscription.plan_version_id changes.
// Written by the DB trigger on the re-pin itself (the re-pinning transaction names its reason),
// never inserted by application code. Never read to decide a limit.
model SubscriptionVersionPinEvent {
  id                   String   @id @db.Uuid
  subscription_id      String   @db.Uuid
  tenant_id            String   @db.Uuid
  product_key          String
  from_plan_id         String   @db.Uuid
  from_plan_version_id String   @db.Uuid
  to_plan_id           String   @db.Uuid
  to_plan_version_id   String   @db.Uuid
  // CHECK: PROVIDER_PLAN_CHANGE | CHANGE_REQUEST (CCP-A6: an applied SUBSCRIPTION_CHANGE)
  reason               String
  provider_price_ref   String?
  recorded_at          DateTime @db.Timestamptz(3)

  @@index([subscription_id, recorded_at])
  @@schema("subscription")
}

model PlanAllowance {
  plan_id           String @db.Uuid
  // Metered feature, e.g. "sign.envelopes".
  allowance_key     String
  // Included quantity per period (null when unlimited). No rollover.
  included_quantity Int?
  // A1 — explicit unlimited (never a sentinel number); usage is still metered.
  unlimited         Boolean @default(false)
  // CHECK: MONTHLY (the only period V1 supports).
  period            String @default("MONTHLY")
  plan              Plan   @relation(fields: [plan_id], references: [id])

  @@id([plan_id, allowance_key])
  @@schema("subscription")
}

// Aramo-Sign-Personal-Free-Launch-Directive-v1_1-LOCKED §4 — a plan's short-window
// cap on a metered allowance, beside the monthly PlanAllowance (e.g. Free Personal:
// at most 2 envelopes in any 24 hours). Counted from the AllowanceUsage ledger, so
// one envelope counts once. CHECK window_kind: DAY. No row = no window cap.
model PlanAllowanceWindow {
  plan_id        String @db.Uuid
  allowance_key  String
  window_kind    String
  limit_quantity Int
  plan           Plan   @relation(fields: [plan_id], references: [id])

  @@id([plan_id, allowance_key, window_kind])
  @@schema("subscription")
}

model TenantSubscription {
  id            String    @id @db.Uuid
  tenant_id     String    @db.Uuid
  plan_id       String    @db.Uuid
  // Billing periods start at this instant and every calendar month after it
  // (day clamped to the month's length).
  period_anchor DateTime  @db.Timestamptz(6)
  // CHECK: MANUAL | DEVELOPMENT | SELF_SERVICE | FREE. DEVELOPMENT rows come only
  // from the governed local/test seed, which refuses to run in production. FREE
  // (Personal Free v1.1) is system-opened for an active PERSONAL tenant, never
  // provider-billed (CHECK: no billing linkage).
  source        String
  started_at    DateTime  @default(now()) @db.Timestamptz(6)
  ended_at      DateTime? @db.Timestamptz(6)
  created_by    String
  // Aramo Sign launch — CHECK: TRIALING | ACTIVE | PAST_DUE | CANCELED | INCOMPLETE.
  status                   String    @default("ACTIVE")
  // CHECK: STRIPE (null for MANUAL / DEVELOPMENT).
  billing_provider         String?
  billing_account_ref     String?
  billing_subscription_ref String?
  current_period_end       DateTime? @db.Timestamptz(6)
  cancel_at_period_end     Boolean   @default(false)
  // PAST_DUE keeps sending until this instant (grace), then stops.
  grace_until              DateTime? @db.Timestamptz(6)
  // Provider event time of the last applied state (out-of-order protection).
  provider_state_at        DateTime? @db.Timestamptz(6)
  // The subscribing owner (user id) when self-service.
  activated_by             String?
  // A1 — the commitment term (e.g. 12 months), separate from the monthly
  // invoice period; a cancellation requested inside it is flagged, never
  // silently treated as month-to-month.
  commitment_start                   DateTime? @db.Timestamptz(6)
  commitment_end                     DateTime? @db.Timestamptz(6)
  cancel_requested_within_commitment Boolean   @default(false)
  // CHECK: OK | LAPSED — the plan's eligibility (e.g. ATS) at the last check.
  eligibility_state                  String?
  eligibility_checked_at             DateTime? @db.Timestamptz(6)
  // CCP-A4 (MP-A2 N-7) — equals the plan's product_key: composite FK (plan_id, product_key)
  // → Plan(id, product_key), SQL-only in migration 20261025140000. NO default.
  product_key                        String
  // CCP-A4 (MP-A2 N-10, shape (a)) — the commercial composition of this row. v1 CHECK: BASE
  // only. A later add-on or usage package is a row with another role (an additive CHECK
  // widening), never a re-keyed product_key or a second subscription authority. NO default.
  composition_role                   String
  // CCP-A5 (MP-A2 N-18) — the plan version this subscription was sold or applied on
  // (grandfathering). Composite FK (plan_version_id, plan_id) → PlanVersion(id, plan_id), SQL-only
  // in migration 20261025160000. A new or changed pin must be PUBLISHED; a change is recorded in
  // SubscriptionVersionPinEvent by trigger. NO default.
  plan_version_id                    String    @db.Uuid
  plan          Plan      @relation(fields: [plan_id], references: [id])
  plan_version  PlanVersion @relation(fields: [plan_version_id], references: [id])

  // CCP-A4 (MP-A2 N-9) — at most one open BASE subscription per (tenant_id, product_key):
  // partial unique index TenantSubscription_one_open_base_per_tenant_product in SQL.
  @@index([tenant_id])
  @@index([plan_version_id])
  @@schema("subscription")
}

model AllowanceUsage {
  id             String    @id @db.Uuid
  tenant_id      String    @db.Uuid
  allowance_key  String
  // Stable send identity, e.g. "aramo-sign:envelope:<envelope_id>".
  send_key       String
  // The billing period the send is charged to (fixed at reservation).
  period_start   DateTime  @db.Timestamptz(6)
  // CHECK: RESERVED | CONSUMED | RELEASED
  state          String
  // CHECK: SEND | HISTORICAL (backfilled from an existing sent record)
  origin         String    @default("SEND")
  reserved_at    DateTime  @default(now()) @db.Timestamptz(6)
  // A RESERVED row older than this is resolved by reconciliation before counting.
  reserved_until DateTime  @db.Timestamptz(6)
  finalized_at   DateTime? @db.Timestamptz(6)

  @@unique([tenant_id, allowance_key, send_key])
  @@index([tenant_id, allowance_key, period_start])
  @@index([tenant_id, allowance_key, reserved_at])
  @@schema("subscription")
}

model CheckoutIntent {
  id                   String    @id @db.Uuid
  tenant_id            String    @db.Uuid
  user_id              String
  plan_id              String    @db.Uuid
  // CHECK: STRIPE
  provider             String
  provider_session_ref String?
  // CHECK: CREATED | COMPLETED | EXPIRED
  status               String    @default("CREATED")
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  completed_at         DateTime? @db.Timestamptz(6)
  // A1 — the terms version (and text sha256) accepted at checkout, if any.
  terms_version        String?
  terms_sha256         String?
  plan                 Plan      @relation(fields: [plan_id], references: [id])

  @@index([tenant_id])
  @@schema("subscription")
}

model BillingEvent {
  id                String   @id @db.Uuid
  provider          String
  provider_event_id String
  event_type        String
  event_created_at  DateTime @db.Timestamptz(6)
  tenant_id         String?  @db.Uuid
  // CHECK: APPLIED | IGNORED | STALE
  outcome           String
  detail            String?
  received_at       DateTime @default(now()) @db.Timestamptz(6)

  @@unique([provider, provider_event_id])
  @@index([tenant_id])
  @@schema("subscription")
}

// Sign Signup Amendment A1 §2.6 — the provider billing account Aramo created from
// the organization profile (one per tenant). CHECK provider: STRIPE.
model TenantBillingAccount {
  tenant_id   String   @id @db.Uuid
  provider    String
  account_ref String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([provider, account_ref])
  @@schema("subscription")
}

// Sign Signup Amendment A1 §2.6 — activation guard: a subscription whose provider
// billing country is not US is held here for reconciliation. One OPEN flag per
// (provider, subscription_ref, reason) — a partial unique index in the migration.
// CHECK reason: billing_country_not_supported | domain_not_authoritative (P3) |
// governed_subscription_open (CCP-A6, Conversion Rule C-7: a self-service activation that
// would end an open governed MANUAL subscription is held).
model BillingReconciliationFlag {
  id               String    @id @db.Uuid
  tenant_id        String    @db.Uuid
  provider         String
  subscription_ref String
  intent_id        String?   @db.Uuid
  reason           String
  account_country  String?
  detected_at      DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at      DateTime? @db.Timestamptz(6)

  @@index([tenant_id])
  @@schema("subscription")
}

// A1 — non-periodic plan limits (storage bytes, template count).
model PlanCapacity {
  plan_id        String  @db.Uuid
  capacity_key   String
  limit_quantity BigInt?
  unlimited      Boolean @default(false)
  plan           Plan    @relation(fields: [plan_id], references: [id])

  @@id([plan_id, capacity_key])
  @@schema("subscription")
}

// A1 — plan features; a missing row means not included.
model PlanFeature {
  plan_id     String  @db.Uuid
  feature_key String
  enabled     Boolean
  plan        Plan    @relation(fields: [plan_id], references: [id])

  @@id([plan_id, feature_key])
  @@schema("subscription")
}

// A1 — per-tenant capacity ledger (storage): one row per stored object.
model CapacityUsage {
  id           String    @id @db.Uuid
  tenant_id    String    @db.Uuid
  capacity_key String
  ref          String
  quantity     BigInt
  // CHECK: ACTIVE | RELEASED
  state        String    @default("ACTIVE")
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  released_at  DateTime? @db.Timestamptz(6)

  @@unique([tenant_id, capacity_key, ref])
  @@index([tenant_id, capacity_key, state])
  @@schema("subscription")
}

// A1 — legal acceptance evidence (document key + version + text sha256).
model LegalAcceptance {
  id            String   @id @db.Uuid
  tenant_id     String?  @db.Uuid
  user_id       String?
  subject_email String?
  document_key  String
  version       String
  sha256        String
  // CHECK: SIGNUP | CHECKOUT | IN_APP (Personal re-acceptance in the Sign workspace)
  context       String
  context_ref   String?
  accepted_at   DateTime @default(now()) @db.Timestamptz(6)
  origin        LegalAcceptanceOrigin?

  @@index([tenant_id])
  @@index([tenant_id, user_id, document_key])
  @@schema("subscription")
}

// Aramo Sign Personal (Free) — where an IN_APP acceptance came from (IP, user agent).
model LegalAcceptanceOrigin {
  acceptance_id String          @id @db.Uuid
  ip            String?
  user_agent    String?
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  acceptance    LegalAcceptance @relation(fields: [acceptance_id], references: [id], onDelete: Restrict)

  @@schema("subscription")
}

// -------------------------------------------------------------------------
// CCP-A2 (Aramo-CCP-Program-Build-Directive-v1_0-LOCKED §5.1 row A2; Charter §7, D10)
// — the versioned commercial policy. A clone of the MatchingPolicyVersion pattern
// (never an import of it, and never the ADR-0024 policy store). Platform-global: no
// tenant_id. DRAFT | ACTIVE | RETIRED; at most one ACTIVE (partial unique index); content
// immutable at the DB once the row leaves DRAFT; DELETE rejected (trigger). v1 ACTIVE is
// seeded by migration 20261024180000 with the Charter §7 (D5) values as DATA. The
// content shape and the fail-closed parser live in src/lib/commercial/commercial-policy.ts.
// -------------------------------------------------------------------------
model CommercialPolicyVersion {
  id               String                 @id @db.Uuid
  // 1, 2, 3 … — assigned under a transaction-scoped advisory lock. UNIQUE.
  version_number   Int                    @unique
  // DRAFT | ACTIVE | RETIRED. CHECK + one-ACTIVE partial unique index in migration.
  status           String                 @default("DRAFT")
  content          Json
  // SHA-256 (hex) of the canonical JSON of content (commercialPolicyChecksum).
  content_checksum String
  note             String?
  created_by       String?                @db.Uuid
  created_at       DateTime               @default(now()) @db.Timestamptz
  activated_by     String?                @db.Uuid
  activated_at     DateTime?              @db.Timestamptz
  retired_at       DateTime?              @db.Timestamptz
  audit_events     CommercialAuditEvent[]
  change_requests  CommercialChangeRequest[]

  @@index([status])
  @@schema("subscription")
}

// CCP-A2 — append-only policy-lifecycle stream (UPDATE and DELETE rejected at the DB).
model CommercialPolicyAuditEvent {
  id            String   @id @db.Uuid
  actor_id      String?  @db.Uuid
  // user | system. CHECK.
  actor_type    String
  // COMMERCIAL_POLICY_VERSION_CREATED | _ACTIVATED | _RETIRED. CHECK.
  event_type    String
  // The CommercialPolicyVersion id the event is about.
  subject_id    String   @db.Uuid
  event_payload Json
  created_at    DateTime @default(now()) @db.Timestamptz

  @@index([subject_id, created_at(sort: Desc), id(sort: Desc)])
  @@index([created_at(sort: Desc), id(sort: Desc)])
  @@schema("subscription")
}

// CCP-A2 — the append-only commercial audit stream (UPDATE and DELETE rejected
// unconditionally at the DB). Read by GET /platform/commercial/audit-events
// (platform:commercial:audit:read). change_request_id gains its FK in CCP-A3.
model CommercialAuditEvent {
  id                String                  @id @db.Uuid
  actor_id          String?                 @db.Uuid
  // user | system. CHECK (a user actor carries actor_id).
  actor_type        String
  // Server-side snapshot of the actor's role keys at the time of the event.
  actor_role_keys   String[]                @default([])
  // UPPER_SNAKE event type. CHECK (format).
  event_type        String
  is_exception      Boolean                 @default(false)
  tenant_id         String?                 @db.Uuid
  // "<kind>:<id>". CHECK.
  subject           String
  change_request_id String?                 @db.Uuid
  policy_version_id String                  @db.Uuid
  payload           Json                    @default("{}")
  correlation_id    String
  // Millisecond precision: the (created_at, id) keyset cursor round-trips through a Date.
  created_at        DateTime                @default(now()) @db.Timestamptz(3)
  policy_version    CommercialPolicyVersion @relation(fields: [policy_version_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // CCP-A3 — the FK deferred from A2.
  change_request    CommercialChangeRequest? @relation(fields: [change_request_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([created_at(sort: Desc), id(sort: Desc)])
  @@index([actor_id, created_at(sort: Desc), id(sort: Desc)])
  @@index([tenant_id, created_at(sort: Desc), id(sort: Desc)])
  @@index([event_type, created_at(sort: Desc), id(sort: Desc)])
  @@schema("subscription")
}

// CCP-A3 — a governed commercial change request (Recon Report §2). Payload, chain and
// identity are immutable from INSERT; state moves only along the A3 transitions; APPROVED
// needs one CommercialApproval per snapshotted step; DELETE is rejected (all by trigger).
// One open request per tenant × product (Q14, partial unique index in the migration).
model CommercialChangeRequest {
  id                String                   @id @db.Uuid
  // Closed set (CHECK); see COMMERCIAL_ACTION_TYPES.
  action_type       String
  // NORMAL | EXCEPTION | MIGRATION. CHECK.
  kind              String
  // DRAFT | PENDING_APPROVAL | APPROVED | APPLYING | APPLIED | APPLY_FAILED | REJECTED |
  // EXPIRED | WITHDRAWN. CHECK + guard trigger.
  state             String                   @default("DRAFT")
  tenant_id         String?                  @db.Uuid
  // No DB default (PBD §7.1). A3 interim closed set 'sign' (CHECK); A4 registry.
  product_key       String?
  payload           Json
  payload_checksum  String
  required_chain    Json
  policy_version_id String                   @db.Uuid
  policy_checksum   String
  requested_by      String                   @db.Uuid
  reason            String
  idempotency_key   String                   @unique
  created_at        DateTime                 @db.Timestamptz(3)
  submitted_at      DateTime?                @db.Timestamptz(3)
  expires_at        DateTime?                @db.Timestamptz(3)
  approved_at       DateTime?                @db.Timestamptz(3)
  rejected_at       DateTime?                @db.Timestamptz(3)
  rejected_by       String?                  @db.Uuid
  rejection_reason  String?
  withdrawn_at      DateTime?                @db.Timestamptz(3)
  expired_at        DateTime?                @db.Timestamptz(3)
  apply_attempts    Int                      @default(0)
  applied_at        DateTime?                @db.Timestamptz(3)
  updated_at        DateTime                 @db.Timestamptz(3)
  policy_version    CommercialPolicyVersion  @relation(fields: [policy_version_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvals         CommercialApproval[]
  audit_events      CommercialAuditEvent[]

  @@index([state, created_at(sort: Desc), id(sort: Desc)])
  @@index([requested_by, created_at(sort: Desc), id(sort: Desc)])
  @@index([created_at(sort: Desc), id(sort: Desc)])
  @@schema("subscription")
}

// CCP-A3 — one approval of one step (append-only evidence; UPDATE and DELETE rejected).
// D8: UNIQUE(change_request_id, approver_user_id) and UNIQUE(change_request_id, step_index).
model CommercialApproval {
  id                 String                        @id @db.Uuid
  change_request_id  String                        @db.Uuid
  step_index         Int
  approver_user_id   String                        @db.Uuid
  step_role_key      String
  step_scope_keys    String[]
  approver_role_keys String[]
  attestation_id     String                        @db.Uuid
  comment            String?
  created_at         DateTime                      @db.Timestamptz(3)
  change_request     CommercialChangeRequest       @relation(fields: [change_request_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attestation        CommercialOperatorAttestation @relation(fields: [attestation_id], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([change_request_id, approver_user_id])
  @@unique([change_request_id, step_index])
  @@index([approver_user_id])
  @@schema("subscription")
}

// CCP-A3 (D9) — one-account-per-human attestation for a platform operator. Never deleted;
// one revocation allowed. At most one active row per user and per attested human.
model CommercialOperatorAttestation {
  id                String               @id @db.Uuid
  user_id           String               @db.Uuid
  // SHA-256 hex of the attested human reference (no PII).
  human_ref_hash    String
  statement_version String
  // BOOTSTRAP | PLATFORM_OWNER. CHECK.
  method            String
  attested_by       String               @db.Uuid
  attested_at       DateTime             @db.Timestamptz(3)
  revoked_at        DateTime?            @db.Timestamptz(3)
  revoked_by        String?              @db.Uuid
  revoke_reason     String?
  approvals         CommercialApproval[]

  @@schema("subscription")
}

// CCP-A6 (PBD §5.1 row A6; Conversion Rule C-21; Recon Report §1 C3) — the durable record of
// one APPLIED change request (Aramo-owned operations: MANUAL subscription open / change / end
// and the entitlement grant). Written in the SAME local transaction as the subscription and
// entitlement writes and the APPLIED transition; the guard trigger refuses APPLIED without it
// and re-checks both domain sides. Append-only (UPDATE and DELETE rejected); one per request.
// Plain UUID references (FKs in SQL, migration 20261025200000); no Prisma relations.
model CommercialChangeApplication {
  id                       String   @id @db.Uuid
  change_request_id        String   @unique @db.Uuid
  // CHECK: SUBSCRIPTION_OPEN | SUBSCRIPTION_CHANGE | SUBSCRIPTION_END | ENTITLEMENT_GRANT
  action_type              String
  tenant_id                String   @db.Uuid
  product_key              String
  subscription_id          String?  @db.Uuid
  replaced_subscription_id String?  @db.Uuid
  from_plan_version_id     String?  @db.Uuid
  to_plan_version_id       String?  @db.Uuid
  capabilities             String[]
  capabilities_inserted    String[]
  attempt                  Int
  applied_by               String   @db.Uuid
  applied_at               DateTime @db.Timestamptz(3)

  @@index([tenant_id, product_key])
  @@index([subscription_id])
  @@schema("subscription")
}

// CCP-C1 (PBD §5.2 row C1; Conversion Rule C-22, C-23) — one durable, idempotent Stripe-owned
// operation (the command outbox). Keyed by (change_request_id, step); idempotency_key is derived
// ('aramo-ccp-<change_request_id>-<step>', CHECK). PENDING → DISPATCHING → PENDING_PROVIDER →
// CONFIRMED, with RETRY_WAIT / FAILED; the provider call never runs inside a local transaction,
// and CONFIRMED is written only in the transaction that applies the provider-confirmed state.
// State machine, immutability and the "completed approval chain" INSERT rule by trigger
// (migration 20261026020000); DELETE rejected. Plain UUID reference to the change request (FK in
// SQL); no Prisma relation.
model BillingProviderCommand {
  id                    String    @id @db.Uuid
  // CHECK: STRIPE
  provider              String
  // CHECK: SUBSCRIPTION_CANCEL | CHECKOUT_SESSION_EXPIRE
  command_kind          String
  change_request_id     String    @db.Uuid
  step                  String
  idempotency_key       String    @unique
  tenant_id             String    @db.Uuid
  product_key           String
  target_ref            String
  params                Json
  // CHECK: PENDING | DISPATCHING | PENDING_PROVIDER | RETRY_WAIT | FAILED | CONFIRMED
  state                 String
  attempts              Int
  lease_until           DateTime? @db.Timestamptz(3)
  next_attempt_at       DateTime? @db.Timestamptz(3)
  last_error_code       String?
  last_error_detail     String?
  provider_accepted_at  DateTime? @db.Timestamptz(3)
  confirmed_at          DateTime? @db.Timestamptz(3)
  // CHECK: WEBHOOK | REFETCH
  confirmation_source   String?
  confirmation_event_id String?
  failed_at             DateTime? @db.Timestamptz(3)
  created_by            String    @db.Uuid
  created_at            DateTime  @db.Timestamptz(3)
  updated_at            DateTime  @db.Timestamptz(3)

  @@unique([change_request_id, step])
  @@index([state, next_attempt_at])
  @@index([provider, target_ref])
  @@index([tenant_id, created_at(sort: Desc), id(sort: Desc)])
  @@index([created_at(sort: Desc), id(sort: Desc)])
  @@schema("subscription")
}

// CCP-C1 — the webhook inbox: the durable receipt of every VERIFIED provider event (the
// verified envelope only; never the raw payload), claimed with a lease while processed.
// BillingEvent stays the outcome evidence and the dedupe. Envelope immutable, PROCESSED
// terminal, DELETE rejected (trigger, migration 20261026020000).
model BillingWebhookInbox {
  id                   String    @id @db.Uuid
  // CHECK: STRIPE
  provider             String
  provider_event_id    String
  event_type           String
  event_created_at     DateTime  @db.Timestamptz(6)
  subscription_ref     String?
  checkout_session_ref String?
  product_key          String
  // CHECK: RECEIVED | PROCESSING | PROCESSED | FAILED
  status               String
  attempts             Int
  lease_until          DateTime? @db.Timestamptz(3)
  next_attempt_at      DateTime? @db.Timestamptz(3)
  // CHECK: APPLIED | IGNORED | DUPLICATE
  outcome              String?
  detail               String?
  last_error           String?
  received_at          DateTime  @db.Timestamptz(3)
  processed_at         DateTime? @db.Timestamptz(3)
  updated_at           DateTime  @db.Timestamptz(3)

  @@unique([provider, provider_event_id])
  @@index([status, next_attempt_at])
  @@index([received_at(sort: Desc), id(sort: Desc)])
  @@schema("subscription")
}

// CCP-D3 (PBD §5.4 row D3) — the operator-visible exception register for billing and approval
// operations. One OPEN row per (alert_type, subject_id) (partial unique index); OPEN → RESOLVED
// only, RESOLVED terminal, identity immutable, DELETE rejected (trigger, migration
// 20261026090000). Written only by CommercialAlertScanner, which reads the source tables and never
// changes them. No money and no per-tenant grade (PLATFORM-UX-1 :139).
model CommercialOperationalAlert {
  id                String    @id @db.Uuid
  // CHECK (closed set, with family and subject_kind): see COMMERCIAL_ALERT_TYPES.
  alert_type        String
  // BILLING | APPROVAL
  family            String
  // billing_command | reconciliation_flag | webhook_inbox | usage_metric | change_request
  subject_kind      String
  subject_id        String
  tenant_id         String?   @db.Uuid
  product_key       String?
  // OPEN | RESOLVED
  status            String
  detail            String
  // The subject's observed state at the last detection.
  evidence          Json
  // The configured threshold the detection used (stuck / nearing-expiry types only).
  threshold_minutes Int?
  detection_count   Int
  first_detected_at DateTime  @db.Timestamptz(3)
  last_detected_at  DateTime  @db.Timestamptz(3)
  resolved_at       DateTime? @db.Timestamptz(3)
  resolution_detail String?
  updated_at        DateTime  @db.Timestamptz(3)

  @@index([family, status, first_detected_at(sort: Desc), id(sort: Desc)])
  @@index([family, first_detected_at(sort: Desc), id(sort: Desc)])
  @@index([subject_kind, subject_id])
  @@schema("subscription")
}
