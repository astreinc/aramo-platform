// Per-module Prisma schema for the `talent-evidence` module.
//
// Per Architecture v2.1 §7 (Schema-per-Module data architecture) and
// doc/05-conventions.md "Database Conventions". Cross-schema references
// elsewhere in the program are UUID-only without FK constraints (§7.3).
//
// IDENTITY KEYING (ADR-0016 step 4c): every `talent_id` column below
// references talent_record.TalentRecord.id (the tenant-scoped ATS heart).
// (TalentContactMethod formerly carried a transitional per-tenant identity id
// on the ingestion path ahead of ATS curation; that write has been retired —
// see that model's note.)
//
// M3 PR-5 — Talent-evidence entity foundation. The 7 Talent-evidence
// sub-entities required by EvidenceReference (Group 2 §2.4) are built here,
// each to its Group 2 §2.2 Talent Record Spec field-level type literal
// EXACTLY (names, types, enums, optionality). The 8th entity in the
// EvidenceReference closed list — TalentSelectionEvent — is NAMED ONLY in
// §2.2 (no inline shape; absent from the 24-entity Talent Record Spec table)
// and lives in the selection domain (§2.3b, Plan v1.5 §M5). Per directive
// §2 Ruling 1, TalentSelectionEvent is deferred to M5.
//
// Per directive §2 Ruling 4, TalentWorkAuthorization (Group 2 #6 — Declared
// (Sensitive)) ships with its full §2.2 column shape; the Architecture §14.4
// sensitive-field treatment (encryption, access logging, elevated-permission
// access) is deferred to follow-up F16, pending the Architecture §14.3
// sensitive-field implementation artifact.
//
// Per directive §2 Ruling 3, TalentSkillEvidence.skill_id and .source_record_id
// are forward-reference UUID columns (Architecture §7.3 — UUID-only, no FK).
// SkillTaxonomy and ingestion-source foundations are not scoped into PR-5.

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["talent_evidence"]
}

// -------------------------------------------------------------------------
// Enums — declared first. Each is a Group 2 §2.2 closed string-union literal.
// -------------------------------------------------------------------------

// §2.2 TalentSkillEvidence.source — "declared" | "ingested" | "derived"
enum TalentSkillEvidenceSource {
  declared
  ingested
  derived

  @@schema("talent_evidence")
}

// §2.2 TalentWorkHistoryEntry.source — "resume" | "linkedin" | "manual" | "import"
enum TalentWorkHistorySource {
  resume
  linkedin
  manual
  import

  @@schema("talent_evidence")
}

// TR-7 B1 — TalentEducationEntry.source. Résumé-derived credential capture; the
// extraction writes 'resume', manual entry / import are the other honest arrivals.
enum TalentEducationSource {
  resume
  manual
  import

  @@schema("talent_evidence")
}

// TR-7 B1 — TalentCertificationEntry.source. Same arrivals as education.
enum TalentCertificationSource {
  resume
  manual
  import

  @@schema("talent_evidence")
}

// §2.2 TalentContactMethod.type — "email" | "phone" | "linkedin" | "github" | "portfolio" | "other"
enum TalentContactType {
  email
  phone
  linkedin
  github
  portfolio
  other

  @@schema("talent_evidence")
}

// §2.2 TalentContactMethod.verification_status — "unverified" | "verified" | "failed" | "stale"
enum TalentContactVerificationStatus {
  unverified
  verified
  failed
  stale

  @@schema("talent_evidence")
}

// §2.2 TalentRateExpectation.employment_type — "W2" | "1099" | "C2C" | "FTE".
// Prisma enum-value names must start with a letter (identifier rule); "1099"
// is mapped via @map so the database value matches the §2.2 literal verbatim
// while the Prisma client identifier remains valid.
enum TalentEmploymentType {
  W2
  CONTRACT_1099 @map("1099")
  C2C
  FTE

  @@schema("talent_evidence")
}

// §2.2 TalentRateExpectation.period — "HOURLY" | "ANNUAL"
enum TalentRatePeriod {
  HOURLY
  ANNUAL

  @@schema("talent_evidence")
}

// §2.2 TalentRateExpectation.source — "talent_declared" | "recruiter_entered"
enum TalentRateSource {
  talent_declared
  recruiter_entered

  @@schema("talent_evidence")
}

// §2.2 TalentWorkAuthorization.work_authorization_status — 6-value closed enum.
enum TalentWorkAuthorizationStatus {
  US_CITIZEN
  PERMANENT_RESIDENT
  VISA_HOLDER
  REQUIRES_SPONSORSHIP
  OTHER
  NOT_DISCLOSED

  @@schema("talent_evidence")
}

// §2.2 TalentDocument.document_type — 6-value closed enum.
enum TalentDocumentType {
  resume
  cover_letter
  certification
  work_sample
  reference_letter
  other

  @@schema("talent_evidence")
}

// §2.2 TalentDocument.parse_status — 4-value closed enum.
enum TalentDocumentParseStatus {
  pending
  parsed
  failed
  no_parse_attempted

  @@schema("talent_evidence")
}

// §2.2 TalentDocument.retention_policy — "default" | "extended" | "delete_after_X_days"
enum TalentDocumentRetentionPolicy {
  default
  extended
  delete_after_X_days

  @@schema("talent_evidence")
}

// -------------------------------------------------------------------------
// Models — Group 2 §2.2 Talent Record Spec, entities #4, #6, #7, #8, #10,
// #16, #17 (the seven `EvidenceReference` targets that are fully specified
// inline). Each field traces 1:1 to the §2.2 type literal.
// -------------------------------------------------------------------------

// §2.2 #16 — TalentSkillEvidence (Declared + Ingested + Derived).
model TalentSkillEvidence {
  // UUID v7 generated app-side (PR-2 precedent — Postgres 17 has no native uuidv7()).
  id                String                    @id @db.Uuid

  // Cross-schema references (§7.3 — UUID-only, no FK).
  talent_id         String                    @db.Uuid
  tenant_id         String                    @db.Uuid

  // §2 Ruling 3 — forward references; targets (SkillTaxonomy, ingestion
  // source) are not built by PR-5. UUID-only, no FK.
  skill_id          String                    @db.Uuid
  source_record_id  String?                   @db.Uuid

  surface_form      String
  source            TalentSkillEvidenceSource
  evidence_text     String?
  proficiency_claim String?
  years_claimed     Float?
  confidence_score  Float?

  // HF1 durable-fact-extraction provenance (Gate-6 ruling R1/R2). All ADDITIVE
  // + NULLABLE — pre-HF1 rows keep working; NO backfill. Populated ONLY on the
  // confirmed-create résumé path (deterministic; no AI). source_document_id →
  // the résumé TalentDocument; source_refs = source-map block ids; the version +
  // text hash anchor which corpus the refs resolve against.
  source_document_id String?                  @db.Uuid
  source_refs        String[]
  source_map_version String?
  resume_text_hash   String?

  // HF2 R3/R16 — time-aware, per-experience skill USAGE (ADD-not-rename; this
  // row becomes the canonical SkillUsage evidence). All ADDITIVE + NULLABLE.
  //   work_experience_id → the TalentWorkHistoryEntry this usage belongs to.
  //   version → ONLY when the résumé explicitly states it (e.g. "17"); never inferred.
  //   usage_start/usage_end → the interval; NULL when unknown (never invented).
  //   usage_period_basis → 'EXPLICIT' (résumé stated the skill dates) vs
  //     'WORK_EXPERIENCE_CONTEXT' (dates inherited from the enclosing role) vs
  //     'UNKNOWN'. This distinction stays queryable (R3) and feeds the derived
  //     years intelligence (R14) which must not conflate the two.
  //   activity_context → compact governed activity token(s) (R13), e.g. 'DEVELOP'.
  work_experience_id String?                  @db.Uuid
  version            String?
  usage_start        DateTime?                @db.Date
  usage_end          DateTime?                @db.Date
  usage_period_basis String?
  activity_context   String?

  // SKILL-TAX-1G — canonical reconciliation (ADD-not-rename, all NULLABLE, NO SQL
  // backfill). Resolved from surface_form (+ explicit version) by an
  // application-level worker via skills-taxonomy's SkillCanonicalizationService.
  // The legacy deterministic skill_id above is a DISTINCT keyspace and is NEVER
  // re-keyed. canonical_version_id populates ONLY when `version` is stated AND the
  // registry carries that SkillVersion — never inferred. status/method carry the
  // engine outcome explicitly (governed String+CHECK; see the 1G migration), so a
  // NULL canonical_skill_id + status='UNRESOLVED' is a valid, explainable state,
  // and re-resolution later (e.g. an alias added) can flip it to RESOLVED.
  canonical_skill_id      String?              @db.Uuid
  canonical_version_id    String?              @db.Uuid
  canonicalization_status String?
  canonicalization_method String?
  canonicalized_at        DateTime?            @db.Timestamptz

  created_at        DateTime                  @db.Timestamptz

  // Tenant-scoped + (tenant, talent) lookup; (tenant, talent, skill) supports
  // per-skill evidence_count derivation for the §2.5 Entrustability Rule Set.
  @@index([tenant_id])
  @@index([tenant_id, talent_id])
  @@index([tenant_id, talent_id, skill_id])
  @@index([tenant_id, work_experience_id])
  // Canonical aggregation: union usage intervals per canonical skill for a talent.
  @@index([tenant_id, talent_id, canonical_skill_id])
  @@schema("talent_evidence")
}

// §2.2 #10 — TalentWorkHistoryEntry (Ingested).
model TalentWorkHistoryEntry {
  id                  String                  @id @db.Uuid
  talent_id           String                  @db.Uuid
  tenant_id           String                  @db.Uuid

  employer_name       String
  role_title          String
  start_date          DateTime?               @db.Date
  end_date            DateTime?               @db.Date
  location            String?

  // §2.2 employment_type is `string?` here — free-form, NOT the
  // TalentRateExpectation closed enum.
  employment_type     String?

  description_text    String?
  source              TalentWorkHistorySource

  // Intra-lib reference to TalentDocument (when work history is parsed from
  // an uploaded document). UUID-only per §7.3, applied uniformly even for
  // same-lib references.
  source_document_id  String?                 @db.Uuid

  // HF1 durable-fact-extraction provenance (Gate-6 ruling R1/R8). ADDITIVE +
  // NULLABLE — pre-HF1 rows keep working; NO backfill. source_refs = source-map
  // block ids; version + text hash anchor the corpus the refs resolve against.
  source_refs         String[]
  source_map_version  String?
  resume_text_hash    String?

  // HF2 R2 — canonical Work Experience extension (ADD-not-rename). company_id is
  // the DEFERRED cross-domain seam (R4): a nullable UUID ref to the ats-side
  // Company, populated only by a future governed org-resolution increment; the
  // WALL forbids talent-evidence(cip)→company(ats) imports, so this stays a bare
  // UUID. employer_name (above) always preserves the raw résumé evidence.
  company_id          String?                 @db.Uuid
  // HF2 R10 — bounded (≤600 chars, app-enforced) recruiter-facing summary of the
  // role's stated responsibility/context blocks. A PROJECTION for readability —
  // never the evidence model; grounded to this entry's source_refs.
  experience_summary  String?

  is_authoritative    Boolean?
  created_at          DateTime                @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, talent_id])
  @@schema("talent_evidence")
}

// TR-7 B1 — TalentEducationEntry. A declared academic credential extracted from
// the résumé (the TalentWorkHistoryEntry precedent). institution_name + degree_name
// are NOT-NULL (so the pure DEGREE mapper's required fields are always present —
// the write-gate conformance property). Dates are @db.Date (calendar granularity).
model TalentEducationEntry {
  id               String                @id @db.Uuid
  talent_id        String                @db.Uuid
  tenant_id        String                @db.Uuid

  institution_name String
  degree_name      String
  field_of_study   String?
  conferred_date   DateTime?             @db.Date

  // The verbatim source excerpt the extraction copied (constrained-to-source).
  evidence_text    String?
  source           TalentEducationSource

  // HF2 R8 — HF1-style provenance so Add-Talent-extracted education carries its
  // source refs (ADDITIVE + NULLABLE; no backfill).
  source_document_id String?             @db.Uuid
  source_refs        String[]
  source_map_version String?
  resume_text_hash   String?

  created_at       DateTime              @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, talent_id])
  @@schema("talent_evidence")
}

// TR-7 B1 — TalentCertificationEntry. A declared professional certification.
// certification_name is NOT-NULL (the CERTIFICATION mapper's required field always
// present). issuer/credential_ref and issued/expiry dates are optional.
model TalentCertificationEntry {
  id                 String                    @id @db.Uuid
  talent_id          String                    @db.Uuid
  tenant_id          String                    @db.Uuid

  certification_name String
  issuer_name        String?
  credential_ref     String?
  issued_date        DateTime?                 @db.Date
  expiry_date        DateTime?                 @db.Date

  evidence_text      String?
  source             TalentCertificationSource

  // HF2 R8 — HF1-style provenance (ADDITIVE + NULLABLE; no backfill).
  source_document_id String?                   @db.Uuid
  source_refs        String[]
  source_map_version String?
  resume_text_hash   String?

  created_at         DateTime                  @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, talent_id])
  @@schema("talent_evidence")
}

// HF2 R6 — first-class Project Experience. A single employer/role may span
// multiple materially different initiatives; flattening them into one
// WorkExperience loses matching context. Child of TalentWorkHistoryEntry
// (work_experience_id, UUID-only per §7.3). project_name is NULLABLE — many
// résumés describe initiatives without naming them; NEVER invent a name.
// Provenance mirrors HF1 (source_refs spanning the initiative's blocks).
model TalentProjectExperience {
  id                 String    @id @db.Uuid
  talent_id          String    @db.Uuid
  tenant_id          String    @db.Uuid
  work_experience_id String    @db.Uuid

  project_name       String?
  context_summary    String?
  domain             String?
  start_date         DateTime? @db.Date
  end_date           DateTime? @db.Date

  source_document_id String?   @db.Uuid
  source_refs        String[]
  source_map_version String?
  resume_text_hash   String?

  created_at         DateTime  @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, talent_id])
  @@index([tenant_id, work_experience_id])
  @@schema("talent_evidence")
}

// §2.2 #4 — TalentContactMethod (Declared + Derived).
model TalentContactMethod {
  id                  String                          @id @db.Uuid
  // talent_id references talent_record.TalentRecord.id. (The ingestion path
  // formerly wrote a transitional per-tenant identity id here ahead of ATS
  // curation; that write has been retired.) UUID-only, no FK.
  talent_id           String                          @db.Uuid
  tenant_id           String                          @db.Uuid

  type                TalentContactType
  value               String
  is_primary          Boolean
  verification_status TalentContactVerificationStatus
  verified_at         DateTime?                       @db.Timestamptz
  created_at          DateTime                        @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, talent_id])
  @@schema("talent_evidence")
}

// §2.2 #7 — TalentRateExpectation (Declared).
model TalentRateExpectation {
  id              String               @id @db.Uuid
  talent_id       String               @db.Uuid
  tenant_id       String               @db.Uuid

  employment_type TalentEmploymentType
  min_rate        Float
  target_rate     Float?
  currency        String
  period          TalentRatePeriod
  source          TalentRateSource
  updated_at      DateTime             @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, talent_id])
  @@schema("talent_evidence")
}

// §2.2 #6 — TalentWorkAuthorization (Declared (Sensitive)).
// Per directive §2 Ruling 4 / §9 F16: ships with its §2.2 column shape;
// §14.4 sensitive-field PII-handling treatment is deferred to F16, pending
// the §14.3 sensitive-field implementation artifact.
model TalentWorkAuthorization {
  id                        String                        @id @db.Uuid
  talent_id                 String                        @db.Uuid
  tenant_id                 String                        @db.Uuid

  work_authorization_status TalentWorkAuthorizationStatus
  authorized_to_work_in     String[]
  visa_type                 String?
  requires_sponsorship      Boolean
  updated_at                DateTime                      @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, talent_id])
  @@schema("talent_evidence")
}

// §2.2 #8 — TalentDocument (Ingested).
model TalentDocument {
  id                       String                        @id @db.Uuid
  talent_id                String                        @db.Uuid
  tenant_id                String                        @db.Uuid

  // Forward reference → identity domain (Actor/Recruiter). UUID-only, no FK.
  uploaded_by_actor_id     String                        @db.Uuid

  uploaded_at              DateTime                      @db.Timestamptz
  document_type            TalentDocumentType
  filename                 String
  file_storage_ref         String
  mime_type                String

  // §2.2 size_bytes is `number`; logical integer (byte count). Int suffices
  // for documents up to ~2GB, which exceeds any v1 document type's expected size.
  size_bytes               Int

  parse_status             TalentDocumentParseStatus
  consent_scope_at_upload  String[]
  retention_policy         TalentDocumentRetentionPolicy
  is_active                Boolean

  @@index([tenant_id])
  @@index([tenant_id, talent_id])
  @@schema("talent_evidence")
}

// §2.2 #17 — TalentDerivedSnapshot (Derived).
model TalentDerivedSnapshot {
  id                                  String   @id @db.Uuid
  talent_id                           String   @db.Uuid
  tenant_id                           String   @db.Uuid

  skill_confidence_scores             Json
  estimated_years_experience_overall  Float?
  estimated_years_experience_by_skill Json?
  // SKILL-TAX-1G — canonical (interval-union) supported-years keyed by
  // canonical_skill_id. ADDITIVE: the legacy estimated_years_experience_by_skill
  // above (keyed by the surface-derived skill_id, written by HF2 extraction) is
  // preserved UNCHANGED for compatibility. Computed post-canonicalization by
  // union of usage intervals — never by summing per-surface totals.
  estimated_years_experience_by_canonical_skill Json?
  skill_domains                       Json?
  career_trajectory_pattern           String?
  intent_signal                       Json?
  freshness_score                     Json?
  reachability_score                  Json?
  availability_confidence             Float?
  trust_level                         String?
  data_completeness_score             Float?
  threshold_status                    Json?
  current_consent_state               Json?
  computed_at                         DateTime @db.Timestamptz

  @@index([tenant_id])
  @@index([tenant_id, talent_id])
  @@schema("talent_evidence")
}

// ── TALENT-INTEL-1 §5 / Gate-5 rulings 1, 2, 18 ──────────────────────────────
// A résumé-specific EVIDENCE-CONTEXT companion to TalentDocument (the canonical
// evidence-document identity). Layering (ruling 1): Attachment = file/access
// artifact; TalentDocument = evidence-document identity; TalentResumeEdition =
// résumé edition semantics (purpose/context/content-hash/lineage). ADDITIVE:
// NO change to the HF2 evidence rows — evidence still anchors on
// source_document_id → TalentDocument → (this) edition; no source_edition_id
// duplication (ruling 1 correction). No extraction, no backfill in this slice.

enum TalentResumeEditionPurpose {
  GENERAL
  ROLE_FAMILY
  REQUISITION
  CLIENT_SUBMITTAL
  USER_DEFINED

  @@schema("talent_evidence")
}

// The edition's OWN lifecycle — NOT default-selection (modeled separately in
// TalentResumeDefault) and NOT the validity of the evidence it grounded
// (rulings 2/5: a later edition never invalidates earlier evidence).
// `retracted` is set ONLY by an explicit retraction (§35), never by omission
// from a newer résumé.
enum TalentResumeEditionLifecycle {
  active
  retracted
  archived

  @@schema("talent_evidence")
}

model TalentResumeEdition {
  id                       String                       @id @db.Uuid
  tenant_id                String                       @db.Uuid
  talent_id                String                       @db.Uuid

  // 1:1 companion to the canonical evidence-document identity (same schema).
  // UNIQUE — one edition row per TalentDocument (ruling 1). UUID-only, no FK.
  talent_document_id       String                       @unique @db.Uuid

  // File/access artifact seam (attachment schema). UUID-only, no FK (THE WALL /
  // §7.3). Optional — an edition may exist before/without a mirrored Attachment.
  attachment_id            String?                      @db.Uuid

  // Content identity for idempotent re-extraction (§25 / ruling 12): the hash of
  // the résumé text/bytes. A NEW content_hash is the re-extraction trigger key.
  content_hash             String

  // Résumé-specific context (ruling 18). Requisition/client refs are UUID-only,
  // no FK (cross-domain seams).
  purpose                  TalentResumeEditionPurpose   @default(GENERAL)
  label                    String?
  requisition_id           String?                      @db.Uuid
  client_context_id        String?                      @db.Uuid

  // Lineage seam: an edition tailored/derived from a prior edition.
  derived_from_edition_id  String?                      @db.Uuid

  lifecycle_status         TalentResumeEditionLifecycle @default(active)

  created_at               DateTime                     @db.Timestamptz
  // Uploader actor (identity domain forward ref). UUID-only, no FK.
  created_by               String                       @db.Uuid

  @@index([tenant_id])
  @@index([tenant_id, talent_id])
  @@index([tenant_id, talent_id, purpose])
  @@schema("talent_evidence")
}

// Default/presentation résumé selection — modeled SEPARATELY from evidence
// validity (rulings 2/10): "default" = show/use by default, NOT "other editions
// obsolete". UNIQUE(tenant_id, talent_id) enforces exactly one default per
// Talent. resume_edition_id is UUID-only, no FK.
model TalentResumeDefault {
  id                 String   @id @db.Uuid
  tenant_id          String   @db.Uuid
  talent_id          String   @db.Uuid
  resume_edition_id  String   @db.Uuid
  set_at             DateTime @db.Timestamptz
  set_by             String   @db.Uuid

  @@unique([tenant_id, talent_id])
  @@index([tenant_id])
  @@schema("talent_evidence")
}
