{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/libs/intelligence-core",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "tsBuildInfoFile": "../../dist/libs/intelligence-core/.tsbuildinfo",
    "types": [
      "node"
    ],
    "paths": {
      "@aramo/intelligence-contracts": [
        "../../dist/libs/intelligence-contracts/src/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/tests/**/*",
    "**/*.spec.ts"
  ]
}
