{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/libs/outbox-publisher",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "tsBuildInfoFile": "../../dist/libs/outbox-publisher/.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@aramo/canonicalization": ["../../dist/libs/canonicalization/src/index.d.ts"],
      "@aramo/common": ["../../dist/libs/common/src/index.d.ts"],
      "@aramo/consent": ["../../dist/libs/consent/src/index.d.ts"],
      "@aramo/selection": ["../../dist/libs/selection/src/index.d.ts"],
      "@aramo/placement": ["../../dist/libs/placement/src/index.d.ts"],
      "@aramo/submittal": ["../../dist/libs/submittal/src/index.d.ts"],
      "@aramo/pipeline": ["../../dist/libs/pipeline/src/index.d.ts"],
      "@aramo/client-selection": ["../../dist/libs/client-selection/src/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**/*", "**/*.spec.ts"]
}
