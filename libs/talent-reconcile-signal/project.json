{
  "name": "talent-reconcile-signal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/talent-reconcile-signal/src",
  "projectType": "library",
  "tags": ["scope:cip"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/talent-reconcile-signal",
        "main": "libs/talent-reconcile-signal/src/index.ts",
        "tsConfig": "libs/talent-reconcile-signal/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/talent-reconcile-signal/**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests --root libs/talent-reconcile-signal"
      }
    }
  }
}
