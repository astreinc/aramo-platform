{
  "name": "intelligence-integration",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/intelligence-integration/src",
  "projectType": "library",
  "tags": ["scope:ats"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/intelligence-integration",
        "main": "libs/intelligence-integration/src/index.ts",
        "tsConfig": "libs/intelligence-integration/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/intelligence-integration/**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests --root libs/intelligence-integration"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --noEmit -p libs/intelligence-integration/tsconfig.lib.json"
      }
    }
  }
}
