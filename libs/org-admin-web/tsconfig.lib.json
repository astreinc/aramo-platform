{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/libs/org-admin-web",
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "declaration": true,
    "tsBuildInfoFile": "../../dist/libs/org-admin-web/.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@aramo/fe-foundation": ["../../dist/libs/fe-foundation/src/index.d.ts"],
      "@aramo/document-templates-web": ["../../dist/libs/document-templates-web/src/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/test-setup.ts", "src/tests/**"]
}
