# Aramo — Single-Box PROD env contract (example).
#
# The full env surface the prod stack (docker-compose.prod.yml) reads. Copy to a
# real `.env` on the box (or locally for provability) and fill in real values.
# NEVER commit a real `.env` or a real secret; no secret is ever baked into an
# image layer.
#
# How it's consumed (the proven multi-line-PEM-safe pattern from D1):
#   set -a && source .env && set +a
#   docker compose --env-file /dev/null -f docker-compose.prod.yml up -d
# Bare-name `environment:` entries in the compose pass through from this sourced
# shell env verbatim (multi-line PEM keys survive — compose never parses them).
#
# Values here are PLACEHOLDERS. This documents the prod surface only; the dev
# contract stays in .env.example.

# ── Front-door / nginx (TLS + domain parameterization, ADR-0023) ────────────
# nginx is the single ingress on 80/443; certbot owns the *.aramo.ai WILDCARD
# cert via DNS-01/Route53 (one cert covers every <slug>.aramo.ai — onboarding is
# a Tenant row, not infra). These four vars parameterize nginx's server_names +
# cert dir; unset → the template's LOCAL defaults (localhost / admin.localhost /
# portal.localhost / /etc/letsencrypt/live/aramo.ai) so the stack runs+tests on a
# laptop with mkcert and NO public domain. On the box set the wildcard + subdomain
# hosts (below). Bare-name passthrough — a var absent from the compose
# `environment:` reverts to local (the D-AUTH-PLATFORM-HOSTS-1 defect class).
NGINX_TENANT_SERVER_NAME=*.aramo.ai
NGINX_ADMIN_SERVER_NAME=admin.aramo.ai
NGINX_PORTAL_SERVER_NAME=candidate.aramo.ai
NGINX_CERT_DIR=/etc/letsencrypt/live/aramo.ai

# ── Aramo Sign Mobile — app-association files on the Sign host (nginx) ──────
# Directive §14 P-1/P-3/P-6; Amendment M-A2 §3.2. nginx renders
# /.well-known/apple-app-site-association and /.well-known/assetlinks.json from
# these at container start (deploy/nginx/app-links/render-app-links.sh). Public
# identifiers, NOT secrets. Optional: unset or malformed ⇒ valid JSON that
# associates nothing (links keep opening the web signer). Restart nginx after a
# change. Runbook: doc/runbooks/RELEASE-sign-mobile.md.
#   SIGN_IOS_APP_ID            <Apple Team ID>.ai.aramo.sign (P-1)
#   SIGN_ANDROID_PACKAGE       ai.aramo.sign (P-3)
#   SIGN_ANDROID_CERT_SHA256S  comma list: the Play app-signing key AND the upload
#                              key SHA-256 fingerprints, AA:BB:… form (P-3)
# SIGN_IOS_APP_ID=ABCDE12345.ai.aramo.sign
# SIGN_ANDROID_PACKAGE=ai.aramo.sign
# SIGN_ANDROID_CERT_SHA256S=AA:BB:...:FF,11:22:...:99

# ── Backend images (D1 / ECR) ───────────────────────────────────────────────
# The D1 images are referenced, not rebuilt. Local default = the local D1 tags;
# on the box point these at the ECR tags (D2). Optional (defaults applied).
# ARAMO_API_IMAGE=aramo/api:local
# ARAMO_AUTH_IMAGE=aramo/auth-service:local
# Inc-3 PR-3.3 — the platform-admin image (built + published from main like the
# others). Local default = the local build tag; on the box point at the GHCR tag.
# ARAMO_PLATFORM_ADMIN_IMAGE=aramo/platform-admin:local
# ATI-SEP-1 T0 — the Talent Intelligence service image (deploy/build-images.sh builds it).
# ARAMO_INTELLIGENCE_IMAGE=aramo/talent-intelligence-service:local

# ── Runtime ─────────────────────────────────────────────────────────────────
# NODE_ENV is forced to `production` by the compose for api + auth-service.
# ARAMO_ENV selects per-env resources (incl. the Secrets-Manager secret id for
# the Anthropic key — see below). Prod value:
ARAMO_ENV=prod

# ── Database (Postgres) ─────────────────────────────────────────────────────
# These configure the in-stack postgres service AND are interpolated into the
# api/auth DATABASE_URL (host pinned to the `postgres` service name) — they
# cannot drift. Use a real password on the box.
POSTGRES_USER=aramo
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=aramo
# Postgres + Redis are container-internal; their URLs are PINNED to the compose
# service names inside docker-compose.prod.yml — do NOT set DATABASE_URL /
# REDIS_URL here (the .env localhost values are unreachable in-container).

# ── Talent Intelligence database (ATI-SEP-1 T0, ADR-0036 Decision 2) ────────
# TI has its OWN database `aramo_intelligence` and role on the same postgres server.
# deploy/migrate-prod.sh creates/re-asserts the role + database idempotently
# (tools/ensure-intelligence-db.sh, using the POSTGRES_* superuser) and applies the
# TI migrations before containers are recreated. The compose builds
# INTELLIGENCE_DATABASE_URL for talent-intelligence-service from these parts.
# REQUIRED — the compose refuses to start without the password. 16+ URL-safe
# characters [A-Za-z0-9._~-] (it is embedded in the URL); e.g. `openssl rand -hex 24`.
INTELLIGENCE_DB_PASSWORD=change_me_in_prod_url_safe
# Optional (default aramo_intelligence).
# INTELLIGENCE_DB_USER=aramo_intelligence

# ── Auth / Cognito (reused pool us-east-1_4fKlnGfaW) ────────────────────────
# auth-service reads these; api reads the subset it needs (audience, public key,
# tenant pool id, cognito endpoint); platform-admin reads audience + public key
# + BOTH pool ids (tenant-owner invites → tenant pool; platform-admin invites →
# platform pool) + cognito endpoint + AWS creds.
AUTH_AUDIENCE=
AUTH_COGNITO_DOMAIN=
AUTH_COGNITO_CLIENT_ID=
AUTH_COGNITO_ISSUER=
AUTH_COGNITO_TENANT_USER_POOL_ID=
# Inc-3 PR-3.3 — the PLATFORM Cognito user pool (platform-admin invitations mint
# platform operators here; distinct from the tenant pool above). Required by
# platform-admin only.
AUTH_COGNITO_PLATFORM_USER_POOL_ID=
# PLATFORM-UX-1 B-1c — platform-admin only: the email domains a platform
# administrator invitation (POST /platform/admins/invitations) may target.
# Comma list, trimmed, case-insensitive. Unset/empty ⇒ aramo.ai (the default).
# Any other domain is refused 400 VALIDATION_ERROR (reason
# platform_admin_domain_not_allowed). Not a secret.
PLATFORM_ADMIN_EMAIL_DOMAINS=aramo.ai
AUTH_COGNITO_ENDPOINT=
# PR-3.1 (host-derived base): the callback/post-login/signout bases now DERIVE
# from the request's VALIDATED host FIRST (tenant host via findActiveBySlug,
# platform host via AUTH_PLATFORM_HOSTS, or localhost under dev posture), so
# astre.aramo.ai + admin.aramo.ai + both localhost consoles work concurrently
# with the envs below UNSET. The envs remain the escape hatch for unvalidated
# hosts (and existing single-console prod). A raw Host never reaches a redirect.
#
# AUTH_PLATFORM_HOSTS — comma-separated exact platform console hosts (lowercased,
# port-stripped) whose login derives an https base. Prod default: admin.aramo.ai.
AUTH_PLATFORM_HOSTS=admin.aramo.ai
# Portal P1 — AUTH_PORTAL_HOSTS: the portal host class (sibling to platform),
# the exact host(s) whose passwordless login derives an https base. On the box:
# candidate.aramo.ai. PORTAL_LOGIN_BASE_URL is the magic-link base (the portal
# origin) used when a request host is not a validated portal host.
AUTH_PORTAL_HOSTS=candidate.aramo.ai
PORTAL_LOGIN_BASE_URL=https://candidate.aramo.ai
# AUTH_SIGNOUT_PATH — the path appended to a DERIVED base for the post-logout
# landing (default '/'). Used only when a host validates; unvalidated hosts fall
# back to the full-URL envs below.
AUTH_SIGNOUT_PATH=/
# D-ORG-2 (topology T1) — the post-login landing is PER CONSUMER and built in:
# recruiter → /ats/ (the ATS app), org → / (App Home), esign/platform/portal → /.
# Override ONE consumer explicitly with AUTH_POST_LOGIN_PATH_<CONSUMER> (passed
# through to auth-service by compose). The legacy global AUTH_POST_LOGIN_PATH is
# RETIRED for the known consumers (it never overrides a built-in base) — do not set it.
# AUTH_POST_LOGIN_PATH_RECRUITER=/ats/
# AUTH_POST_LOGIN_PATH_ORG=/
# AUTH_POST_LOGIN_PATH_SIGN=/   (the Sign workspace root on sign.aramo.ai; it routes to /sign/ or /personal/)
# PX-1 — the App Home Sign tile stays DARK until ARAMO_SIGN_ENTRY_ENABLED=true (api). Its target is the
# product host https://sign.aramo.ai/ (override with ARAMO_SIGN_ENTRY_URL). Neither is set for release.
# ARAMO_SIGN_ENTRY_ENABLED=false
# ARAMO_SIGN_ENTRY_URL=https://sign.aramo.ai/
# The public origin the browser reaches the app on. Fallback for UNVALIDATED
# hosts (host-derivation wins when the host validates). auth-service derives the
# hosted-UI callback per consumer as ${AUTH_PUBLIC_BASE_URL}/auth/<consumer>/callback
# at authorize + token-exchange (Amendment v1.2 Workstream D). Each derived URL
# must be a registered callback on the app client. The recruiter derivation
# matches the currently-registered prod URL (https://astre.aramo.ai/auth/recruiter/callback).
# Box: https://astre.aramo.ai
AUTH_PUBLIC_BASE_URL=
# DEPRECATED (Amendment v1.2): the single-valued full callback URL. Fallback only
# — if AUTH_PUBLIC_BASE_URL is unset, its ORIGIN is used as the base.
# Box (legacy): https://astre.aramo.ai/auth/recruiter/callback
AUTH_COGNITO_REDIRECT_URI=
# Where /auth/:consumer/callback 302s after a successful login for an UNVALIDATED
# host (a validated host derives ${base}${AUTH_POST_LOGIN_PATH}). Box: the app
# origin https://astre.aramo.ai.
AUTH_POST_LOGIN_REDIRECT=
# The registered post-logout return URL for an UNVALIDATED host (box:
# https://astre.aramo.ai/login).
AUTH_COGNITO_SIGNOUT_REDIRECT=
# Federated-IdP allow-list (comma-separated; e.g. Google,Microsoft).
AUTH_TRUSTED_IDP_NAMES=
# AUTH-SIGNIN-1 Amendment M-A1 — native authentication consumer (Aramo Sign
# mobile), auth-service only. SIGN_NATIVE_COGNITO_CLIENT_ID is the PUBLIC Cognito
# app client `aramo-sign-native` (no client secret; Authorization Code + PKCE S256
# required; Google + Microsoft IdPs; tenant provider pins still apply — Personal
# is Google-only). Creating that client is a separately authorized production
# Cognito change; until it exists leave this EMPTY and the /auth/native/sign/*
# routes refuse with 500 native_client_not_configured (browser sign-in unchanged).
# Not a secret.
SIGN_NATIVE_COGNITO_CLIENT_ID=
# The native callbacks a token request's redirect_uri must equal BYTE FOR BYTE
# (comma list, trimmed). Unset/empty → the default below: the verified app link
# first, the custom scheme only as the fallback where app-link verification is
# unavailable. Each entry must also be a registered callback on the native client.
# SIGN_NATIVE_REDIRECT_URIS=https://sign.aramo.ai/auth/native/callback,aramosign://auth/callback
AUTH_REFRESH_GRACE_SECONDS=60
# Leave UNSET/false in prod: cookies are Secure under HTTPS. (Forced
# Secure anyway when NODE_ENV=production, which the compose sets.)
AUTH_ALLOW_INSECURE_COOKIES=false
# IC-2 PR-4 — session tenant binding (one User = one tenant, bound to the host).
# AUTH_HOST_TENANT_BINDING=log (default when unset) records a structured
# diagnostic when the identity resolved at /callback does not belong to the host
# the user logged in on (tenant host ≠ owning tenant; platform host without the
# platform consumer/sentinel; portal/product host; unvalidated host; a PKCE
# cookie minted before this release) and leaves the login outcome UNCHANGED.
# AUTH_HOST_TENANT_BINDING=enforce DENIES those cases (403 TENANT_ACCESS_DENIED,
# no session minted). Switch to enforce only after every tenant that signs in on
# a tenant host carries a slug (Tenant.slug) and the registry/host envs above are
# correct — a wrong value here is a login outage for that host class.
AUTH_HOST_TENANT_BINDING=log
# AUTH_ALLOW_UNBOUND_HOST=true is the explicit DEV exception: under enforce it lets
# a dev/unvalidated host (no sealed host context) still mint a session. It never
# overrides an explicit tenant or platform mismatch. Leave UNSET/false in prod
# (fail-closed under enforce).
AUTH_ALLOW_UNBOUND_HOST=false
# IC-2 PR-4 (F-3) — AUTH_PRODUCT_HOSTS: the product-console host class (Sign
# sender console), exact-match allowlist like AUTH_PLATFORM_HOSTS. DARK scaffold:
# no auth route/Cognito callback exists for it yet and host binding refuses
# product-host login under enforce. Default when unset: sign.aramo.ai (registry
# seed row only). Leave UNSET until the product-host login is authorized.
AUTH_PRODUCT_HOSTS=

# ── JWT session signing (asymmetric PEM keys) ───────────────────────────────
# Multi-line PEM. Passed through verbatim via the sourced-shell pattern above.
# auth-service signs (private+public); api verifies (public only).
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=
AUTH_PKCE_STATE_KEY=

# ── AWS / S3 (resume + attachment storage) ──────────────────────────────────
# These creds ALSO authorize the Anthropic-key fetch from Secrets Manager (see
# below). On the box the D2 task role supplies creds; locally set them here.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_RESUME_BUCKET=

# ── certbot DNS-01 credentials (Front-Door PR-2 / PR-0 Ruling 7) ─────────────
# The DEDICATED certbot IAM principal from PR-0 (aramo-certbot-dns) — kept
# SEPARATE from the box-wide AWS_* app creds above. Generated out-of-band per
# doc/runbooks/frontdoor-pr0-apply.md and staged into the box .env. The certbot
# service maps these onto the AWS_ACCESS_KEY_ID/SECRET the dns-route53 plugin
# reads (see docker-compose.prod.yml). Least-privilege: TXT / _acme-challenge.
# aramo.ai only. AWS_REGION above is reused.
CERTBOT_AWS_ACCESS_KEY_ID=
CERTBOT_AWS_SECRET_ACCESS_KEY=

# ── Email / SES (transactional mailer — Email-S1) ───────────────────────────
# MAILER_PROVIDER selects the mailer adapter. REQUIRED (no default → an unset
# value fails LOUD at module binding, so email can't be silently dropped):
#   ses  — real SES send (prod). Requires SES_FROM_ADDRESS + the api principal's
#          ses:SendEmail grant (infrastructure-lightsail/ses-mailer-iam.json).
#   stub — log-only, no network (local/dev). Logs at WARN that nothing was sent.
# SES_FROM_ADDRESS is the fixed sender (callers never choose). The adapter
# passes it verbatim to SES FromEmailAddress, so it accepts RFC-5322
# display-name format ("Aramo Support <support@aramo.ai>"). The IAM
# ses:FromAddress condition keys on the ADDRESS part only (support@aramo.ai),
# so the display name does not affect the grant. Reuses AWS_REGION above
# (us-east-1) + the same default-chain creds as the S3 resume adapter.
# NOTE: double-quote it — the box sources this via `set -a && source .env`,
# so the spaces + angle brackets must be quoted or shell parsing breaks.
MAILER_PROVIDER=ses
SES_FROM_ADDRESS="Aramo Support <support@aramo.ai>"

# ── E-Sign Operational Closure v2 (signer delivery + lifecycle webhook) ─────
# SIGN_WEB_BASE_URL — the public Sign Web origin used to build signer URLs
# (sign-service appends the raw capability token in-memory; the token never
# leaves sign-service). Example: https://sign.aramo.ai
# DOCUMENTS_API_URL — the Aramo Core (apps/api) origin sign-service calls for the
# source-document pull AND the default base for the lifecycle webhook. On the box
# this is the compose service origin http://api:3000.
# SIGN_WEBHOOK_TARGET_URL — optional explicit override for the Core webhook
# receiver; defaults to ${DOCUMENTS_API_URL}/v1/integrations/sign/events.
# SIGN_WEBHOOK_SIGNING_SECRET — shared HMAC secret. sign-service signs and Core
# verifies the lifecycle webhook with it. Unset ⇒ delivery fails closed (outbox
# retries) and the receiver returns 503. Set the SAME value for api + sign-service.
# ES-2: the same secret also signs sign-service → Core service requests (the
# source-document pull, scheme aramo-sign-s2s-v1, domain-separated from the
# webhook). Unset ⇒ sign-service sends no source request and Core's source route
# returns 503 ESIGN_SERVICE_AUTH_UNAVAILABLE — in EVERY mode.
# SIGN_S2S_AUTH_MODE — api only. `enforce` (default, intended production state):
# an unsigned/invalid sign-service request gets 401. `log` is a TEMPORARY deploy
# compatibility setting (serve + warn) and only takes effect together with
# SIGN_S2S_AUTH_LOG_UNTIL, an ISO-8601 end time in the future and at most 7 days
# ahead; otherwise the route enforces. Never leave `log` configured after rollout.
# SIGN_S2S_AUTH_MODE=enforce
# SIGN_S2S_AUTH_LOG_UNTIL=
# SIGN_SERVICE_URL — api only. The sign-service origin Core calls to create/send/
# remind/void envelopes (ATS RTR + Offer) and to pull executed artifacts for the
# completion write-back. On the box this is the compose service origin
# http://sign-service:3003 (compose service name + its PORT). Unset ⇒ the api falls
# back to http://localhost:3003, i.e. its OWN container, and every E-Sign call fails.
# SIGN_SERVICE_URL=http://sign-service:3003
# INTELLIGENCE_SERVICE_URL — api + talent-intake-worker (ATI-SEP-1). The Talent
# Intelligence origin; compose default http://talent-intelligence-service:3004
# (internal, no nginx route).
# INTELLIGENCE_SERVICE_URL=http://talent-intelligence-service:3004
#
# ── Talent Intelligence integration (ATI-SEP-1 T8, ADR-0036) — ALL OPTIONAL ──
# The ATS works with TI absent: leave these unset and the integration is inert
# (the publisher acknowledges every talent.* event with outcome TI_NOT_CONFIGURED).
# INTELLIGENCE_ATS_CLIENT_ID / INTELLIGENCE_ATS_CLIENT_SECRET — api + talent-intake-worker.
#   The ATS's client_credentials pair, provisioned in TI with
#   tools/intelligence-service-client.sh (--client-id aramo-ats --source-system ARAMO_ATS
#   --scopes intelligence:ingest,intelligence:read,intelligence:verify,intelligence:entitlements,intelligence:disputes,intelligence:proposals).
# INTELLIGENCE_ATS_CLIENT_ID=aramo-ats
# INTELLIGENCE_ATS_CLIENT_SECRET=
# INTELLIGENCE_WEBHOOK_SIGNING_SECRET — api (verifies) + talent-intelligence-service
#   (signs) the TI → ATS webhook; SAME value on both, >= 32 chars. Unset on the api ⇒
#   every delivery is refused 401; unset on TI ⇒ no delivery is sent.
# INTELLIGENCE_WEBHOOK_SIGNING_SECRET=
# INTELLIGENCE_VERIFICATION_ENABLED — api. "true" routes portal identifier
#   verification to TI (email one-time code). Default false; the legacy trust email
#   verification stays the live path until T10.
# INTELLIGENCE_VERIFICATION_ENABLED=false
# INTELLIGENCE_ENTITLEMENT_SYNC_INTERVAL_MS — talent-intake-worker; full REPLACE sync of
#   the `intelligence` capability to TI (default 900000; 0 disables).
# INTELLIGENCE_ENTITLEMENT_SYNC_INTERVAL_MS=900000
# INTELLIGENCE_INBOUND_SYNC_INTERVAL_MS — talent-intake-worker; TI webhook inbox drain
#   (default 5000; 0 disables).
# INTELLIGENCE_INBOUND_SYNC_INTERVAL_MS=5000
#
# talent-intelligence-service secrets (each >= 32 chars; unset ⇒ that surface answers
# 503 while the service keeps running):
# INTELLIGENCE_SERVICE_TOKEN_SECRET — signs the service tokens (token exchange + guard).
# INTELLIGENCE_SERVICE_TOKEN_SECRET=
# INTELLIGENCE_GOV_ID_TOKEN_KEY — keys the government-identifier HMAC tokens.
# INTELLIGENCE_GOV_ID_TOKEN_KEY=
# INTELLIGENCE_VERIFICATION_CODE_KEY — derives the one-time verification codes.
# INTELLIGENCE_VERIFICATION_CODE_KEY=
# talent-intelligence-service knobs (all optional; compose defaults shown):
# INTELLIGENCE_ATS_WEBHOOK_URL=http://api:3000/v1/integrations/intelligence/events
# INTELLIGENCE_OUTBOX_MAX_ATTEMPTS=10
# TI_CROSS_TENANT_READ_ENABLED=false   (tenant-scoped reads until Legal L-1)
# TI_OUTBOX_DRAIN_ENABLED=1
# TI_OUTBOX_DRAIN_INTERVAL_MS=5000
# TI_REASSESSMENT_ENABLED=1
# TI_REASSESSMENT_INTERVAL_MS=3600000
# TI_AVAILABILITY_FRESHNESS_DAYS=90
# Verification code mail: the TI service reuses MAILER_PROVIDER / SES_FROM_ADDRESS /
# AWS_REGION / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (documented above); with
# MAILER_PROVIDER unset its delivery adapter only logs.
# INTELLIGENCE_VERIFY_LINK_BASE — talent-intelligence-service (ATI-SEP-1 T10 WP4).
# OPTIONAL. The origin of the confirm-page link in the verification email:
# <base>/email-verifications/confirm?verification_id=<id> (the talent enters the
# 6-digit code there; the link never carries the code). TI does not know a tenant's
# host, so this is ONE configured origin (http/https). Unset ⇒ code-only email.
# INTELLIGENCE_VERIFY_LINK_BASE=https://app.aramo.ai
# Sign Unified Product S-2 — ARAMO_SIGN_BASE_URL is the ONE Sign origin: signer
# links (/s/…), signed-copy links (/d/…), console links (/sign/…) and billing
# return URLs. SIGN_WEB_BASE_URL then SIGN_SENDER_WEB_BASE_URL are fallbacks.
# ARAMO_SIGN_BASE_URL=https://sign.aramo.ai
# SIGN_WEB_BASE_URL=https://sign.aramo.ai
# Aramo Sign launch (sign-service, all optional):
# SIGN_SENDER_WEB_BASE_URL — the Sign console origin linked from sender emails
# (completion / decline / expiry). Unset ⇒ those emails carry no console link.
# SIGN_ENVELOPE_TTL_DAYS — days a sent envelope stays signable before the expiry
# sweep moves it to EXPIRED (default 30). Signer links still expire after 7 days
# unless a reminder re-issues them.
# SIGN_EXECUTED_ACCESS_TTL_DAYS — lifetime of the signer's signed-copy download
# link from the completion email (default 30).
# SIGN_EXPIRY_WORKER_ENABLED — 0 disables the expiry sweep (default enabled).
# SIGN_EXPIRY_INTERVAL_MS — sweep interval (default 300000 = 5 minutes).
# SIGN_SENDER_WEB_BASE_URL=   (pre-S-2; superseded by ARAMO_SIGN_BASE_URL)
# SIGN_ENVELOPE_TTL_DAYS=30
# SIGN_EXECUTED_ACCESS_TTL_DAYS=30
# SIGN_EXPIRY_WORKER_ENABLED=1
# SIGN_EXPIRY_INTERVAL_MS=300000
# SIGN_INVITATION_WORKER_ENABLED — 0 disables the retry of undelivered sequential
#   next-signer invitations (default enabled; the first delivery happens inline).
# SIGN_INVITATION_INTERVAL_MS — retry interval (default 60000 = 1 minute).
# SIGN_INVITATION_WORKER_ENABLED=1
# SIGN_INVITATION_INTERVAL_MS=60000
# SIGN_NOTIFICATION_WORKER_ENABLED — 0 pauses the mobile notification worker (drains the
#   notification outbox into in-app feed rows and push jobs; default enabled). Paused in
#   production until Privacy Notice 1.1 is effective (Lead Architect 2026-10-26). While
#   paused, envelope events still add identifier-only outbox rows; nothing reaches the
#   feed or push until it is re-enabled.
# SIGN_NOTIFICATION_INTERVAL_MS — tick interval (default 5000; minimum 500).
# SIGN_NOTIFICATION_WORKER_ENABLED=1
# SIGN_NOTIFICATION_INTERVAL_MS=5000
# Aramo Sign launch — self-service billing (sign-service; Stripe REST, no SDK).
# Unset STRIPE_SECRET_KEY ⇒ billing reports unavailable (503); nobody is charged.
# Use test-mode keys (sk_test_…) until live charging is separately authorized.
# STRIPE_SECRET_KEY — the Stripe API key (secret; never commit).
# STRIPE_WEBHOOK_SECRET — the signing secret of the webhook endpoint
#   https://sign.aramo.ai/v1/sign/billing/webhook/stripe (whsec_…). (A 301 from the
#   retired esign host is NOT followed by the billing provider.)
# STRIPE_PLAN_PRICES — sellable plan key → Stripe price id, comma-separated
#   (e.g. aramo-sign-standard-business-v1=price_…,aramo-sign-standard-professional-v1=price_…).
#   The Stripe price must match the catalog list price ($20 / $15 per month, USD).
# (CCP-C5) Tax is not enabled: no setting turns on Stripe Tax before registration; enabling it is
#   a future release with its own authorization. The former STRIPE_AUTOMATIC_TAX opt-in is removed.
# BILLING_PAST_DUE_GRACE_DAYS — days a past-due subscription keeps sending (default 7).
# SIGN_BILLING_RECONCILE_ENABLED — 1 re-fetches open subscriptions on an interval.
# SIGN_BILLING_RECONCILE_INTERVAL_MS — default 3600000 (1 hour; minimum 60000).
# SIGN_BILLING_COMMANDS_ENABLED — CCP-C1: 1 runs the Stripe command outbox + webhook inbox
#   worker (dispatch approved commands, re-fetch pending ones, drain the inbox). Default off.
#   It never dispatches with no key or with a live-mode key (production hold).
# SIGN_BILLING_COMMANDS_INTERVAL_MS — default 60000 (minimum 10000).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PLAN_PRICES=
# BILLING_PAST_DUE_GRACE_DAYS=7
# SIGN_BILLING_RECONCILE_ENABLED=1
# SIGN_BILLING_RECONCILE_INTERVAL_MS=3600000
# SIGN_BILLING_COMMANDS_ENABLED=0
# SIGN_BILLING_COMMANDS_INTERVAL_MS=60000
# SIGN_KMS_KEY_ID — KMS asymmetric key (SIGN_VERIFY) that signs E-Sign evidence
#   manifests. REQUIRED in production (SX-1 item 4): sign-service refuses to boot
#   with NODE_ENV=production and this unset, or when the key is not an enabled
#   asymmetric SIGN_VERIFY key (DescribeKey at boot — needs kms:DescribeKey,
#   kms:Sign; kms:Verify/kms:GetPublicKey for verification). Non-production
#   without it uses the in-process software digest signer. Provisioned by IaC.
# SIGN_KMS_SIGNING_ALGORITHM — optional; default chosen from the key spec
#   (ECC_NIST_P256 → ECDSA_SHA_256, RSA_* → RSASSA_PSS_SHA_256). Must be one the
#   key supports, else boot is refused.
# SIGN_KMS_KEY_ID=
# Aramo-Sign-Executed-Artifact-Custody-and-Isolation-Directive-v1_0 SX-2 (sign-service ONLY).
# SIGN_ARTIFACT_BUCKET — the dedicated Sign artifact bucket (aramo-prod-sign-artifacts-use1).
#   Unset ⇒ dark: OWNED sources stay in S3_RESUME_BUCKET, no custody upload/reconcile.
#   Setting it is the credential-switch checkpoint (needs separate PO authorization).
# SIGN_ARTIFACT_AWS_ACCESS_KEY_ID / SIGN_ARTIFACT_AWS_SECRET_ACCESS_KEY — the Sign-only
#   IAM user (aramo-sign-prod); both or neither. Unset ⇒ the AWS SDK default chain.
# SIGN_ARTIFACT_AWS_REGION — default AWS_REGION, then us-east-1.
# SIGN_ARTIFACT_RETENTION_DAYS — Object Lock GOVERNANCE retention in days. NO default
#   (LC-1): unset/empty ⇒ no retention applied. Must be a positive integer, else
#   sign-service refuses to boot. Activation needs the Legal/PO retention disposition.
# SIGN_ARTIFACT_S3_ENDPOINT — local/LocalStack only; unset in production.
# SIGN_ARTIFACT_RECONCILE_INTERVAL_MS — custody reconcile tick (default 600000; min 60000).
# SIGN_ARTIFACT_BUCKET=
# SIGN_ARTIFACT_AWS_ACCESS_KEY_ID=
# SIGN_ARTIFACT_AWS_SECRET_ACCESS_KEY=
# SIGN_ARTIFACT_AWS_REGION=
# SIGN_ARTIFACT_RETENTION_DAYS=
# SIGN_ARTIFACT_S3_ENDPOINT=
# SIGN_ARTIFACT_RECONCILE_INTERVAL_MS=600000
# Sign Unified Product S-5 — SIGN_WEBHOOK_SECRET_KEY encrypts each webhook
#   subscription's own signing secret at rest (32 random bytes, base64:
#   `openssl rand -base64 32`). Unset ⇒ webhook subscriptions are unavailable.
#   Never reuse SIGN_WEBHOOK_SIGNING_SECRET. Rotating it invalidates stored secrets.
# SIGN_WEBHOOK_SECRET_KEY=
# Aramo Sign Mobile (M-A3 §2) — push notifications (sign-service). Off by default.
#   Production use needs separate authorization (directive §11/§14: Privacy
#   Notice v1.1, APNs/FCM subprocessors, Apple/Firebase credentials).
# SIGN_PUSH_DELIVERY — disabled (default; nothing is sent) | log (logs type and
#   provider only) | apns | fcm | apns,fcm. A provider with incomplete settings stays off.
# SIGN_PUSH_TOKEN_KEY — 32 random bytes, base64 (openssl rand -base64 32); encrypts
#   device push tokens at rest (AES-256-GCM). Unset ⇒ no device can register (503).
#   Secret; never commit.
# APNS_KEY_ID — the APNs auth key id (JWT kid). APNS_TEAM_ID — the Apple team id.
# APNS_TOPIC — the iOS bundle id (ai.aramo.sign).
# APNS_ENVIRONMENT — production (default) | sandbox (development builds).
# APNS_KEY_PATH — the .p8 key inside the container; default
#   /opt/aramo/secrets/apns-key.p8 (host /opt/aramo/secrets is mounted read-only).
# FCM_PROJECT_ID — the Firebase project id.
# FCM_SERVICE_ACCOUNT_PATH — the service-account JSON inside the container; default
#   /opt/aramo/secrets/fcm-service-account.json.
# SIGN_PUSH_DELIVERY=disabled
# SIGN_PUSH_TOKEN_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=
# APNS_ENVIRONMENT=
# APNS_KEY_PATH=
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_PATH=
# Privacy Notice 1.1 remediation (E-1 to E-4) — retention cleanup (sign-service).
#   OFF by default. Enabling it in production needs separate PO authorization.
# SIGN_RETENTION_WORKER_ENABLED — 1 runs the retention worker: E-1 deletes a user's
#   convenience data (saved signatures, contacts, notification feed and preferences,
#   push devices and jobs) about one day after the user is removed or deactivated, the
#   organization closes, or an operator records a verified request
#   (sign."SignConvenienceDeletionRequest"); E-2 deletes Sign native sessions and
#   revoked push devices 180 days after termination; E-3 deletes request-idempotency
#   records once their 24-hour window has closed. A tenant under legal hold
#   (identity."Tenant".legal_hold) is skipped by E-1, E-2 and E-4. Signing records,
#   executed documents, certificates and ledger events are never touched.
# SIGN_RETENTION_QUEUE_CLEANUP_ENABLED — 1 also runs E-4: deletes processed notification
#   outbox rows and finished push jobs 30 days after they finish. Default off.
# SIGN_RETENTION_INTERVAL_MS — default 3600000 (1 hour; minimum 60000).
# SIGN_RETENTION_WORKER_ENABLED=0
# SIGN_RETENTION_QUEUE_CLEANUP_ENABLED=0
# SIGN_RETENTION_INTERVAL_MS=3600000
# Aramo-Sign-Mobile-Amendment-M-A7 §3 — privacy requests (sign-service + platform-admin).
# SIGN_PRIVACY_DELETION_EXECUTION_ENABLED — OFF (0 / unset) by default. 1 lets a
#   deletion request execute: Sign sessions and refresh tokens revoked, convenience data
#   and never-sent drafts (with their stored files) deleted, a Personal account's tenant
#   closed and its sign-in identity retired only when nothing else uses it; a Business
#   member's Sign access removed. Legal hold always blocks it. With it OFF requests are
#   received, validated, inventoried and queued for the privacy team; nothing is deleted.
#   PRODUCTION ENABLEMENT NEEDS SEPARATE AUTHORIZATION (amendment §8).
# PRIVACY_REQUEST_EMAIL_KEY — 32 random bytes, base64 (openssl rand -base64 32); keyed
#   hash + AES-256-GCM of a web requester's email. Same value on sign-service and
#   platform-admin. Unset ⇒ https://sign.aramo.ai/delete-account answers "unavailable"
#   (fail closed). Rotating it makes earlier requests unreadable to the queue.
# SIGN_PRIVACY_DELETION_EXECUTION_ENABLED=0
# PRIVACY_REQUEST_EMAIL_KEY=
# Aramo Sign Unified Product — Addendum S6 (api): the ATS as a Sign API client.
# SIGN_ATS_TRANSPORT — internal (default, the existing internal path) | api (the
#   authenticated Sign API; activation is separately authorized).
# SIGN_ATS_CLIENT_ID / SIGN_ATS_CLIENT_SECRET — the first-party aramo-ats credential
#   (`sign-integration.command.js first-party-credential aramo-ats`; secret shown once).
# SIGN_EVENTS_SUBSCRIPTION_SECRET — the signing secret of the ATS webhook
#   subscription (`… first-party-webhook aramo-ats http://api:3000/v1/integrations/sign/events`).
# SIGN_ATS_TRANSPORT=internal
# SIGN_ATS_CLIENT_ID=
# SIGN_ATS_CLIENT_SECRET=
# SIGN_EVENTS_SUBSCRIPTION_SECRET=
# SIGN_KMS_SIGNING_ALGORITHM=ECDSA_SHA_256
# Commercial Plans Amendment A1 (sign-service; inactive until approved):
# SIGN_DISCLOSURE_VERSION — signer disclosure served (default v1; v2 is the
#   legal-pending consent draft — switching needs legal approval).
# SIGN_POST_TERMINATION_EXPORT_DAYS — export window after a subscription ends
#   (proposed 90; leave unset until the retention policy is approved).
# SIGN_SALES_CONTACT_URL — Enterprise "Contact sales" link (https: or mailto:).
# SIGN_DISCLOSURE_VERSION=v1
# SIGN_POST_TERMINATION_EXPORT_DAYS=
# SIGN_SALES_CONTACT_URL=
# SIGN_PROFESSIONAL_ELIGIBILITY — ATS_ENTITLEMENT makes Standard Professional
#   available to ACTIVE tenants holding the ats entitlement. Unset ⇒ nobody is
#   eligible (the qualifying-ATS rule awaits PO confirmation).
# STRIPE_PORTAL_CONFIGURATION — Stripe billing-portal configuration id (bpc_…)
#   whose cancellation settings match the approved annual terms. Unset ⇒ the
#   portal is refused for 12-month-commitment plans.
# SIGN_PROFESSIONAL_ELIGIBILITY=
# STRIPE_PORTAL_CONFIGURATION=
# Aramo Sign launch — public self-service BUSINESS signup (platform-admin).
# SIGN_PUBLIC_SIGNUP_ENABLED — 1 opens /v1/signup/sign/* on sign.aramo.ai
#   (default closed: every route answers 404). Needs separate authorization.
# Signup terms come from the versioned legal registry in code (A1); nothing is
#   approved yet, so no terms are offered. There is no env override.
# SIGN_PUBLIC_SIGNUP_ENABLED=0
# Sign Signup Amendment A1 §2.3 — address autocomplete (platform-admin proxies the
#   provider; key never sent to the browser). Unset ⇒ manual entry only. Add the
#   provider to the published subprocessor list before public signup.
# SIGN_ADDRESS_PROVIDER=geoapify
# SIGN_ADDRESS_PROVIDER_KEY=
# CCP-D3 — opt-in operational alert scanner (platform-admin): raises and resolves the
#   operator alert register (GET /platform/commercial/alerts/*) for failed and stuck
#   Stripe commands, failed webhook inbox events, held activations, usage roll-ups that
#   did not reconcile, failed applies and approvals near or past expiry. Off unless 1
#   (recovery = leave it off; the register is derived). Read-only on every source table;
#   one JSON log line per raised / resolved alert (ccp_alert_raised / ccp_alert_resolved)
#   and per scan (ccp_alert_scan); no external paging. Enabling it in production needs
#   its own authorization (CCP Program Build Directive section 12).
#   CCP_ALERTS_INTERVAL_MS default 300000 (5 min), minimum 10000.
#   CCP_ALERT_PENDING_PROVIDER_STUCK_MINUTES default 1440: a command accepted by the
#   provider and not confirmed for this long raises COMMAND_PENDING_PROVIDER_STUCK.
#   CCP_ALERT_APPROVAL_EXPIRY_LEAD_MINUTES default 720: a request awaiting approval whose
#   expiry falls within this lead raises APPROVAL_NEARING_EXPIRY. Both are operational
#   alerting settings (1-43200 minutes), not commercial policy; the 72 h approval expiry
#   stays the active policy's.
# CCP_ALERTS_ENABLED=0
# CCP_ALERTS_INTERVAL_MS=300000
# CCP_ALERT_PENDING_PROVIDER_STUCK_MINUTES=1440
# CCP_ALERT_APPROVAL_EXPIRY_LEAD_MINUTES=720
# Domain-Enforcement P3 — opt-in sweep (platform-admin) that lapses expired
#   PROVISIONAL domain claims. Off unless 1; an expired claim also lapses on the
#   next claim attempt for its domain. Interval default 3600000 (1 hour).
# DOMAIN_CLAIM_SWEEP_ENABLED=0
# DOMAIN_CLAIM_SWEEP_INTERVAL_MS=3600000
# CCP-D1 — opt-in usage roll-up worker (platform-admin): derived per-tenant consumption
#   roll-ups from the Sign allowance ledger, read-only until their totals reconcile.
#   Off unless 1 (recovery = leave it off; roll-ups are derived and rebuildable with
#   npm run usage:rollup -- --rebuild). Enabling it in production needs its own
#   authorization (CCP Program Build Directive section 12). Interval default 3600000 (1 hour).
# CCP_USAGE_ROLLUP_ENABLED=0
# CCP_USAGE_ROLLUP_INTERVAL_MS=3600000
# Sign Personal (Free) Launch v1.1 (LOCKED) — Personal signup (platform-admin).
# SIGN_PERSONAL_SIGNUP_MODE — off (default: every /v1/signup/sign/personal/* route
#   404s and Personal sending stays refused) | invite (pilot) | open (public).
#   Switching off→invite / invite→open needs the §10 authorizations.
# SIGN_PERSONAL_SIGNUP_MODE=off
# SIGN_PERSONAL_PILOT_CAP=10
# SIGN_PERSONAL_ALLOWED_COUNTRIES=US,IN
# Risk-rating overrides (JSON; points / thresholds / fast_form_ms / ip_signups_*).
# SIGN_PERSONAL_RISK_CONFIG=
# Offline MaxMind GeoLite2 databases in /opt/aramo/geoip on the box (compose mounts
#   it read-only at /geoip in platform-admin AND sign-service; the paths below are the
#   compose defaults). Architect ruling 2026-10-21: the network country is a RISK
#   SIGNAL only, never proof of residence and never a block by itself. Missing /
#   unreadable ⇒ UNKNOWN ⇒ risk points (ip_country_unknown), not a refusal. Each risk
#   decision records the country, lookup time and database version.
# SIGN_GEOIP_DB_PATH=/geoip/GeoLite2-Country.mmdb
# SIGN_GEOIP_ASN_DB_PATH=/geoip/GeoLite2-ASN.mmdb
# MaxMind geoipupdate keeps those two files current (GeoLite2-Country +
#   GeoLite2-ASN, checked every 72 hours, replaced in place). It is a SEPARATE
#   compose project, deploy/geoip/docker-compose.geoip.yml — the prod stack never
#   starts it. SECRETS: set the MaxMind account id + license key ONLY in the box
#   /opt/aramo/.env (never Git), then:
#   docker compose -p aramo-geoip --env-file /opt/aramo/.env -f deploy/geoip/docker-compose.geoip.yml up -d
# GEOIPUPDATE_ACCOUNT_ID=
# GEOIPUPDATE_LICENSE_KEY=
# Extra send-time wording for young Personal accounts (sign-service; comma-separated).
# SIGN_PERSONAL_SEND_WORDING=
# Phone verification delivery: unset ⇒ disabled (a step-up signup goes to review;
#   an operator clearing that review lifts the phone step but never marks the phone
#   verified). `log` is for dev/test only. Real providers need their own authorization.
# SIGN_SMS_PROVIDER=
# Cloudflare Turnstile server secret. Unset ⇒ every Personal signup is refused.
# SIGN_TURNSTILE_SECRET=
# Cloudflare Turnstile public site key — an nginx IMAGE BUILD arg (baked into the
# Sign bundle); set it before `compose build nginx`. Unset ⇒ no widget shown.
# SIGN_TURNSTILE_SITE_KEY=
# Opt-in sweep that soft-disables unbound PROVISIONED Personal tenants after 7 days.
# SIGN_PERSONAL_LAPSE_SWEEP_ENABLED=0
# SIGN_PERSONAL_LAPSE_SWEEP_INTERVAL_MS=3600000
# Personal signup-attempt cleanup, hourly. Abandoned attempts (never completed: no
# account was created and no terms were accepted) are deleted 3 days after the attempt
# expired (an attempt expires 24 h after it started). Refused attempts are kept 180 days
# as security evidence, then deleted. Started-provisioning, provisioned and lapsed
# attempts are never deleted. ON by default (unset ⇒ on); `0` turns it off. Every run
# logs {"event":"personal_signup_attempt_purge","abandoned":a,"refused":r,...}.
# SIGN_PERSONAL_SIGNUP_PURGE_ENABLED=1
# SIGN_PERSONAL_SIGNUP_PURGE_INTERVAL_MS=3600000
# DOCUMENTS_API_URL=http://api:3000
# SIGN_WEBHOOK_TARGET_URL=
# SIGN_WEBHOOK_SIGNING_SECRET=

# ── DNS resolver for domain verification (Domain-Enforcement P2b) ───────────
# Selects the DNS resolver the domain-ownership (DNS-TXT) check uses. REQUIRED
# (no default → loadDnsConfig fails LOUD at module binding if unset, so the api
# can't silently "verify" nothing):
#   node — real DNS lookups via Node's built-in dns (prod).
#   stub — canned records, no network (local/dev/test).
# (DNS_RECORD_PREFIX / DNS_VALUE_PREFIX are optional overrides with sane
# defaults — '_aramo-challenge' / 'aramo-domain-verification=' — set only to
# change the challenge record name/value prefix.)
DNS_PROVIDER=node

# ── Invite links (Invite-S2 / Pattern-2 invite flow) ────────────────────────
# The invite email's accept link points at the FE acceptance page (which POSTs
# the token to the public POST /v1/invitations/accept endpoint); the
# acceptance-confirmation email points at the sign-in page. Both fall back to a
# localhost default if unset (dev), so set the box origin in prod.
#   Box: INVITE_ACCEPT_URL=https://astre.aramo.ai/invitations/accept
#        INVITE_SIGNIN_URL=https://astre.aramo.ai/login
INVITE_ACCEPT_URL=https://astre.aramo.ai/invitations/accept
INVITE_SIGNIN_URL=https://astre.aramo.ai/login

# ── Anthropic API key — PER-TENANT (TENANT-LLM-1), NOT an env var ────────────
# The codebase does NOT read ANTHROPIC_API_KEY in prod/staging. Each tenant
# BRINGS ITS OWN key, fetched at runtime from AWS Secrets Manager at the
# tenant-scoped secret id `aramo/${ARAMO_ENV}/tenant-llm/<tenant_id>/anthropic-api-key`
# (libs/ai-draft SecretCacheService), authorized by the AWS_* creds above. A
# tenant with no key fails CLOSED to a governed "LLM not configured" state — there
# is NO platform-wide key and NO cross-tenant fallback. Keys are set via the admin
# path (Settings → Integrations → AI/LLM → Anthropic), write-only.
# (LOCAL DEV ONLY: ARAMO_ENV=local may set a single ANTHROPIC_API_KEY for the one
# dev tenant; this fallback is hard-gated to `local` and never applies here.)

# ── Address autocomplete ────────────────────────────────────────────────────
ADDRESS_AUTOCOMPLETE_ENABLED=true
ADDRESS_AUTOCOMPLETE_PROVIDER=google
GOOGLE_PLACES_API_KEY=

# ── Microsoft 365 delegated OAuth "Connect" (D-INT-1) ────────────────────────
# The per-recruiter "Connect" (delegated OAuth) authorize/START step reads these
# two (apps/api microsoft-config.resolver.ts + libs/microsoft-graph oauth-state).
# ABSENT → never reaches the api container → the start step 500s and the recruiter
# sees "We couldn't start the Microsoft connection. Please try again."
#   MSGRAPH_REDIRECT_URI  — the api callback, https://<prod-api-host>/v1/integrations/
#     microsoft/callback — must BYTE-MATCH a Web redirect registered on the Entra app
#     for the tenant's client_id (already registered for astre.aramo.ai).
#   MSGRAPH_OAUTH_STATE_KEY — 32 random bytes base64url, e.g.
#     openssl rand -base64 32 | tr '+/' '-_' | tr -d '=' . Signs only in-flight OAuth
#     `state` (no stored data); a fresh value is safe to rotate.
MSGRAPH_REDIRECT_URI=
MSGRAPH_OAUTH_STATE_KEY=

# ── Import engine ───────────────────────────────────────────────────────────
IMPORT_FAILURE_THRESHOLD_PCT=20

# ── Identity fingerprint pepper (Step 4b / ADR-0016) ─────────────────────────
# The platform secret keying the cross-tenant email fingerprint (HMAC over this
# pepper), held SEPARATE from the DB. REQUIRED — api's loadIdentityPepper and
# auth-service's Portal-P1 eligibility fingerprint BOTH fail LOUD if unset, so
# canonicalization / portal eligibility STOP rather than mis-resolving with an
# unkeyed fingerprint. SHARED by api + auth-service — the value MUST match, so it
# is single-sourced via the *identity_pepper YAML anchor in docker-compose.prod.yml
# (one var, one .env value, the two passthroughs cannot drift). Migrate to KMS/HSM
# later. Must appear as a bare-name passthrough in BOTH the api and auth-service
# `environment:` blocks — a var read by container code but absent from the
# passthrough never reaches the container (the D-AUTH-PLATFORM-HOSTS-1 defect class).
ARAMO_IDENTITY_PEPPER=

# ── Identity index admission policy (TR-2b B1 / Ruling D15) ──────────────────
# Platform-global switch gating the cross-tenant identity_index aperture-1
# fingerprint mint. Closed vocabulary: PORTABLE_ONLY | ALL_ARRIVALS; frozen
# behind a switch per Decision 15 (ALL_ARRIVALS enters pre-switch history ONLY
# via the audited backfill command, never silent retro-ingestion). REQUIRED —
# api-only; loadIdentityAdmissionPolicy fails LOUD on the canonicalization mint
# path if unset/unknown. Launch value: PORTABLE_ONLY.
ARAMO_IDENTITY_ADMISSION_POLICY=PORTABLE_ONLY

# Indeed Apply inbound webhook secret (SRC-1 PR-2 / R9). The partner-provisioned
# Indeed Apply "api Secret" — the HMAC key the POST /v1/webhooks/indeed/apply
# endpoint uses to verify the X-Indeed-Signature header. api-only. UNSET →
# the endpoint refuses ALL traffic (503, dark by construction, R5); the webhook
# ships dark until the Indeed partnership is executed (SRC-2 turns it on). Set
# to the real secret only when a partner credential exists. Must also appear as
# a bare-name passthrough in docker-compose.prod.yml api `environment:` — a var
# read by container code but absent from the passthrough never reaches the
# container (the D-AUTH-PLATFORM-HOSTS-1 defect class).
ARAMO_INDEED_APPLY_WEBHOOK_SECRET=

# COMM-B6 — Zoom Phone webhook signing-secret REFERENCE. This is an OPAQUE Secrets
# Manager id (e.g. an ARN / secret name), NOT the raw secret: the app resolves it
# through Secrets Manager at the composition root and keeps the value memory-only
# (never Postgres, never API-visible, never logged). Dark by construction — unset
# or unresolvable → the Zoom webhook refuses all traffic (503). Must also appear as
# a bare-name passthrough in docker-compose.prod.yml api `environment:`.
ZOOM_WEBHOOK_SECRET_REF=

# SRC-2 PR-3 (R7) — Indeed Job Sync partner OAuth app credentials (platform-level,
# R5: ONE app for all tenants; NEVER per-tenant config). The freshness sweep is
# fail-closed: unset → the connector is disabled and the sweep skips every tick
# (one log line, no crash-loop). Set only when a partner credential exists. Must
# also appear as bare-name passthroughs in docker-compose.prod.yml api
# `environment:` (the D-AUTH-PLATFORM-HOSTS-1 defect class). api-only.
ARAMO_INDEED_CLIENT_ID=
ARAMO_INDEED_CLIENT_SECRET=
# OAuth scope (DEV-C), env-overridable. Default (employer_access) is applied in
# code when unset — set only if certification requires a different scope.
ARAMO_INDEED_OAUTH_SCOPE=
# GraphQL base URL (DEV-C), env-overridable. Default (https://apis.indeed.com/graphql)
# is applied in code when unset — set to the simulated GraphQL environment during
# certification without a code change.
ARAMO_INDEED_GRAPHQL_BASE=

# ADR-0033 — Talent Intake durable-event transport.
#   singlebox   — single-box topology: the lease-safe outbox drain delivers
#                 directly to the in-process TalentIntakeMessageHandler (résumé
#                 extraction runs in the talent-intake-worker container). No
#                 EventBridge/SQS/Lambda, no TALENT_INTAKE_EVENT_BUS required.
#   eventbridge — distributed AWS path (requires TALENT_INTAKE_EVENT_BUS; stays
#                 fail-closed when the bus is unconfigured).
# Default is singlebox (set on both the api and talent-intake-worker services).
TALENT_INTAKE_TRANSPORT=singlebox

# ATI-SEP-1 A3 — the ATS talent outbox drain (talent.created / talent.profile_updated
# / talent.deleted / talent.erased → the in-process dispatcher). The compose PINS
# ATS_TALENT_EVENTS_DRAIN_ENABLED per service (talent-intake-worker=1, api=0) — it
# is not read from this file. Optional tuning for the worker (defaults shown; they
# equal the in-code defaults):
# ATS_TALENT_EVENTS_DRAIN_INTERVAL_MS=5000
# ATS_TALENT_EVENTS_DRAIN_LIMIT=25
# ATS_TALENT_EVENTS_LEASE_SECONDS=120
# ATS_TALENT_EVENTS_MAX_ATTEMPTS=10
