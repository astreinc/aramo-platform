# Aramo — Single-Box PROD env contract (example).
#
# The full env surface the prod stack (docker-compose.prod.yml) reads. Copy to a
# real `.env` on the box (or locally for provability) and fill in real values.
# NEVER commit a real `.env` or a real secret; no secret is ever baked into an
# image layer.
#
# How it's consumed (the proven multi-line-PEM-safe pattern from D1):
#   set -a && source .env && set +a
#   docker compose --env-file /dev/null -f docker-compose.prod.yml up -d
# Bare-name `environment:` entries in the compose pass through from this sourced
# shell env verbatim (multi-line PEM keys survive — compose never parses them).
#
# Values here are PLACEHOLDERS. This documents the prod surface only; the dev
# contract stays in .env.example.

# ── Front-door / nginx (TLS + domain parameterization, ADR-0023) ────────────
# nginx is the single ingress on 80/443; certbot owns the *.aramo.ai WILDCARD
# cert via DNS-01/Route53 (one cert covers every <slug>.aramo.ai — onboarding is
# a Tenant row, not infra). These four vars parameterize nginx's server_names +
# cert dir; unset → the template's LOCAL defaults (localhost / admin.localhost /
# portal.localhost / /etc/letsencrypt/live/aramo.ai) so the stack runs+tests on a
# laptop with mkcert and NO public domain. On the box set the wildcard + subdomain
# hosts (below). Bare-name passthrough — a var absent from the compose
# `environment:` reverts to local (the D-AUTH-PLATFORM-HOSTS-1 defect class).
NGINX_TENANT_SERVER_NAME=*.aramo.ai
NGINX_ADMIN_SERVER_NAME=admin.aramo.ai
NGINX_PORTAL_SERVER_NAME=candidate.aramo.ai
NGINX_CERT_DIR=/etc/letsencrypt/live/aramo.ai

# ── Backend images (D1 / ECR) ───────────────────────────────────────────────
# The D1 images are referenced, not rebuilt. Local default = the local D1 tags;
# on the box point these at the ECR tags (D2). Optional (defaults applied).
# ARAMO_API_IMAGE=aramo/api:local
# ARAMO_AUTH_IMAGE=aramo/auth-service:local
# Inc-3 PR-3.3 — the platform-admin image (built + published from main like the
# others). Local default = the local build tag; on the box point at the GHCR tag.
# ARAMO_PLATFORM_ADMIN_IMAGE=aramo/platform-admin:local

# ── Runtime ─────────────────────────────────────────────────────────────────
# NODE_ENV is forced to `production` by the compose for api + auth-service.
# ARAMO_ENV selects per-env resources (incl. the Secrets-Manager secret id for
# the Anthropic key — see below). Prod value:
ARAMO_ENV=prod

# ── Database (Postgres) ─────────────────────────────────────────────────────
# These configure the in-stack postgres service AND are interpolated into the
# api/auth DATABASE_URL (host pinned to the `postgres` service name) — they
# cannot drift. Use a real password on the box.
POSTGRES_USER=aramo
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=aramo
# Postgres + Redis are container-internal; their URLs are PINNED to the compose
# service names inside docker-compose.prod.yml — do NOT set DATABASE_URL /
# REDIS_URL here (the .env localhost values are unreachable in-container).

# ── Auth / Cognito (reused pool us-east-1_4fKlnGfaW) ────────────────────────
# auth-service reads these; api reads the subset it needs (audience, public key,
# tenant pool id, cognito endpoint); platform-admin reads audience + public key
# + BOTH pool ids (tenant-owner invites → tenant pool; platform-admin invites →
# platform pool) + cognito endpoint + AWS creds.
AUTH_AUDIENCE=
AUTH_COGNITO_DOMAIN=
AUTH_COGNITO_CLIENT_ID=
AUTH_COGNITO_ISSUER=
AUTH_COGNITO_TENANT_USER_POOL_ID=
# Inc-3 PR-3.3 — the PLATFORM Cognito user pool (platform-admin invitations mint
# platform operators here; distinct from the tenant pool above). Required by
# platform-admin only.
AUTH_COGNITO_PLATFORM_USER_POOL_ID=
AUTH_COGNITO_ENDPOINT=
# PR-3.1 (host-derived base): the callback/post-login/signout bases now DERIVE
# from the request's VALIDATED host FIRST (tenant host via findActiveBySlug,
# platform host via AUTH_PLATFORM_HOSTS, or localhost under dev posture), so
# astre.aramo.ai + admin.aramo.ai + both localhost consoles work concurrently
# with the envs below UNSET. The envs remain the escape hatch for unvalidated
# hosts (and existing single-console prod). A raw Host never reaches a redirect.
#
# AUTH_PLATFORM_HOSTS — comma-separated exact platform console hosts (lowercased,
# port-stripped) whose login derives an https base. Prod default: admin.aramo.ai.
AUTH_PLATFORM_HOSTS=admin.aramo.ai
# Portal P1 — AUTH_PORTAL_HOSTS: the portal host class (sibling to platform),
# the exact host(s) whose passwordless login derives an https base. On the box:
# candidate.aramo.ai. PORTAL_LOGIN_BASE_URL is the magic-link base (the portal
# origin) used when a request host is not a validated portal host.
AUTH_PORTAL_HOSTS=candidate.aramo.ai
PORTAL_LOGIN_BASE_URL=https://candidate.aramo.ai
# AUTH_SIGNOUT_PATH — the path appended to a DERIVED base for the post-logout
# landing (default '/'). Used only when a host validates; unvalidated hosts fall
# back to the full-URL envs below.
AUTH_SIGNOUT_PATH=/
# D-ORG-2 (topology T1) — the post-login landing is PER CONSUMER and built in:
# recruiter → /ats/ (the ATS app), org → / (App Home), esign/platform/portal → /.
# Override ONE consumer explicitly with AUTH_POST_LOGIN_PATH_<CONSUMER> (passed
# through to auth-service by compose). The legacy global AUTH_POST_LOGIN_PATH is
# RETIRED for the known consumers (it never overrides a built-in base) — do not set it.
# AUTH_POST_LOGIN_PATH_RECRUITER=/ats/
# AUTH_POST_LOGIN_PATH_ORG=/
# AUTH_POST_LOGIN_PATH_ESIGN=/   (the Sign console root on esign.aramo.ai; it routes to /sign/ or /personal/)
# PX-1 — the App Home Sign tile stays DARK until ARAMO_SIGN_ENTRY_ENABLED=true (api). Its target is the
# product host https://esign.aramo.ai/ (override with ARAMO_SIGN_ENTRY_URL). Neither is set for release.
# ARAMO_SIGN_ENTRY_ENABLED=false
# ARAMO_SIGN_ENTRY_URL=https://esign.aramo.ai/
# The public origin the browser reaches the app on. Fallback for UNVALIDATED
# hosts (host-derivation wins when the host validates). auth-service derives the
# hosted-UI callback per consumer as ${AUTH_PUBLIC_BASE_URL}/auth/<consumer>/callback
# at authorize + token-exchange (Amendment v1.2 Workstream D). Each derived URL
# must be a registered callback on the app client. The recruiter derivation
# matches the currently-registered prod URL (https://astre.aramo.ai/auth/recruiter/callback).
# Box: https://astre.aramo.ai
AUTH_PUBLIC_BASE_URL=
# DEPRECATED (Amendment v1.2): the single-valued full callback URL. Fallback only
# — if AUTH_PUBLIC_BASE_URL is unset, its ORIGIN is used as the base.
# Box (legacy): https://astre.aramo.ai/auth/recruiter/callback
AUTH_COGNITO_REDIRECT_URI=
# Where /auth/:consumer/callback 302s after a successful login for an UNVALIDATED
# host (a validated host derives ${base}${AUTH_POST_LOGIN_PATH}). Box: the app
# origin https://astre.aramo.ai.
AUTH_POST_LOGIN_REDIRECT=
# The registered post-logout return URL for an UNVALIDATED host (box:
# https://astre.aramo.ai/login).
AUTH_COGNITO_SIGNOUT_REDIRECT=
# Federated-IdP allow-list (comma-separated; e.g. Google,Microsoft).
AUTH_TRUSTED_IDP_NAMES=
AUTH_REFRESH_GRACE_SECONDS=60
# Leave UNSET/false in prod: cookies are Secure under HTTPS. (Forced
# Secure anyway when NODE_ENV=production, which the compose sets.)
AUTH_ALLOW_INSECURE_COOKIES=false
# IC-2 PR-4 — session tenant binding (one User = one tenant, bound to the host).
# AUTH_HOST_TENANT_BINDING=log (default when unset) records a structured
# diagnostic when the identity resolved at /callback does not belong to the host
# the user logged in on (tenant host ≠ owning tenant; platform host without the
# platform consumer/sentinel; portal/product host; unvalidated host; a PKCE
# cookie minted before this release) and leaves the login outcome UNCHANGED.
# AUTH_HOST_TENANT_BINDING=enforce DENIES those cases (403 TENANT_ACCESS_DENIED,
# no session minted). Switch to enforce only after every tenant that signs in on
# a tenant host carries a slug (Tenant.slug) and the registry/host envs above are
# correct — a wrong value here is a login outage for that host class.
AUTH_HOST_TENANT_BINDING=log
# AUTH_ALLOW_UNBOUND_HOST=true is the explicit DEV exception: under enforce it lets
# a dev/unvalidated host (no sealed host context) still mint a session. It never
# overrides an explicit tenant or platform mismatch. Leave UNSET/false in prod
# (fail-closed under enforce).
AUTH_ALLOW_UNBOUND_HOST=false
# IC-2 PR-4 (F-3) — AUTH_PRODUCT_HOSTS: the product-console host class (Sign
# sender console), exact-match allowlist like AUTH_PLATFORM_HOSTS. DARK scaffold:
# no auth route/Cognito callback exists for it yet and host binding refuses
# product-host login under enforce. Default when unset: esign.aramo.ai (registry
# seed row only). Leave UNSET until the product-host login is authorized.
AUTH_PRODUCT_HOSTS=

# ── JWT session signing (asymmetric PEM keys) ───────────────────────────────
# Multi-line PEM. Passed through verbatim via the sourced-shell pattern above.
# auth-service signs (private+public); api verifies (public only).
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=
AUTH_PKCE_STATE_KEY=

# ── AWS / S3 (resume + attachment storage) ──────────────────────────────────
# These creds ALSO authorize the Anthropic-key fetch from Secrets Manager (see
# below). On the box the D2 task role supplies creds; locally set them here.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_RESUME_BUCKET=

# ── certbot DNS-01 credentials (Front-Door PR-2 / PR-0 Ruling 7) ─────────────
# The DEDICATED certbot IAM principal from PR-0 (aramo-certbot-dns) — kept
# SEPARATE from the box-wide AWS_* app creds above. Generated out-of-band per
# doc/runbooks/frontdoor-pr0-apply.md and staged into the box .env. The certbot
# service maps these onto the AWS_ACCESS_KEY_ID/SECRET the dns-route53 plugin
# reads (see docker-compose.prod.yml). Least-privilege: TXT / _acme-challenge.
# aramo.ai only. AWS_REGION above is reused.
CERTBOT_AWS_ACCESS_KEY_ID=
CERTBOT_AWS_SECRET_ACCESS_KEY=

# ── Email / SES (transactional mailer — Email-S1) ───────────────────────────
# MAILER_PROVIDER selects the mailer adapter. REQUIRED (no default → an unset
# value fails LOUD at module binding, so email can't be silently dropped):
#   ses  — real SES send (prod). Requires SES_FROM_ADDRESS + the api principal's
#          ses:SendEmail grant (infrastructure-lightsail/ses-mailer-iam.json).
#   stub — log-only, no network (local/dev). Logs at WARN that nothing was sent.
# SES_FROM_ADDRESS is the fixed sender (callers never choose). The adapter
# passes it verbatim to SES FromEmailAddress, so it accepts RFC-5322
# display-name format ("Aramo Support <support@aramo.ai>"). The IAM
# ses:FromAddress condition keys on the ADDRESS part only (support@aramo.ai),
# so the display name does not affect the grant. Reuses AWS_REGION above
# (us-east-1) + the same default-chain creds as the S3 resume adapter.
# NOTE: double-quote it — the box sources this via `set -a && source .env`,
# so the spaces + angle brackets must be quoted or shell parsing breaks.
MAILER_PROVIDER=ses
SES_FROM_ADDRESS="Aramo Support <support@aramo.ai>"

# ── E-Sign Operational Closure v2 (signer delivery + lifecycle webhook) ─────
# ESIGN_SIGN_WEB_BASE_URL — the public Sign Web origin used to build signer URLs
# (esign-service appends the raw capability token in-memory; the token never
# leaves esign-service). Example: https://sign.aramo.ai
# DOCUMENTS_API_URL — the Aramo Core (apps/api) origin esign-service calls for the
# source-document pull AND the default base for the lifecycle webhook. On the box
# this is the compose service origin http://api:3000.
# ESIGN_WEBHOOK_TARGET_URL — optional explicit override for the Core webhook
# receiver; defaults to ${DOCUMENTS_API_URL}/v1/integrations/esign/events.
# ESIGN_WEBHOOK_SIGNING_SECRET — shared HMAC secret. esign-service signs and Core
# verifies the lifecycle webhook with it. Unset ⇒ delivery fails closed (outbox
# retries) and the receiver returns 503. Set the SAME value for api + esign-service.
# ES-2: the same secret also signs esign-service → Core service requests (the
# source-document pull, scheme aramo-esign-s2s-v1, domain-separated from the
# webhook). Unset ⇒ esign-service sends no source request and Core's source route
# returns 503 ESIGN_SERVICE_AUTH_UNAVAILABLE — in EVERY mode.
# ESIGN_S2S_AUTH_MODE — api only. `enforce` (default, intended production state):
# an unsigned/invalid esign-service request gets 401. `log` is a TEMPORARY deploy
# compatibility setting (serve + warn) and only takes effect together with
# ESIGN_S2S_AUTH_LOG_UNTIL, an ISO-8601 end time in the future and at most 7 days
# ahead; otherwise the route enforces. Never leave `log` configured after rollout.
# ESIGN_S2S_AUTH_MODE=enforce
# ESIGN_S2S_AUTH_LOG_UNTIL=
# ESIGN_SERVICE_URL — api only. The esign-service origin Core calls to create/send/
# remind/void envelopes (ATS RTR + Offer) and to pull executed artifacts for the
# completion write-back. On the box this is the compose service origin
# http://esign-service:3003 (compose service name + its PORT). Unset ⇒ the api falls
# back to http://localhost:3003, i.e. its OWN container, and every E-Sign call fails.
# ESIGN_SERVICE_URL=http://esign-service:3003
# ESIGN_SIGN_WEB_BASE_URL=https://sign.aramo.ai
# Aramo Sign launch (esign-service, all optional):
# ESIGN_SENDER_WEB_BASE_URL — the Sign console origin linked from sender emails
# (completion / decline / expiry). Unset ⇒ those emails carry no console link.
# ESIGN_ENVELOPE_TTL_DAYS — days a sent envelope stays signable before the expiry
# sweep moves it to EXPIRED (default 30). Signer links still expire after 7 days
# unless a reminder re-issues them.
# ESIGN_EXECUTED_ACCESS_TTL_DAYS — lifetime of the signer's signed-copy download
# link from the completion email (default 30).
# ESIGN_EXPIRY_WORKER_ENABLED — 0 disables the expiry sweep (default enabled).
# ESIGN_EXPIRY_INTERVAL_MS — sweep interval (default 300000 = 5 minutes).
# ESIGN_SENDER_WEB_BASE_URL=https://esign.aramo.ai
# ESIGN_ENVELOPE_TTL_DAYS=30
# ESIGN_EXECUTED_ACCESS_TTL_DAYS=30
# ESIGN_EXPIRY_WORKER_ENABLED=1
# ESIGN_EXPIRY_INTERVAL_MS=300000
# DOCUMENTS_API_URL=http://api:3000
# ESIGN_WEBHOOK_TARGET_URL=
# ESIGN_WEBHOOK_SIGNING_SECRET=

# ── DNS resolver for domain verification (Domain-Enforcement P2b) ───────────
# Selects the DNS resolver the domain-ownership (DNS-TXT) check uses. REQUIRED
# (no default → loadDnsConfig fails LOUD at module binding if unset, so the api
# can't silently "verify" nothing):
#   node — real DNS lookups via Node's built-in dns (prod).
#   stub — canned records, no network (local/dev/test).
# (DNS_RECORD_PREFIX / DNS_VALUE_PREFIX are optional overrides with sane
# defaults — '_aramo-challenge' / 'aramo-domain-verification=' — set only to
# change the challenge record name/value prefix.)
DNS_PROVIDER=node

# ── Invite links (Invite-S2 / Pattern-2 invite flow) ────────────────────────
# The invite email's accept link points at the FE acceptance page (which POSTs
# the token to the public POST /v1/invitations/accept endpoint); the
# acceptance-confirmation email points at the sign-in page. Both fall back to a
# localhost default if unset (dev), so set the box origin in prod.
#   Box: INVITE_ACCEPT_URL=https://astre.aramo.ai/invitations/accept
#        INVITE_SIGNIN_URL=https://astre.aramo.ai/login
INVITE_ACCEPT_URL=https://astre.aramo.ai/invitations/accept
INVITE_SIGNIN_URL=https://astre.aramo.ai/login

# ── Anthropic API key — PER-TENANT (TENANT-LLM-1), NOT an env var ────────────
# The codebase does NOT read ANTHROPIC_API_KEY in prod/staging. Each tenant
# BRINGS ITS OWN key, fetched at runtime from AWS Secrets Manager at the
# tenant-scoped secret id `aramo/${ARAMO_ENV}/tenant-llm/<tenant_id>/anthropic-api-key`
# (libs/ai-draft SecretCacheService), authorized by the AWS_* creds above. A
# tenant with no key fails CLOSED to a governed "LLM not configured" state — there
# is NO platform-wide key and NO cross-tenant fallback. Keys are set via the admin
# path (Settings → Integrations → AI/LLM → Anthropic), write-only.
# (LOCAL DEV ONLY: ARAMO_ENV=local may set a single ANTHROPIC_API_KEY for the one
# dev tenant; this fallback is hard-gated to `local` and never applies here.)

# ── Address autocomplete ────────────────────────────────────────────────────
ADDRESS_AUTOCOMPLETE_ENABLED=true
ADDRESS_AUTOCOMPLETE_PROVIDER=google
GOOGLE_PLACES_API_KEY=

# ── Microsoft 365 delegated OAuth "Connect" (D-INT-1) ────────────────────────
# The per-recruiter "Connect" (delegated OAuth) authorize/START step reads these
# two (apps/api microsoft-config.resolver.ts + libs/microsoft-graph oauth-state).
# ABSENT → never reaches the api container → the start step 500s and the recruiter
# sees "We couldn't start the Microsoft connection. Please try again."
#   MSGRAPH_REDIRECT_URI  — the api callback, https://<prod-api-host>/v1/integrations/
#     microsoft/callback — must BYTE-MATCH a Web redirect registered on the Entra app
#     for the tenant's client_id (already registered for astre.aramo.ai).
#   MSGRAPH_OAUTH_STATE_KEY — 32 random bytes base64url, e.g.
#     openssl rand -base64 32 | tr '+/' '-_' | tr -d '=' . Signs only in-flight OAuth
#     `state` (no stored data); a fresh value is safe to rotate.
MSGRAPH_REDIRECT_URI=
MSGRAPH_OAUTH_STATE_KEY=

# ── Import engine ───────────────────────────────────────────────────────────
IMPORT_FAILURE_THRESHOLD_PCT=20

# ── Identity fingerprint pepper (Step 4b / ADR-0016) ─────────────────────────
# The platform secret keying the cross-tenant email fingerprint (HMAC over this
# pepper), held SEPARATE from the DB. REQUIRED — api's loadIdentityPepper and
# auth-service's Portal-P1 eligibility fingerprint BOTH fail LOUD if unset, so
# canonicalization / portal eligibility STOP rather than mis-resolving with an
# unkeyed fingerprint. SHARED by api + auth-service — the value MUST match, so it
# is single-sourced via the *identity_pepper YAML anchor in docker-compose.prod.yml
# (one var, one .env value, the two passthroughs cannot drift). Migrate to KMS/HSM
# later. Must appear as a bare-name passthrough in BOTH the api and auth-service
# `environment:` blocks — a var read by container code but absent from the
# passthrough never reaches the container (the D-AUTH-PLATFORM-HOSTS-1 defect class).
ARAMO_IDENTITY_PEPPER=

# ── Identity index admission policy (TR-2b B1 / Ruling D15) ──────────────────
# Platform-global switch gating the cross-tenant identity_index aperture-1
# fingerprint mint. Closed vocabulary: PORTABLE_ONLY | ALL_ARRIVALS; frozen
# behind a switch per Decision 15 (ALL_ARRIVALS enters pre-switch history ONLY
# via the audited backfill command, never silent retro-ingestion). REQUIRED —
# api-only; loadIdentityAdmissionPolicy fails LOUD on the canonicalization mint
# path if unset/unknown. Launch value: PORTABLE_ONLY.
ARAMO_IDENTITY_ADMISSION_POLICY=PORTABLE_ONLY

# Indeed Apply inbound webhook secret (SRC-1 PR-2 / R9). The partner-provisioned
# Indeed Apply "api Secret" — the HMAC key the POST /v1/webhooks/indeed/apply
# endpoint uses to verify the X-Indeed-Signature header. api-only. UNSET →
# the endpoint refuses ALL traffic (503, dark by construction, R5); the webhook
# ships dark until the Indeed partnership is executed (SRC-2 turns it on). Set
# to the real secret only when a partner credential exists. Must also appear as
# a bare-name passthrough in docker-compose.prod.yml api `environment:` — a var
# read by container code but absent from the passthrough never reaches the
# container (the D-AUTH-PLATFORM-HOSTS-1 defect class).
ARAMO_INDEED_APPLY_WEBHOOK_SECRET=

# COMM-B6 — Zoom Phone webhook signing-secret REFERENCE. This is an OPAQUE Secrets
# Manager id (e.g. an ARN / secret name), NOT the raw secret: the app resolves it
# through Secrets Manager at the composition root and keeps the value memory-only
# (never Postgres, never API-visible, never logged). Dark by construction — unset
# or unresolvable → the Zoom webhook refuses all traffic (503). Must also appear as
# a bare-name passthrough in docker-compose.prod.yml api `environment:`.
ZOOM_WEBHOOK_SECRET_REF=

# SRC-2 PR-3 (R7) — Indeed Job Sync partner OAuth app credentials (platform-level,
# R5: ONE app for all tenants; NEVER per-tenant config). The freshness sweep is
# fail-closed: unset → the connector is disabled and the sweep skips every tick
# (one log line, no crash-loop). Set only when a partner credential exists. Must
# also appear as bare-name passthroughs in docker-compose.prod.yml api
# `environment:` (the D-AUTH-PLATFORM-HOSTS-1 defect class). api-only.
ARAMO_INDEED_CLIENT_ID=
ARAMO_INDEED_CLIENT_SECRET=
# OAuth scope (DEV-C), env-overridable. Default (employer_access) is applied in
# code when unset — set only if certification requires a different scope.
ARAMO_INDEED_OAUTH_SCOPE=
# GraphQL base URL (DEV-C), env-overridable. Default (https://apis.indeed.com/graphql)
# is applied in code when unset — set to the simulated GraphQL environment during
# certification without a code change.
ARAMO_INDEED_GRAPHQL_BASE=

# ADR-0033 — Talent Intake durable-event transport.
#   singlebox   — single-box topology: the lease-safe outbox drain delivers
#                 directly to the in-process TalentIntakeMessageHandler (résumé
#                 extraction runs in the talent-intake-worker container). No
#                 EventBridge/SQS/Lambda, no TALENT_INTAKE_EVENT_BUS required.
#   eventbridge — distributed AWS path (requires TALENT_INTAKE_EVENT_BUS; stays
#                 fail-closed when the bus is unconfigured).
# Default is singlebox (set on both the api and talent-intake-worker services).
TALENT_INTAKE_TRANSPORT=singlebox
