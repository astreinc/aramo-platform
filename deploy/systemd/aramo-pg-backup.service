# Aramo single-box — scheduled encrypted Postgres backup (M-A8 §1.2).
# Oneshot, fired by aramo-pg-backup.timer. Enabled on the box only at the M-A8 §4.2
# box-enablement checkpoint (doc/runbooks/RUNBOOK-backups.md §5): age installed, the
# public recipients file, the bucket applied from the Mac, the writer credential in
# /etc/aramo/backup.conf.
#
# /etc/aramo/backup.conf (root:root 0600):
#   BACKUP_S3_URI=s3://aramo-prod-db-backups-use1
#   BACKUP_KMS_KEY_ID=arn:aws:kms:us-east-1:<acct>:key/<id>   # terraform output backup_kms_key_arn
#   AWS_REGION=us-east-1
#   AWS_ACCESS_KEY_ID=…        # aramo-prod-backup-writer (put + list only)
#   AWS_SECRET_ACCESS_KEY=…
# /etc/aramo/backup-recipients.txt (root:root 0644): the two age1… PUBLIC recipients.
#
# Any failure (backup or prune) triggers aramo-pg-backup-failed.service, which uploads
# a FAILED heartbeat so the daily freshness check alerts.
#
# Install (PO-authorized):
#   sudo cp deploy/systemd/aramo-pg-backup{.service,.timer,-failed.service} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now aramo-pg-backup.timer
# Logs: journalctl -u aramo-pg-backup.service -u aramo-pg-backup-failed.service

[Unit]
Description=Aramo box Postgres backup (age-encrypted) → S3, then 7-day local prune
Requires=docker.service
After=docker.service aramo-singlebox.service
OnFailure=aramo-pg-backup-failed.service

[Service]
Type=oneshot
UMask=0077
Environment=ARAMO_DIR=/opt/aramo
EnvironmentFile=-/etc/aramo/backup.conf
ExecStart=/opt/aramo/deploy/backup/aramo-backup.sh --label scheduled
ExecStartPost=/opt/aramo/deploy/backup/aramo-backup-prune.sh
