# Aramo — nginx front-door server blocks (Front-Door Migration PR-2, ADR-0023).
#
# Walls translated VERBATIM from the retired front door's config (ADR-0023) (three host classes). The
# official nginx image runs envsubst over this template at container start; ONLY
# the four ${NGINX_*} vars are substituted (NGINX_ENVSUBST_FILTER=^NGINX_ at
# runtime; explicit var-list envsubst at build time) — every nginx runtime var
# ($host, $uri, $scheme, $proxy_add_x_forwarded_for, …) is left literal.
#
# Parameterization (Ruling 1) — defaults are the LOCAL posture (env-less = local),
# mirroring the retired front door's local defaults:
#   NGINX_TENANT_SERVER_NAME  (default localhost;       box *.aramo.ai)
#   NGINX_ADMIN_SERVER_NAME   (default admin.localhost; box admin.aramo.ai)
#   NGINX_PORTAL_SERVER_NAME  (default portal.localhost;box candidate.aramo.ai)
#   NGINX_CERT_DIR            (default /etc/letsencrypt/live/aramo.ai; local: a
#                             mounted mkcert dir). One shared WILDCARD cert
#                             (*.aramo.ai, no apex SAN — PR-0b R4) serves all three
#                             443 blocks. Upstreams are the compose service names,
#                             hardcoded exactly as the retired front door hardcoded them.
#
# TLS termination stays at the front door; nginx→backend is plain HTTP on the
# compose network (the retired front door's posture). DNS-01 only — no /.well-known/acme-challenge
# location (certbot solves the challenge via Route53, not HTTP-01).

# ── Tenant / wildcard host (tenant / wildcard host) ──────────────
server {
  listen 443 ssl;
  server_name ${NGINX_TENANT_SERVER_NAME};

  ssl_certificate     ${NGINX_CERT_DIR}/fullchain.pem;
  ssl_certificate_key ${NGINX_CERT_DIR}/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  # Ruling 3 — header contract, server-scoped so it applies to every proxied
  # location below (no location redefines proxy_set_header, so nginx inheritance
  # holds). Each line has a named consumer:
  #   Host                → tenant resolution by host across all three backends
  #   X-Forwarded-For     → the three per-IP budgets via PR-1 trust proxy = 1
  #                         ($proxy_add_x_forwarded_for appends the peer; the
  #                         rightmost entry is the proxy-observed client — the
  #                         PR-1 spoof-containment spec is the proof)
  #   X-Forwarded-Host    → the Indeed webhook (x-forwarded-host tenant slug)
  #   X-Forwarded-Proto   → Express req.secure/req.protocol (Secure-cookie)
  proxy_set_header Host              $host;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Host  $host;
  proxy_set_header X-Forwarded-Proto $scheme;

  # Indeed Apply webhook — exact-match so it wins over the /v1/ prefix (ordered
  # ahead of /v1/ for readability). Route literal inlined from
  # apps/api/src/webhooks/indeed-apply.constants.ts INDEED_APPLY_WEBHOOK_ROUTE;
  # verify-frontdoor-conf.ts enforces constant/conf parity thereafter. The larger
  # body cap carries the base64 resume payload (nginx default is 1m).
  location = /v1/webhooks/indeed/apply {
    client_max_body_size 3m;
    proxy_pass http://api:3000;
  }

  # Durable Async Talent Intake — the SSE notification stream. Regex location so
  # it wins over the /v1/ prefix; SSE-specific handling SCOPED to this one route.
  # This is the long-lived event channel, NOT the résumé-extraction request — it
  # carries only small {status, version} notifications; GET remains authoritative.
  # Deliberately: buffering OFF + X-Accel-Buffering:no (so events flush immediately)
  # and a long READ timeout for the STREAM. This is NOT a /v1/ timeout change and
  # NOT a workaround to hold a synchronous extraction request open (extraction is
  # fully async; no request is ever bound to LLM latency).
  location ~ ^/v1/talent-intake-drafts/[^/]+/events$ {
    proxy_pass http://api:3000;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    add_header X-Accel-Buffering no;
  }

  # API + auth surfaces → container-internal backends (paths reach the services
  # unchanged; proxy_pass carries no URI part).
  location /v1/ {
    proxy_pass http://api:3000;
  }
  location /auth/ {
    proxy_pass http://auth-service:3001;
    # HF1-A: the auth callback response sets a large Set-Cookie session JWT.
    # nginx's default proxy response-header buffers (4k/8k) overflow -> nginx
    # returns 502 "upstream sent too big header" before the browser gets the
    # session cookie, breaking interactive login. Size the response-header
    # buffers to hold it. Regression-guarded in ci/scripts/verify-frontdoor-conf.ts.
    proxy_buffer_size       32k;
    proxy_buffers           8 32k;
    proxy_busy_buffers_size 64k;
  }
  # JWKS — exact match (NOT /.well-known/*), per the retired front door.
  location = /.well-known/jwks.json {
    proxy_pass http://auth-service:3001;
  }

  # D-ORG-2 (T1 topology): the tenant host is the product-neutral App Home.
  #   /ats/  → the ats-web SPA (baked at /srv/ats, built with Vite base `/ats/`);
  #            client-side routing via its own index.html fallback so deep links
  #            and refreshes under /ats/... keep working.
  #   /      → the home-web SPA (App Home at `/`, Organization Administration at
  #            `/org/*`, baked at /srv/home). Legacy ATS bookmarks (pre-T1 paths
  #            such as /talent/...) reach home-web's index.html, whose catch-all
  #            route forwards them to /ats<path> client-side.
  location /ats/ {
    alias /srv/ats/;
    try_files $uri $uri/ /ats/index.html;
  }
  # `location = /ats` (no trailing slash) is normalised onto the SPA root.
  location = /ats {
    return 301 /ats/;
  }

  location / {
    root /srv/home;
    try_files $uri /index.html;
  }
}

# ── Admin / platform host (admin / platform host, R14) ─────────
server {
  listen 443 ssl;
  server_name ${NGINX_ADMIN_SERVER_NAME};

  ssl_certificate     ${NGINX_CERT_DIR}/fullchain.pem;
  ssl_certificate_key ${NGINX_CERT_DIR}/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  proxy_set_header Host              $host;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Host  $host;
  proxy_set_header X-Forwarded-Proto $scheme;

  location /auth/ {
    proxy_pass http://auth-service:3001;
    # HF1-A: the auth callback response sets a large Set-Cookie session JWT.
    # nginx's default proxy response-header buffers (4k/8k) overflow -> nginx
    # returns 502 "upstream sent too big header" before the browser gets the
    # session cookie, breaking interactive login. Size the response-header
    # buffers to hold it. Regression-guarded in ci/scripts/verify-frontdoor-conf.ts.
    proxy_buffer_size       32k;
    proxy_buffers           8 32k;
    proxy_busy_buffers_size 64k;
  }
  # SKILL-TAX-1F-C — the /platform provider map (edge-owned routing). The
  # skill-governance surface (/platform/skill*) is owned by apps/api — it bridges
  # scope:cip + scope:ats, which the scope:platform apps/platform-admin cannot
  # import — so the edge routes exactly those governed paths to api:3000. The
  # frontend addresses only the /platform namespace; which backend owns a given
  # /platform route is an edge concern (R14 revised: platform-web never addresses
  # apps/api DIRECTLY; it consumes only the /auth + /platform namespaces). nginx
  # longest-prefix match sends /platform/skills*, /platform/skill-review-queue*, and
  # /platform/skill-proposals* here; every other /platform/* falls to platform-admin.
  location /platform/skills {
    proxy_pass http://api:3000;
  }
  location /platform/skill-review-queue {
    proxy_pass http://api:3000;
  }
  location /platform/skill-proposals {
    proxy_pass http://api:3000;
  }
  location /platform/ {
    proxy_pass http://platform-admin:3002;
  }
  location = /.well-known/jwks.json {
    proxy_pass http://auth-service:3001;
  }

  # NO `/v1` location of any kind — DELIBERATE (R14 negative control). The platform
  # host reaches api:3000 ONLY for the governed /platform/skill* namespace above; the
  # TENANT `/v1/*` surface remains unreachable from this host by construction (no
  # /v1 proxy_pass here), so a stray /v1/* request falls through to the SPA fallback
  # (index.html), never to tenant data.

  location / {
    root /srv/admin;
    try_files $uri /index.html;
  }
}

# ── Portal / talent host (portal / talent host, R14) ─────────
server {
  listen 443 ssl;
  server_name ${NGINX_PORTAL_SERVER_NAME};

  ssl_certificate     ${NGINX_CERT_DIR}/fullchain.pem;
  ssl_certificate_key ${NGINX_CERT_DIR}/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  proxy_set_header Host              $host;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Host  $host;
  proxy_set_header X-Forwarded-Proto $scheme;

  # SCOPED to /v1/portal/ ONLY (R14, portal direction) — never a general /v1/*
  # proxy, so no other tenant-api surface is reachable from this host. A stray
  # /v1/<other> falls through to the SPA fallback, never to tenant data.
  location /v1/portal/ {
    proxy_pass http://api:3000;
  }
  location /auth/ {
    proxy_pass http://auth-service:3001;
    # HF1-A: the auth callback response sets a large Set-Cookie session JWT.
    # nginx's default proxy response-header buffers (4k/8k) overflow -> nginx
    # returns 502 "upstream sent too big header" before the browser gets the
    # session cookie, breaking interactive login. Size the response-header
    # buffers to hold it. Regression-guarded in ci/scripts/verify-frontdoor-conf.ts.
    proxy_buffer_size       32k;
    proxy_buffers           8 32k;
    proxy_busy_buffers_size 64k;
  }
  location = /.well-known/jwks.json {
    proxy_pass http://auth-service:3001;
  }

  location / {
    root /srv/portal;
    try_files $uri /index.html;
  }
}

# ── Aramo Sign rate limits (Sign Unified Product S-2, directive §4.1.3) ─────────
# http-context zones (this file is included inside http {}). Guest signing and
# public signup are session-less, so they are bounded per client address at the
# edge. A signing session makes a burst of calls (exchange, disclosure, document,
# one fill per field, complete) — the guest zone allows that burst.
limit_req_zone $binary_remote_addr zone=sign_guest:10m  rate=10r/s;
limit_req_zone $binary_remote_addr zone=sign_signup:10m rate=10r/m;
limit_req_status 429;

# ── sign.aramo.ai — the ONE Aramo Sign application (Sign Unified Product S-2) ──
# Aramo-Sign-Unified-Product-Permission-Contract-Platform-API-Directive-v1_0-LOCKED
# §4.1 (amends the Host & Workspace Ruling v1.0): one host, one SPA (/srv/sign),
# three authentication zones —
#   guest signing   /s/:token, /d/:token + /v1/sign/signing/  (capability token)
#   public entry    /login, /signed-out, /signup + /v1/signup/sign/  (no session)
#   workspace       everything else + /v1/sign/sender/, /v1/sign/billing/, /auth/
# Wildcard *.aramo.ai cert covers the host. Only the Sign surfaces are proxied:
# never apps/api, never the internal envelopes surface; a stray /v1/<other>
# falls through to the SPA, never to tenant data. PDF uploads travel as base64
# JSON (25 MiB source → ≈34 MiB).
server {
  listen 443 ssl;
  server_name ${NGINX_SIGN_SERVER_NAME};

  ssl_certificate     ${NGINX_CERT_DIR}/fullchain.pem;
  ssl_certificate_key ${NGINX_CERT_DIR}/privkey.pem;
  ssl_protocols       TLSv1.2 TLSv1.3;

  proxy_set_header Host              $host;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Host  $host;
  proxy_set_header X-Forwarded-Proto $scheme;

  # Security headers (workspace policy). A location that sets its own add_header
  # does not inherit these, so the guest locations below repeat the full set.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

  # Guest signing transport — the capability token is the only authority.
  location /v1/sign/signing/ {
    limit_req zone=sign_guest burst=60 nodelay;
    client_max_body_size 2m;
    proxy_pass http://sign-service:3003;
  }
  # Workspace — the authenticated sender zone.
  location /v1/sign/sender/ {
    client_max_body_size 40m;
    proxy_pass http://sign-service:3003;
  }
  # Workspace — self-service billing (plans, account, checkout, portal) and the
  # billing-provider webhook. The webhook carries no session: sign-service
  # verifies the provider signature over the raw body (so no body rewriting here).
  location /v1/sign/billing/ {
    client_max_body_size 1m;
    proxy_pass http://sign-service:3003;
  }
  # Workspace — the recipient inbox ("Waiting for me", S-7): GET /v1/sign/inbox
  # plus /claim and /:id/sign. Authenticated (Aramo SSO); the prefix has no
  # trailing slash so the bare list path matches too.
  location /v1/sign/inbox {
    client_max_body_size 16k;
    proxy_pass http://sign-service:3003;
  }
  # Public entry — self-service signup (platform-admin owns the provisioning
  # saga). Session-less; dark unless SIGN_PUBLIC_SIGNUP_ENABLED=1.
  location /v1/signup/sign/ {
    limit_req zone=sign_signup burst=10 nodelay;
    client_max_body_size 16k;
    proxy_pass http://platform-admin:3002;
  }
  location /auth/ {
    proxy_pass http://auth-service:3001;
    # HF1-A — the auth callback sets several cookies; widen the header buffers.
    proxy_buffer_size       32k;
    proxy_buffers           8 32k;
    proxy_busy_buffers_size 64k;
  }

  # Guest signing pages — the same SPA, a stricter policy: no third-party origin
  # at all (self-hosted fonts only) and never cached (the path carries a token).
  location ~ ^/(s|d)/ {
    root /srv/sign;
    # Serve the SPA shell IN this location (a file check, not an internal
    # redirect — /index.html as the last argument would re-enter `location /`
    # and lose the guest headers below).
    try_files /index.html =404;
    add_header Cache-Control "no-store" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  }

  location / {
    root /srv/sign;
    try_files $uri /index.html;
  }
}

# ── Port-80: healthcheck target then blanket HTTPS redirect ─────────────────────
# No ACME HTTP-01 provisions (DNS-01 only). /healthz answers before the redirect
# so the container healthcheck (busybox wget) gets a 200 without following a 301.
server {
  listen 80 default_server;
  server_name _;

  location = /healthz {
    return 200;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}
