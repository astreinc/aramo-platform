{
  "name": "aramo-sign-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/sign-web/src",
  "projectType": "application",
  "tags": ["scope:sign"],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/sign-web",
        "configFile": "apps/sign-web/vite.config.ts"
      }
    },
    "serve": { "executor": "@nx/vite:dev-server", "options": { "buildTarget": "aramo-sign-web:build" } },
    "preview": { "executor": "@nx/vite:preview-server", "options": { "buildTarget": "aramo-sign-web:build" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "vitest run --passWithNoTests --root apps/sign-web" } },
    "lint": { "executor": "@nx/eslint:lint", "options": { "lintFilePatterns": ["apps/sign-web/src/**/*.{ts,tsx}"] } }
  }
}
