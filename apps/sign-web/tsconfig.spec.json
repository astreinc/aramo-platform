    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "vite/client", "@testing-library/jest-dom"],
    "noEmit": true,
    "paths": {
      "@aramo/fe-foundation": ["../../libs/fe-foundation/src/index.ts"],
