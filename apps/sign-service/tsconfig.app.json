{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/sign-service",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": false,
    "tsBuildInfoFile": "../../dist/apps/sign-service/.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@aramo/common": ["../../dist/libs/common/src/index.d.ts"],
      "@aramo/auth": ["../../dist/libs/auth/src/index.d.ts"],
      "@aramo/authorization": ["../../dist/libs/authorization/src/index.d.ts"],
      "@aramo/entitlement": ["../../dist/libs/entitlement/src/index.d.ts"],
      "@aramo/identity": ["../../dist/libs/identity/src/index.d.ts"],
      "@aramo/auth-storage": ["../../dist/libs/auth-storage/src/index.d.ts"],
      "@aramo/portal-identity": ["../../dist/libs/portal-identity/src/index.d.ts"],
      "@aramo/sign": ["../../dist/libs/sign/src/index.d.ts"],
      "@aramo/documents-contracts": ["../../dist/libs/documents-contracts/src/index.d.ts"],
      "@aramo/documents-rendering": ["../../dist/libs/documents-rendering/src/index.d.ts"],
      "@aramo/mailer": ["../../dist/libs/mailer/src/index.d.ts"],
      "@aramo/object-storage": ["../../dist/libs/object-storage/src/index.d.ts"],
      "@aramo/subscription": ["../../dist/libs/subscription/src/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**/*", "**/*.spec.ts", "src/sign-negative-control/**"]
}
