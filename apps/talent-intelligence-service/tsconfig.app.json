{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/talent-intelligence-service",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": false,
    "tsBuildInfoFile": "../../dist/apps/talent-intelligence-service/.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@aramo/intelligence-contracts": ["../../dist/libs/intelligence-contracts/src/index.d.ts"],
      "@aramo/intelligence-core": ["../../dist/libs/intelligence-core/src/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/tests/**/*", "**/*.spec.ts"]
}
