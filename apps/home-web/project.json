{
  "name": "aramo-home-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/home-web/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/home-web",
        "configFile": "apps/home-web/vite.config.ts"
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "aramo-home-web:build"
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "options": {
        "buildTarget": "aramo-home-web:build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests --root apps/home-web"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/home-web/src/**/*.{ts,tsx}"]
      }
    },
    "e2e-visual": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/home-web",
        "command": "playwright test --config playwright.visual.config.ts"
      },
      "metadata": {
        "description": "TEMPLATE-STUDIO-1 Org Template Studio + Template gallery visual baselines (1440 + 900), mocked tenant API. Not in CI (same as aramo-platform-web:e2e-visual, lead decision)."
      }
    }
  }
}
