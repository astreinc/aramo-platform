{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/home-web",
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "tsBuildInfoFile": "../../dist/apps/home-web/.tsbuildinfo",
    "types": ["node", "vite/client"],
    "paths": {
      "@aramo/fe-foundation": ["../../dist/libs/fe-foundation/src/index.d.ts"],
      "@aramo/org-admin-web": ["../../dist/libs/org-admin-web/src/index.d.ts"],
      "@aramo/document-templates-web": ["../../dist/libs/document-templates-web/src/index.d.ts"],
      "@aramo/sign-fields": ["../../dist/libs/sign-fields/src/index.d.ts"],
      "@aramo/template-content": ["../../dist/libs/template-content/src/index.d.ts"],
      "@aramo/field-placement-web": ["../../dist/libs/field-placement-web/src/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test-setup.ts"
  ]
}
