---
// Aramo logo mark (PUB-3.5 PR-A) — the burst / kolam motif from the ratified
// prototype (DDR §3: blue #004fcb rays + one coral ray + center dot; Tamil
// visual heritage, Kural 429). Inline SVG (no client JS, no external asset);
// colours come from tokens. Decorative — the accessible name lives on the
// wrapping brand link, so this is aria-hidden.
interface Props {
  size?: number;
  strokeWidth?: number;
}
const { size = 34, strokeWidth = 6 } = Astro.props;
const coralWidth = strokeWidth + 1;
---

<svg
  class="logo-mark"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  aria-hidden="true"
  focusable="false"
>
  <g stroke="var(--c-accent)" stroke-width={strokeWidth} stroke-linecap="round">
    <line x1="43" y1="32" x2="56" y2="32"></line>
    <line x1="32" y1="43" x2="32" y2="56"></line>
    <line x1="24.2" y1="39.8" x2="15" y2="49"></line>
    <line x1="21" y1="32" x2="8" y2="32"></line>
    <line x1="24.2" y1="24.2" x2="15" y2="15"></line>
    <line x1="32" y1="21" x2="32" y2="8"></line>
    <line x1="39.8" y1="39.8" x2="49" y2="49"></line>
  </g>
  <line
    x1="39.8"
    y1="24.2"
    x2="54.5"
    y2="9.5"
    stroke="var(--c-logo-coral)"
    stroke-width={coralWidth}
    stroke-linecap="round"></line>
  <circle cx="32" cy="32" r="6.5" fill="var(--c-accent)"></circle>
</svg>
