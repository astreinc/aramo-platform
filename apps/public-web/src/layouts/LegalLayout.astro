---
// LegalLayout (PUB-LGL) — shared frame for the in-effect legal documents. The
// counsel-signed Legal Set v1.0 is published: the R-PUB4-3 DRAFT band is GONE
// (these are in-effect documents), replaced by the effective-date/version line
// under the heading. Tokens-only, zero client JS.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  effectiveDate?: string;
  version?: string;
}
const {
  title,
  description,
  heading,
  effectiveDate = '2026-07-26',
  version = '1.0',
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="legal">
    <article class="legal-doc">
      <h1 class="legal-doc__title">{heading}</h1>
      <p class="legal-doc__effective">
        Effective date: {effectiveDate} · Version {version}
      </p>
      <slot />
    </article>
  </div>
</BaseLayout>

<style is:global>
  /* Global (not scoped) so the built legal HTML carries no `[data-astro-cid]`
     attribute selectors — keeps the bracket-enumeration grep clean. The
     .legal-* classes are legal-page-only, so global scope leaks nothing. */
  .legal {
    max-width: var(--w-prose);
    margin-inline: auto;
    padding: var(--sp-16) var(--sp-6) var(--sp-20);
  }

  /* Document typography — readable legal register. */
  .legal-doc__title {
    font-size: var(--fs-36);
    line-height: var(--lh-tight);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
    color: var(--c-text);
    margin: 0 0 var(--sp-3);
  }
  /* Effective-date / version line — replaces the retired DRAFT band. */
  .legal-doc__effective {
    margin: 0 0 var(--sp-8);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--c-border);
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    letter-spacing: 0.02em;
    color: var(--c-text-subtle);
  }
  .legal-doc h2 {
    font-size: var(--fs-20);
    line-height: var(--lh-tight);
    font-weight: var(--fw-semibold);
    color: var(--c-text);
    margin: var(--sp-8) 0 var(--sp-3);
  }
  .legal-doc h3 {
    font-size: var(--fs-16);
    line-height: var(--lh-tight);
    font-weight: var(--fw-semibold);
    color: var(--c-text);
    margin: var(--sp-5) 0 var(--sp-2);
  }
  .legal-doc p {
    font-size: var(--fs-16);
    line-height: var(--lh-normal);
    color: var(--c-text-muted);
    margin: 0 0 var(--sp-4);
    max-width: none;
  }
  .legal-doc ul {
    margin: 0 0 var(--sp-4);
    padding-left: var(--sp-5);
    color: var(--c-text-muted);
  }
  .legal-doc li {
    margin-bottom: var(--sp-2);
    line-height: var(--lh-normal);
  }
  .legal-doc strong {
    color: var(--c-text);
    font-weight: var(--fw-semibold);
  }
  .legal-doc a {
    color: var(--c-accent);
  }
  /* Callout for the source blockquote notes (e.g. the Cookie statement posture). */
  .legal-doc .legal-note {
    margin: 0 0 var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    background: var(--c-surface-2);
    border-left: 3px solid var(--c-accent);
    border-radius: var(--r-sm);
    color: var(--c-text-muted);
  }
  .legal-doc table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--sp-4) 0;
    font-size: var(--fs-16);
  }
  .legal-doc th,
  .legal-doc td {
    text-align: left;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--c-border);
    vertical-align: top;
  }
  .legal-doc th {
    font-size: var(--fs-14);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--c-text-subtle);
    border-bottom: 1px solid var(--c-border-strong);
  }
  .legal-doc td {
    color: var(--c-text-muted);
  }
</style>
