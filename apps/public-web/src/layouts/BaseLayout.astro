---
// PUB-3.5 PR-A — shared shell for the public marketing site, "Verified" v2.0.
// CSS-only (zero client JS): design tokens, self-hosted @fontsource families,
// sticky blurred header + four-column footer, OG/meta framework. Page bodies
// carry their own copy; this frame is the design shell (DDR §3 header/footer).
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/marketing.css';
import '../styles/forms.css';
import LogoMark from '../components/LogoMark.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Aramo — the system of record for verified talent. Enterprise ATS, Verified Talent Graph, and AI agents on one platform.',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-placeholder.svg', Astro.site);

// Primary nav (R-PUB35-2). /platform + /agents are new pages built in PR-C —
// they 404 in-branch until then (accepted per the PR-A directive note). The
// /#industries + /#pricing anchors resolve once the new home lands (PR-B).
const NAV = [
  { href: '/platform', label: 'Platform' },
  { href: '/agents', label: 'AI Agents' },
  { href: '/#industries', label: 'Solutions' },
  { href: '/#pricing', label: 'Pricing' },
];

// Footer columns (DDR §3 footer + R-PUB35-2 LEGAL column with real routes).
const FOOTER = [
  {
    heading: 'Product',
    links: [
      { href: '/platform', label: 'Platform' },
      { href: '/agents', label: 'AI Agents' },
      { href: '/#pricing', label: 'Pricing' },
      { href: '/#security', label: 'Security' },
    ],
  },
  {
    heading: 'Solutions',
    links: [
      { href: '/#industries', label: 'IT Staffing' },
      { href: '/#industries', label: 'Healthcare' },
      { href: '/#industries', label: 'Government' },
      { href: '/#industries', label: 'MSP / RPO' },
    ],
  },
  {
    heading: 'Company',
    links: [{ href: '/contact', label: 'Contact' }],
  },
  {
    heading: 'Legal',
    links: [
      { href: '/legal/privacy', label: 'Privacy Policy' },
      { href: '/legal/platform-privacy', label: 'Platform Privacy Notice' },
      { href: '/legal/terms', label: 'Terms of Use' },
      { href: '/legal/cookies', label: 'Cookie & Tracking Statement' },
      { href: '/legal/subprocessors', label: 'Subprocessors' },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="/" aria-label="Aramo — home">
          <LogoMark size={34} strokeWidth={6} />
          <span class="brand__word">aramo.ai</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="site-actions">
          <a class="site-actions__signin" href="/signin">Sign in</a>
          <a class="btn btn--primary" href="/contact">Request demo</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <a class="brand brand--footer" href="/" aria-label="Aramo — home">
            <LogoMark size={24} strokeWidth={5} />
            <span class="brand__word">aramo.ai</span>
          </a>
          <p class="site-footer__tagline">
            Talent intelligence, built on verified identity.
          </p>
        </div>
        {
          FOOTER.map((col) => (
            <nav class="footer-col" aria-label={col.heading}>
              <p class="footer-col__heading">{col.heading}</p>
              {col.links.map((item) => <a href={item.href}>{item.label}</a>)}
            </nav>
          ))
        }
      </div>
      <div class="site-footer__legalbar">
        <span>© 2026 Aramo.ai — All rights reserved.</span>
      </div>
    </footer>
  </body>
</html>
