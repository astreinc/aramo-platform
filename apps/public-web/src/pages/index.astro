---
// PUB-3.5 (combined) — the new home / landing page, ported from the ratified
// prototype Home.dc.html. Copy is VERBATIM from the export except the
// mission-control dashboard + hero agent cards, whose fabricated metrics /
// roster counts are GENERICIZED (directive item 1 "genericized entries" + the
// DDR §2 invented-metrics ban): specific numbers ("142", "38 candidates",
// "9 agents live") are removed, never replaced with new invented values.
// Zero client JS — the hero network is a static inline SVG, motion is CSS
// keyframes, scroll-reveal is dropped (R-PUB35-5). Tokens-only.
import BaseLayout from '../layouts/BaseLayout.astro';

const AGENTS = [
  { id: 'sourcing', ic: 'So', tone: 'a', title: 'Sourcing Agent', body: 'Continuously scans your database and every connected sourcing channel, builds prioritized long-lists, and surfaces matched candidates before a req goes stale.' },
  { id: 'matching', ic: 'Ma', tone: 'm', title: 'Assessment Agent', body: 'Assesses talent against role, team, and client context using the Talent Graph — every assessment shows the evidence behind it.' },
  { id: 'interview', ic: 'In', tone: 't', title: 'Interview Agent', body: 'Coordinates panels, runs structured screens, and delivers prep briefs and structured interview summaries automatically.' },
  { id: 'compliance', ic: 'Co', tone: 'a', title: 'Compliance Agent', body: 'Checks credentialing, right-to-work, and client rules on every submission — flags issues before they ship, with a full audit trail.' },
  { id: 'rediscovery', ic: 'Re', tone: 'm', title: 'Rediscovery Agent', body: 'Mines your existing database first — resurfacing silver-medalists and past contractors for new reqs.' },
  { id: 'copilot', ic: 'Cp', tone: 't', title: 'Recruiter Copilot', body: 'A conversational command center for every recruiter — draft, decide, and delegate to agents in one place. Agents propose; your team decides.' },
];

const MARQUEE = ['Urbane Systems', 'TalTeam', 'QualiZeal', 'Salem Infotech', 'T Ventures', 'Curate Partners', 'Drivestream'];

const CAPABILITIES = [
  { t: 'AI Agents', b: 'Agentic, auditable, human-supervised.' },
  { t: 'Workflow Automation', b: 'Orchestration with approvals and a full audit trail.' },
  { t: 'Talent Graph', b: 'Every candidate, client, and req — connected.' },
  { t: 'Verified Identity', b: 'Multi-channel resolution, independent verification, evidence-graded assessments.' },
  { t: 'Multi-Tenant', b: 'Isolated tenants for MSP and RPO scale.' },
  { t: 'RBAC + Audit', b: 'Fine-grained roles, complete action logs.' },
  { t: 'Observability', b: 'Trace every agent action end-to-end.' },
  { t: 'API-First', b: 'Open APIs, MCP, and versioned connector contracts.' },
];

const WHY = [
  { k: 'Trust', legacy: 'Self-reported resumes', aramo: 'Verified, evidence-backed profiles ✓' },
  { k: 'Automation', legacy: 'Manual workflows', aramo: 'AI agents ✓' },
  { k: 'Intelligence', legacy: 'Keyword search', aramo: 'Talent Graph + RAG ✓' },
  { k: 'Platform', legacy: 'Closed system', aramo: 'API-first + open connectors ✓' },
  { k: 'Scalability', legacy: 'Per-seat licensing', aramo: 'Scales with your desk ✓' },
];

const INDUSTRIES = [
  { t: 'IT Staffing', b: 'Speed-to-submit at MSP scale — where Aramo runs today.' },
  { t: 'Healthcare', b: 'Credential evidence attached to every submittal.' },
  { t: 'Government', b: 'Clearance-aware submittals with a full audit trail.' },
  { t: 'Defense', b: 'Eligibility evidence and audit trails for controlled programs.' },
  { t: 'Banking', b: 'Compliance-grade audit trails on every action.' },
  { t: 'Insurance', b: 'Licensed-role evidence, verified before submittal.' },
  { t: 'Enterprise HR', b: 'Internal mobility + rediscovery.' },
  { t: 'RPO', b: 'Multi-client delivery, one platform.' },
];

const SECURITY = ['Tenant isolation', 'Least-privilege access', 'SSO / SAML', 'RBAC', 'Encryption in transit', 'Audit Logs'];
---

<BaseLayout
  title="Aramo — the system of record for verified talent"
  description="Aramo unifies your ATS and every sourcing channel into one evidence-backed Talent Graph, with AI agents that do the legwork. Your team makes every call."
>
  <!-- HERO -->
  <section class="hp-hero">
    <div class="hp-hero__glow" aria-hidden="true"></div>
    <div class="hp-container hp-container--wide hp-hero__grid">
      <div>
        <div class="hp-badge"><span class="hp-badge__dot" aria-hidden="true"></span>Enterprise ATS · Verified Talent Graph · AI Agents</div>
        <h1 class="hp-hero__h1">The system of record for verified talent.</h1>
        <p class="hp-hero__sub">Aramo unifies your ATS and every sourcing channel into one evidence-backed Talent Graph — each profile resolved, verified, and richer with every engagement. AI agents do the legwork: sourcing, qualifying, engaging, preparing submittals. Your team makes every call.</p>
        <div class="hp-cta-row">
          <a class="hp-btn hp-btn--primary" href="/contact">Request demo</a>
          <a class="hp-btn hp-btn--ghost" href="/platform">Watch platform tour</a>
        </div>
        <div class="hp-stats">
          <div><div class="hp-stats__n">One graph</div><div class="hp-stats__l">every source unified</div></div>
          <div class="hp-stats__div" aria-hidden="true"></div>
          <div><div class="hp-stats__n">Verified</div><div class="hp-stats__l">every profile evidence-backed</div></div>
          <div class="hp-stats__div" aria-hidden="true"></div>
          <div><div class="hp-stats__n">Human-led</div><div class="hp-stats__l">your team makes every call</div></div>
        </div>
      </div>
      <div class="hp-hero__visual">
        <svg class="hp-net" viewBox="0 0 620 520" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
          <g class="hp-net__lines">
            <line x1="90" y1="60" x2="200" y2="110"></line>
            <line x1="200" y1="110" x2="330" y2="70"></line>
            <line x1="330" y1="70" x2="470" y2="120"></line>
            <line x1="470" y1="120" x2="560" y2="60"></line>
            <line x1="200" y1="110" x2="150" y2="200"></line>
            <line x1="150" y1="200" x2="300" y2="180"></line>
            <line x1="300" y1="180" x2="330" y2="70"></line>
            <line x1="300" y1="180" x2="430" y2="230"></line>
            <line x1="430" y1="230" x2="470" y2="120"></line>
            <line x1="430" y1="230" x2="540" y2="190"></line>
            <line x1="540" y1="190" x2="560" y2="60"></line>
            <line x1="150" y1="200" x2="200" y2="300"></line>
            <line x1="200" y1="300" x2="300" y2="180"></line>
            <line x1="300" y1="180" x2="360" y2="250"></line>
            <line x1="360" y1="250" x2="430" y2="230"></line>
            <line x1="360" y1="250" x2="350" y2="320"></line>
            <line x1="350" y1="320" x2="470" y2="340"></line>
            <line x1="470" y1="340" x2="430" y2="230"></line>
            <line x1="470" y1="340" x2="580" y2="300"></line>
            <line x1="580" y1="300" x2="540" y2="190"></line>
            <line x1="80" y1="320" x2="200" y2="300"></line>
            <line x1="200" y1="300" x2="250" y2="250"></line>
            <line x1="250" y1="250" x2="300" y2="180"></line>
            <line x1="80" y1="320" x2="130" y2="430"></line>
            <line x1="130" y1="430" x2="250" y2="410"></line>
            <line x1="250" y1="410" x2="200" y2="300"></line>
            <line x1="250" y1="410" x2="200" y2="470"></line>
            <line x1="200" y1="470" x2="300" y2="450"></line>
            <line x1="300" y1="450" x2="250" y2="410"></line>
            <line x1="300" y1="450" x2="350" y2="320"></line>
            <line x1="300" y1="450" x2="420" y2="440"></line>
            <line x1="420" y1="440" x2="470" y2="340"></line>
            <line x1="420" y1="440" x2="520" y2="430"></line>
            <line x1="520" y1="430" x2="580" y2="300"></line>
            <line x1="130" y1="430" x2="200" y2="470"></line>
          </g>
          <g class="hp-net__nodes">
            <circle cx="90" cy="60" r="4"></circle>
            <circle cx="200" cy="110" r="4.5"></circle>
            <circle cx="330" cy="70" r="3.5"></circle>
            <circle cx="470" cy="120" r="4"></circle>
            <circle cx="560" cy="60" r="3"></circle>
            <circle cx="150" cy="200" r="4.5"></circle>
            <circle cx="300" cy="180" r="6"></circle>
            <circle cx="430" cy="230" r="4.5"></circle>
            <circle cx="540" cy="190" r="3.5"></circle>
            <circle cx="80" cy="320" r="4"></circle>
            <circle cx="200" cy="300" r="5"></circle>
            <circle cx="350" cy="320" r="4"></circle>
            <circle cx="470" cy="340" r="4.5"></circle>
            <circle cx="580" cy="300" r="3.5"></circle>
            <circle cx="250" cy="250" r="3.5"></circle>
            <circle cx="360" cy="250" r="4"></circle>
            <circle cx="130" cy="430" r="4"></circle>
            <circle cx="250" cy="410" r="4.5"></circle>
            <circle cx="200" cy="470" r="3.5"></circle>
            <circle cx="300" cy="450" r="4.5"></circle>
            <circle cx="420" cy="440" r="4"></circle>
            <circle cx="520" cy="430" r="3.5"></circle>
          </g>
        </svg>
        <div class="hp-glass hp-glass--1">
          <div class="hp-glass__head"><span class="hp-glass__ic hp-glass__ic--a">S</span><span class="hp-glass__name">Sourcing Agent</span><span class="hp-glass__tag hp-glass__tag--on">ACTIVE</span></div>
          <div class="hp-glass__body">Found matched candidates for <strong>Sr. Cloud Engineer</strong> — engaging the shortlist.</div>
        </div>
        <div class="hp-glass hp-glass--2">
          <div class="hp-glass__head"><span class="hp-glass__ic hp-glass__ic--m">I</span><span class="hp-glass__name">Interview Agent</span></div>
          <div class="hp-glass__body">Interviews scheduled · prep briefs delivered to hiring panel.</div>
        </div>
        <div class="hp-glass hp-glass--chip">submission → <span class="hp-glass__ok">accepted</span></div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <section class="hp-marquee">
    <div class="hp-marquee__label"><strong>TRUSTED BY ENTERPRISES THAT HIRE AT SCALE</strong></div>
    <div class="hp-marquee__track">
      {[0, 1].map(() => (
        <div class="hp-marquee__set" aria-hidden="true">
          {MARQUEE.map((name) => (
            <span class="hp-firm"><span class="hp-firm__mark" aria-hidden="true"></span><span class="hp-firm__name">{name}</span></span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="hp-section">
    <div class="hp-container hp-split">
      <div>
        <div class="hp-eyebrow hp-eyebrow--m">THE PROBLEM</div>
        <h2 class="hp-h2">Talent data you can finally trust.</h2>
        <p class="hp-lead">Recruiting runs on disconnected tools and unverified data. Legacy ATS platforms store records — duplicated, stale, and impossible to verify — while recruiters stitch together a dozen rented tools by hand. The result: slow pipelines, missed talent, and records nobody believes.</p>
      </div>
      <div class="hp-collapse">
        <div class="hp-dashed">Traditional ATS — a database, not a teammate</div>
        <div class="hp-dashed">Manual sourcing, screening, scheduling</div>
        <div class="hp-dashed">Disconnected point tools &amp; spreadsheets</div>
        <div class="hp-collapse__arrow" aria-hidden="true">↓</div>
        <div class="hp-punch">
          <div class="hp-punch__t">Aramo — one system of intelligence</div>
          <div class="hp-punch__b">Your ATS, every sourcing channel, and AI agents on one verified Talent Graph — one process, one platform, end to end.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- AGENTS GRID -->
  <section id="agents" class="hp-section hp-section--alt">
    <div class="hp-container">
      <div class="hp-agents__head">
        <div>
          <div class="hp-eyebrow hp-eyebrow--b">AI AGENTS</div>
          <h2 class="hp-h2 hp-h2--wide">Agents for every step. Intelligence under every agent.</h2>
          <p class="hp-lead">Each agent works from the same verified Talent Graph — and every action they take is evidence-backed, auditable, and yours to approve.</p>
        </div>
        <a class="hp-deeper" href="/agents">Meet the agents →</a>
      </div>
      <div class="hp-agents__grid">
        {AGENTS.map((a) => (
          <a class={`hp-agent hp-agent--${a.tone}`} href={`/agents#${a.id}`}>
            <div class={`hp-agent__ic hp-agent__ic--${a.tone}`}>{a.ic}</div>
            <div class="hp-agent__t">{a.title}</div>
            <div class="hp-agent__b">{a.body}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MISSION CONTROL (dark, genericized dashboard) -->
  <section id="mission-control" class="hp-mc">
    <div class="hp-mc__glow" aria-hidden="true"></div>
    <div class="hp-container">
      <div class="hp-mc__head">
        <div class="hp-eyebrow hp-eyebrow--l">MISSION CONTROL</div>
        <h2 class="hp-h2 hp-h2--light">One command center for your talent operation.</h2>
        <p class="hp-lead hp-lead--light">Direct agents, approve actions, and watch every pipeline move in real time — humans stay in command.</p>
      </div>
      <div class="hp-dash">
        <div class="hp-dash__bar">
          <span class="hp-dot"></span><span class="hp-dot"></span><span class="hp-dot"></span>
          <span class="hp-dash__title">aramo · mission control</span>
          <span class="hp-dash__live"><span class="hp-dash__pulse" aria-hidden="true"></span>agents live</span>
        </div>
        <div class="hp-dash__grid">
          <div class="hp-dash__left">
            <div class="hp-tiles">
              <div class="hp-tile"><div class="hp-tile__k">OPEN REQS</div><div class="hp-tile__skel" aria-hidden="true"></div></div>
              <div class="hp-tile"><div class="hp-tile__k">IN PIPELINE</div><div class="hp-tile__skel" aria-hidden="true"></div></div>
              <div class="hp-tile"><div class="hp-tile__k">SUBMITS TODAY</div><div class="hp-tile__skel" aria-hidden="true"></div></div>
            </div>
            <div class="hp-dash__cap">PIPELINE VELOCITY · LAST 14 DAYS</div>
            <div class="hp-chart" aria-hidden="true">
              {Array.from({ length: 14 }).map((_, i) => (
                <div class={`hp-bar hp-bar--${i < 3 ? 'a' : i < 6 ? 'b' : i < 9 ? 'c' : i < 11 ? 'd' : 'e'} hp-bar--h${i}`}></div>
              ))}
            </div>
          </div>
          <div class="hp-dash__right">
            <div class="hp-dash__cap">AGENT ACTIVITY</div>
            <div class="hp-feed">
              <div class="hp-feed__row"><span class="hp-feed__ic hp-feed__ic--a">So</span><div class="hp-feed__txt">Sourcing Agent added candidates to an open pipeline<div class="hp-feed__time">just now</div></div></div>
              <div class="hp-feed__row"><span class="hp-feed__ic hp-feed__ic--m">Cm</span><div class="hp-feed__txt">Compliance Agent checked submissions — no flags<div class="hp-feed__time">moments ago</div></div></div>
              <div class="hp-feed__row"><span class="hp-feed__ic hp-feed__ic--t">In</span><div class="hp-feed__txt">Interview Agent scheduled panels — briefs sent to interviewers<div class="hp-feed__time">earlier</div></div></div>
              <div class="hp-feed__row"><span class="hp-feed__ic hp-feed__ic--g">Su</span><div class="hp-feed__txt">Submission Agent — offer <strong class="hp-feed__ok">accepted</strong><div class="hp-feed__time">earlier</div></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE -->
  <section id="architecture" class="hp-section">
    <div class="hp-container">
      <div class="hp-center">
        <div class="hp-eyebrow hp-eyebrow--m">ENTERPRISE ARCHITECTURE</div>
        <h2 class="hp-h2 hp-h2--center">Built like an operating system, not an app.</h2>
        <p class="hp-lead hp-lead--center">A layered platform: agents on top of shared knowledge, workflow, and governance — connected to everything you already use.</p>
      </div>
      <div class="hp-arch">
        <div class="hp-arch__row"><div class="hp-arch__mc">Mission Control <span>— humans in command</span></div></div>
        <svg class="hp-flow" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><line x1="50" y1="0" x2="50" y2="8" class="hp-flow__l hp-flow__l--m"></line></svg>
        <div class="hp-arch__agents">
          <div class="hp-arch__agent hp-arch__agent--b">Sourcing</div>
          <div class="hp-arch__agent hp-arch__agent--b">Assessment</div>
          <div class="hp-arch__agent hp-arch__agent--m">Interview</div>
          <div class="hp-arch__agent hp-arch__agent--m">Compliance</div>
          <div class="hp-arch__agent hp-arch__agent--t">Submission</div>
          <div class="hp-arch__agent hp-arch__agent--t">+ more</div>
        </div>
        <svg class="hp-flow" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><line x1="30" y1="0" x2="30" y2="8" class="hp-flow__l hp-flow__l--b"></line><line x1="70" y1="0" x2="70" y2="8" class="hp-flow__l hp-flow__l--b"></line></svg>
        <div class="hp-arch__layers">
          <div class="hp-arch__layer"><div class="hp-arch__lt">Knowledge Layer</div><div class="hp-arch__lb">Verified Talent Graph · evidence ledger · RAG</div></div>
          <div class="hp-arch__layer"><div class="hp-arch__lt">Workflow Engine</div><div class="hp-arch__lb">Orchestration · approvals · audit trail</div></div>
          <div class="hp-arch__layer"><div class="hp-arch__lt">LLM Platform + MCP</div><div class="hp-arch__lb">Model routing · tools · evals</div></div>
        </div>
        <svg class="hp-flow" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><line x1="50" y1="0" x2="50" y2="8" class="hp-flow__l hp-flow__l--t"></line></svg>
        <div class="hp-arch__int">
          <span class="hp-arch__intlabel">INTEGRATIONS</span>
          {['ATS / CRM', 'Email', 'Professional networks', 'Job boards', 'VMS', 'Teams / Slack', 'Calendar', 'Developer profiles'].map((i) => (
            <span class="hp-chip">{i}</span>
          ))}
        </div>
      </div>
      <div class="hp-center hp-center--link"><a class="hp-deeper" href="/platform">Explore the platform →</a></div>
    </div>
  </section>

  <!-- CAPABILITIES + WHY TABLE -->
  <section id="capabilities" class="hp-section hp-section--alt">
    <div class="hp-container">
      <div class="hp-eyebrow hp-eyebrow--b">PLATFORM CAPABILITIES</div>
      <h2 class="hp-h2 hp-h2--wide hp-mb">Everything an enterprise talent OS needs.</h2>
      <div class="hp-cap__grid">
        {CAPABILITIES.map((c) => (
          <div class="hp-cap"><div class="hp-cap__t">{c.t}</div><div class="hp-cap__b">{c.b}</div></div>
        ))}
      </div>
      <div class="hp-why-scroll">
        <div class="hp-why">
          <div class="hp-why__head">
            <div class="hp-why__hk">WHY ARAMO</div>
            <div class="hp-why__hl">Legacy ATS</div>
            <div class="hp-why__ha">Aramo</div>
          </div>
          {WHY.map((r) => (
            <div class="hp-why__row">
              <div class="hp-why__k">{r.k}</div>
              <div class="hp-why__legacy">{r.legacy}</div>
              <div class="hp-why__aramo">{r.aramo}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES + FOUNDER QUOTE -->
  <section id="industries" class="hp-section">
    <div class="hp-container">
      <div class="hp-eyebrow hp-eyebrow--m">INDUSTRY SOLUTIONS</div>
      <h2 class="hp-h2 hp-h2--wide hp-mb">Tuned for regulated, high-volume hiring.</h2>
      <div class="hp-ind__grid">
        {INDUSTRIES.map((i) => (
          <div class="hp-ind"><div class="hp-ind__t">{i.t}</div><div class="hp-ind__b">{i.b}</div></div>
        ))}
      </div>
      <div class="hp-quote__wrap">
        <figure class="hp-quote">
          <blockquote class="hp-quote__q">“We run a staffing desk ourselves. Aramo is the system we always wanted: every profile verified, every action auditable, and our recruiters spending their day with people — not tabs.”</blockquote>
          <figcaption class="hp-quote__cap">
            <span class="hp-quote__av" aria-hidden="true"></span>
            <span><span class="hp-quote__name">Purush Pichaimuthu</span><span class="hp-quote__role">Founder, Aramo · Astre Consulting</span></span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- SECURITY BAND (dark) -->
  <section id="security" class="hp-sec">
    <div class="hp-container hp-split">
      <div>
        <div class="hp-eyebrow hp-eyebrow--l">ENTERPRISE SECURITY</div>
        <h2 class="hp-h2 hp-h2--light">Agentic AI your security team will approve.</h2>
        <p class="hp-lead hp-lead--light">Every agent action is permissioned, logged, and auditable. Your data never trains shared models. Every tenant fully isolated.</p>
      </div>
      <div class="hp-sec__grid">
        {SECURITY.map((s) => (
          <div class="hp-sec__chip">{s}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="hp-section">
    <div class="hp-container">
      <div class="hp-center">
        <div class="hp-eyebrow hp-eyebrow--b">PRICING</div>
        <h2 class="hp-h2 hp-h2--center">Scale your desk, not your tool stack.</h2>
      </div>
      <div class="hp-price">
        <div class="hp-tier">
          <div class="hp-tier__name">Aramo ATS</div>
          <div class="hp-tier__desc">The core system of record for your firm</div>
          <div class="hp-tier__price"><span class="hp-tier__amt">Free</span><span class="hp-tier__per"> during early access</span></div>
          <div class="hp-tier__list"><div>✓ Requisitions</div><div>✓ Submittals</div><div>✓ Placements</div><div>✓ Clients</div></div>
          <a class="hp-tier__cta hp-tier__cta--ghost" href="/get-started">Request workspace</a>
        </div>
        <div class="hp-tier hp-tier--featured">
          <div class="hp-tier__flag">MOST COMPLETE</div>
          <div class="hp-tier__name">Aramo Platform</div>
          <div class="hp-tier__desc">ATS + Verified Talent Graph + AI agents</div>
          <div class="hp-tier__price"><span class="hp-tier__amt">Free</span><span class="hp-tier__per"> during early access</span></div>
          <div class="hp-tier__list"><div>✓ Everything in Aramo ATS</div><div>✓ Every sourcing channel unified</div><div>✓ Every profile resolved, evidence-backed</div><div>✓ AI agents on top</div></div>
          <a class="hp-tier__cta hp-tier__cta--solid" href="/get-started">Request workspace</a>
        </div>
        <div class="hp-tier">
          <div class="hp-tier__name">Aramo Intelligence</div>
          <div class="hp-tier__desc">Graph + agents on the ATS you already run</div>
          <div class="hp-tier__price"><span class="hp-tier__amt">Talk to us</span></div>
          <div class="hp-tier__list"><div>✓ Verified Talent Graph</div><div>✓ AI agents</div><div>✓ Connects to your existing ATS</div></div>
